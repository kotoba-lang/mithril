(mithril/bot-profile
  :id "https://mithril.fund/id/bot/governed-coder"
  :goal "https://mithril.fund/id/goal/governed-coding-task"
  :ontology "3539fef6d1f26c012d4305a55a3782902ff8de47e56901e619ea0cde30ece918"
  :policy
  (mithril/bot-policy
    :max-steps 16
    :max-retries 2
    :lease-seconds 900
    :confidence-floor 6000
    :actions
    ["https://mithril.fund/id/action/workspace-inspect"
     "https://mithril.fund/id/action/code-propose"
     "https://mithril.fund/id/action/patch-apply"
     "https://mithril.fund/id/action/amu-compile"
     "https://mithril.fund/id/action/test-run"
     "https://mithril.fund/id/action/git-status"
     "https://mithril.fund/id/action/stop"]
    :effects
    ["workspace/read" "llm/propose-patch" "workspace/apply-patch"
     "amu/compile" "test/run" "git/status" "agent/stop"]))
