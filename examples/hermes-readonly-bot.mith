(mithril/bot-profile
  :id "https://mithril.fund/id/bot/hermes-readonly-cron-v1"
  :goal "https://mithril.fund/id/goal/governed-coding-task"
  :ontology "b3f864a5b1c627e628be9767f1a6936b55dea44c565a20e3e0c20049855e3e8b"
  :process
  (bpmn/process
    :id "https://mithril.fund/id/bpmn/hermes-readonly-cron-v1"
    :ontology "b3f864a5b1c627e628be9767f1a6936b55dea44c565a20e3e0c20049855e3e8b"
    :nodes
    [(bpmn/start-event :id "start")
     (bpmn/exclusive-gateway :id "choose")
     (bpmn/service-task :id "inspect" :action "https://mithril.fund/id/action/workspace-inspect")
     (bpmn/service-task :id "stop" :action "https://mithril.fund/id/action/stop")
     (bpmn/end-event :id "end")]
    :flows
    [(bpmn/sequence-flow :id "start-choose" :source "start" :target "choose" :condition "always")
     (bpmn/sequence-flow :id "choose-inspect" :source "choose" :target "inspect" :condition "https://mithril.fund/id/action/workspace-inspect")
     (bpmn/sequence-flow :id "choose-stop" :source "choose" :target "stop" :condition "https://mithril.fund/id/action/stop")
     (bpmn/sequence-flow :id "inspect-choose" :source "inspect" :target "choose" :condition "always")
     (bpmn/sequence-flow :id "stop-end" :source "stop" :target "end" :condition "always")])
  :policy
  (mithril/bot-policy
    :max-steps 2 :max-retries 0 :lease-seconds 300 :confidence-floor 3000
    :actions ["https://mithril.fund/id/action/workspace-inspect"
              "https://mithril.fund/id/action/stop"]
    :effects ["workspace/read" "agent/stop"]))
