    "handlerIntent": "mith:handlerIntent",
    "viewIntent": "mith:viewIntent",
    "effectIntent": "mith:effectIntent",
    "loop": "mith:loop",
    "sources": {"@id": "mith:source", "@container": "@set"},
    "url": {"@id": "mith:url", "@type": "@id"},
    "mediaType": "mith:mediaType",
    "maxSources": {"@id": "mith:maxSources", "@type": "http://www.w3.org/2001/XMLSchema#integer"},
    "maxBytesPerSource": {"@id": "mith:maxBytesPerSource", "@type": "http://www.w3.org/2001/XMLSchema#integer"},
    "collector": {"@id": "mith:collector", "@type": "@id"},
    "analyzer": {"@id": "mith:analyzer", "@type": "@id"},
    "store": {"@id": "mith:store", "@type": "@id"},
    "governor": {"@id": "mith:governor", "@type": "@id"},
    "reasoner": {"@id": "mith:reasoner", "@type": "@id"},
    "query": {"@id": "mith:query", "@type": "@id"},
    "validator": {"@id": "mith:validator", "@type": "@id"},
    "compiler": {"@id": "mith:compiler", "@type": "@id"},
    "tester": {"@id": "mith:tester", "@type": "@id"},
    "deployer": {"@id": "mith:deployer", "@type": "@id"},
    "maxSteps": {"@id": "mith:maxSteps", "@type": "http://www.w3.org/2001/XMLSchema#integer"},
    "app": "mith:app",
    "name": "mith:name",
    "description": "mith:description",
    "headline": "mith:headline",
    "summary": "mith:summary",
    "template": {"@id": "mith:template", "@type": "@id"},
    "dataShape": {"@id": "mith:dataShape", "@type": "@id"},
    "goal": {"@id": "mith:goal", "@type": "@id"},
    "ontology": "mith:ontologyDigest",
    "choices": {"@id": "mith:choice", "@container": "@set"},
    "role": {"@id": "mith:role", "@type": "@vocab"},
    "candidate": {"@id": "mith:candidate", "@type": "@id"},
    "confidence": {"@id": "mith:confidence", "@type": "http://www.w3.org/2001/XMLSchema#integer"},
    "version": {"@id": "mith:version", "@type": "http://www.w3.org/2001/XMLSchema#integer"},
    "exports": {"@id": "mith:export", "@container": "@set"},
    "symbol": {"@id": "mith:symbol", "@type": "@id"},
    "kind": {"@id": "mith:kind", "@type": "@vocab"},
    "label": "mith:label",
    "confidenceFloor": {"@id": "mith:confidenceFloor", "@type": "http://www.w3.org/2001/XMLSchema#integer"},
    "imports": {"@id": "mith:import", "@container": "@set"},
    "library": {"@id": "mith:library", "@type": "@id"},
    "digest": "mith:digest",
    "routes": {"@id": "mith:route", "@container": "@set"},
    "method": "mith:method",
    "path": "mith:path",
    "operation": {"@id": "mith:operation", "@type": "@id"},
    "intent": "mith:intent",
    "status": {"@id": "mith:status", "@type": "http://www.w3.org/2001/XMLSchema#integer"},
    "contentType": "mith:contentType",
    "body": "mith:body"
  }
}
