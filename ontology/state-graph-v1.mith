        :sh/path "https://mithril.fund/ns/state-graph/v1#integer"
        :sh/datatype "http://www.w3.org/2001/XMLSchema#integer"
        :sh/min-count 1 :sh/max-count 1)])
   (shacl/node-shape
     :id "https://mithril.fund/ns/state-graph/v1#BooleanShape"
     :sh/target-class "https://mithril.fund/ns/state-graph/v1#BooleanNode"
