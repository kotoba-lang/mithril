   (owl/class :id "https://mithril.fund/ns/state-graph/v1#NullNode"
              :rdfs/sub-class-of "https://mithril.fund/ns/state-graph/v1#StateNode")
   (owl/class :id "https://mithril.fund/ns/state-graph/v1#MapEntry")
   (owl/class :id "https://mithril.fund/ns/state-graph/v1#ListItem")
   (shacl/node-shape
     :id "https://mithril.fund/ns/state-graph/v1#MapShape"
     :sh/target-class "https://mithril.fund/ns/state-graph/v1#MapNode"
     :sh/property
     [(shacl/property-shape
        :sh/path "https://mithril.fund/ns/state-graph/v1#entry"
        :sh/class "https://mithril.fund/ns/state-graph/v1#MapEntry"
        :sh/min-count 0 :sh/max-count 8192)])
   (shacl/node-shape
     :id "https://mithril.fund/ns/state-graph/v1#ListShape"
     :sh/target-class "https://mithril.fund/ns/state-graph/v1#ListNode"
     :sh/property
     [(shacl/property-shape
        :sh/path "https://mithril.fund/ns/state-graph/v1#item"
        :sh/class "https://mithril.fund/ns/state-graph/v1#ListItem"
        :sh/min-count 0 :sh/max-count 8192)])
   (shacl/node-shape
     :id "https://mithril.fund/ns/state-graph/v1#SetShape"
     :sh/target-class "https://mithril.fund/ns/state-graph/v1#SetNode"
     :sh/property
     [(shacl/property-shape
        :sh/path "https://mithril.fund/ns/state-graph/v1#item"
        :sh/class "https://mithril.fund/ns/state-graph/v1#ListItem"
        :sh/min-count 0 :sh/max-count 8192)])
   (shacl/node-shape
