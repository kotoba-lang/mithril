      (shacl/property-shape
        :sh/path "https://mithril.fund/ns/state-graph/v1#key"
        :sh/class "https://mithril.fund/ns/state-graph/v1#StateNode"
        :sh/min-count 1 :sh/max-count 1)
      (shacl/property-shape
        :sh/path "https://mithril.fund/ns/state-graph/v1#value"
        :sh/class "https://mithril.fund/ns/state-graph/v1#StateNode"
        :sh/min-count 1 :sh/max-count 1)])
   (shacl/node-shape
     :id "https://mithril.fund/ns/state-graph/v1#ListItemShape"
