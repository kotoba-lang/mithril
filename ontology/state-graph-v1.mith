              :rdfs/sub-class-of "https://mithril.fund/ns/state-graph/v1#MapNode")
   (owl/class :id "https://mithril.fund/ns/state-graph/v1#ListNode"
              :rdfs/sub-class-of "https://mithril.fund/ns/state-graph/v1#StateNode")
   (owl/class :id "https://mithril.fund/ns/state-graph/v1#SetNode"
              :rdfs/sub-class-of "https://mithril.fund/ns/state-graph/v1#StateNode")
   (owl/class :id "https://mithril.fund/ns/state-graph/v1#KeywordNode"
              :rdfs/sub-class-of "https://mithril.fund/ns/state-graph/v1#StateNode")
   (owl/class :id "https://mithril.fund/ns/state-graph/v1#StringNode"
              :rdfs/sub-class-of "https://mithril.fund/ns/state-graph/v1#StateNode")
   (owl/class :id "https://mithril.fund/ns/state-graph/v1#IntegerNode"
