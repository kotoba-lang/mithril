        :sh/min-count 1 :sh/max-count 1)])
   (shacl/node-shape
     :id "https://mithril.fund/ns/state-graph/v1#StringShape"
     :sh/target-class "https://mithril.fund/ns/state-graph/v1#StringNode"
     :sh/property
