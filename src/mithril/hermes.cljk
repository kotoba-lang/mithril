(ns mithril.hermes
  "Hermes host adapter for governed Mithril coding effects.

  Jev selects only an ontology action ID. A separate generative advisor may
  propose one unified diff, but it receives no tools. The Governor validates
  that diff against a digest-bound tool profile before deterministic host
  functions apply it and run exact argv compile/test tools without a shell."
  (:require [cljs.reader :as reader]
            [clojure.set :as set]
            [clojure.string :as str]
            [mithril.bot :as bot]
            [mithril.execution :as execution]))

(def adapter-format "https://mithril.fund/adapter/hermes-coding-v1")
(def tool-profile-format "https://mithril.fund/profile/coding-tools-v1")
(def proposal-format "https://mithril.fund/artifact/patch-proposal-v1")
(def read-only-effects #{:workspace/read :git/status :agent/stop})
(def coding-effects #{:llm/propose-patch :workspace/apply-patch :workspace/revert-patch
                      :amu/compile :test/run})
(def admitted-effects (into read-only-effects coding-effects))

(defn- fail! [code detail data]
  (throw (ex-info detail (merge {:mithril/error code :detail detail} data))))

(defn- absolute-path? [value]
  (and (string? value)
       (or (str/starts-with? value "/")
           (boolean (re-matches #"[A-Za-z]:[\\\\/].+" value)))))

(defn- relative-file? [value]
  (and (string? value)
       (not (str/blank? value))
       (not (absolute-path? value))
       (not (str/includes? value "\\"))
       (not-any? #{"" "." ".."} (str/split value #"/"))))

(defn- command-spec? [spec]
  (and (map? spec)
       (= #{:program :args :timeout-ms} (set (keys spec)))
       (absolute-path? (:program spec))
       (vector? (:args spec))
       (every? string? (:args spec))
       (integer? (:timeout-ms spec))
       (<= 1000 (:timeout-ms spec) 900000)))

(defn validate-tool-profile [profile]
  (let [required #{:format :workspace :artifact-dir :allowed-paths
                   :max-patch-bytes :max-context-bytes :proposer :tools}
        optional #{:create-paths :read-paths}
        keys* (set (keys profile))
        create-paths (or (:create-paths profile) [])
        read-paths (or (:read-paths profile) [])]
    (when-not (and (map? profile) (= required (set (filter required keys*)))
                   (empty? (remove (into required optional) keys*))
                   (= tool-profile-format (:format profile)))
      (fail! :mithril.hermes/invalid-tool-profile
             "coding tool profile has an invalid field set or format" {}))
    (when-not (and (absolute-path? (:workspace profile))
                   (absolute-path? (:artifact-dir profile))
                   (let [workspace (str/replace (:workspace profile) #"/+$" "")]
                     (and (not= workspace (str/replace (:artifact-dir profile) #"/+$" ""))
                          (not (str/starts-with? (:artifact-dir profile) (str workspace "/"))))))
      (fail! :mithril.hermes/invalid-tool-profile
             "workspace and out-of-workspace artifact directory must be absolute" {}))
    (when-not (and (vector? (:allowed-paths profile))
                   (= (count (:allowed-paths profile)) (count (set (:allowed-paths profile))))
                   (every? relative-file? (:allowed-paths profile))
                   (vector? create-paths)
                   (= (count create-paths) (count (set create-paths)))
                   (every? relative-file? create-paths)
                   (vector? read-paths)
                   (= (count read-paths) (count (set read-paths)))
                   (every? relative-file? read-paths)
                   (seq (concat (:allowed-paths profile) create-paths))
                   (empty? (set/intersection (set (:allowed-paths profile))
                                             (set create-paths)))
                   (empty? (set/intersection (set read-paths)
                                             (into (set (:allowed-paths profile))
                                                   create-paths))))
      (fail! :mithril.hermes/invalid-tool-profile
             "read/edit/create paths must be disjoint unique relative files" {}))
    (when-not (and (integer? (:max-patch-bytes profile))
                   (<= 1 (:max-patch-bytes profile) 262144)
                   (integer? (:max-context-bytes profile))
                   (<= 1 (:max-context-bytes profile) 1048576))
      (fail! :mithril.hermes/invalid-tool-profile "coding byte budgets are invalid" {}))
    (when-not (and (map? (:proposer profile))
                   (= #{:program :profile :timeout-ms} (set (keys (:proposer profile))))
                   (absolute-path? (get-in profile [:proposer :program]))
                   (string? (get-in profile [:proposer :profile]))
                   (not (str/blank? (get-in profile [:proposer :profile])))
                   (integer? (get-in profile [:proposer :timeout-ms]))
                   (<= 1000 (get-in profile [:proposer :timeout-ms]) 900000))
      (fail! :mithril.hermes/invalid-tool-profile "proposer specification is invalid" {}))
    (when-not (and (= #{:amu/compile :test/run} (set (keys (:tools profile))))
                   (every? command-spec? (vals (:tools profile))))
      (fail! :mithril.hermes/invalid-tool-profile
             "compile and test must be exact no-shell command specifications" {}))
    profile))

(defn tool-profile-digest [profile]
  (execution/digest (validate-tool-profile profile)))

(defn- completed [effect output audit]
  {:receipt {:format bot/receipt-format
             :effect-id (:id effect)
             :status :completed
             :output-digest (execution/digest output)}
   :audit (merge {:adapter adapter-format :operation (:operation effect)} audit)})

(defn- failed
  ([effect code] (failed effect code {}))
  ([effect code audit]
  {:receipt {:format bot/receipt-format
             :effect-id (:id effect)
             :status :failed
             :output-digest (execution/digest {:error code})}
   :audit (merge {:adapter adapter-format :operation (:operation effect) :error code}
                 audit)}))

(defn- default-context []
  (let [fs (js/require "node:fs")
        path (js/require "node:path")
        cp (js/require "node:child_process")]
    {:stat-fn (fn [value] (.statSync fs value))
     :list-fn (fn [value] (.readdirSync fs value))
     :read-fn (fn [value] (.readFileSync fs value "utf8"))
     :lstat-fn (fn [value] (.lstatSync fs value))
     :realpath-fn (fn [value] (.realpathSync fs value))
     :exists-fn (fn [value] (.existsSync fs value))
     :write-fn (fn [value content]
                 (.mkdirSync fs (.dirname path value) #js {:recursive true})
                 (let [temporary (str value ".tmp-" (.-pid js/process))]
                   (.writeFileSync fs temporary content "utf8")
                   (.renameSync fs temporary value)))
     :exec-fn (fn [program args cwd timeout-ms]
                (.execFileSync cp program (clj->js args)
                               #js {:cwd cwd :encoding "utf8" :timeout timeout-ms
                                    :maxBuffer 1048576
                                    :stdio #js ["ignore" "pipe" "pipe"]}))
     :join-fn (fn [& values] (.apply (.-join path) path (to-array values)))}))

(defn- profile! [effect profile]
  (when-not profile
    (fail! :mithril.hermes/tool-profile-required
           "mutating and build effects require a digest-bound coding tool profile" {}))
  (validate-tool-profile profile)
  (when-not (= (:workspace effect) (:workspace profile))
    (fail! :mithril.hermes/workspace-mismatch
           "effect workspace does not match the coding tool profile" {}))
  (let [actual (tool-profile-digest profile)]
    (when-not (= actual (:tool-profile-digest effect))
      (fail! :mithril.hermes/tool-profile-mismatch
             "effect is not bound to this coding tool profile" {})))
  profile)

(defn- runtime-paths! [ctx profile operation]
  (let [workspace ((:realpath-fn ctx) (:workspace profile))
        artifact-dir ((:realpath-fn ctx) (:artifact-dir profile))
        create-paths (or (:create-paths profile) [])]
    (when (or (= workspace artifact-dir)
              (str/starts-with? artifact-dir (str workspace "/")))
      (fail! :mithril.hermes/artifact-path-denied
             "artifact directory resolves inside the coding workspace" {}))
    (doseq [relative (concat (:allowed-paths profile) (or (:read-paths profile) []))]
      (let [file ((:join-fn ctx) workspace relative)
            stat ((:lstat-fn ctx) file)
            actual ((:realpath-fn ctx) file)]
        (when-not (and (.isFile stat) (not (.isSymbolicLink stat))
                       (str/starts-with? actual (str workspace "/")))
          (fail! :mithril.hermes/path-denied
                 "allowlisted source must be a regular in-workspace file" {}))))
    (doseq [relative create-paths]
      (let [file ((:join-fn ctx) workspace relative)
            parts (str/split relative #"/")
            parent-relative (str/join "/" (butlast parts))
            parent ((:join-fn ctx) workspace (if (str/blank? parent-relative) "." parent-relative))
            parent-stat ((:lstat-fn ctx) parent)
            actual-parent ((:realpath-fn ctx) parent)]
        (when (or (and (= :llm/propose-patch operation) ((:exists-fn ctx) file))
                  (and ((:exists-fn ctx) file)
                       (let [target-stat ((:lstat-fn ctx) file)]
                         (or (not (.isFile target-stat)) (.isSymbolicLink target-stat))))
                  (not (.isDirectory parent-stat))
                  (.isSymbolicLink parent-stat)
                  (not (or (= actual-parent workspace)
                           (str/starts-with? actual-parent (str workspace "/")))))
          (fail! :mithril.hermes/path-denied
                 "creatable path must be absent below a real in-workspace directory" {}))))
    profile))

(defn- byte-count [value]
  (.byteLength js/Buffer value "utf8"))

(defn- artifact-path [profile effect join-fn]
  (join-fn (:artifact-dir profile)
           (str (str/replace (:run-id effect) ":" "_") ".proposal.edn")))

(defn- proposal-workspace-path [profile effect join-fn]
  (join-fn (:artifact-dir profile)
           (str (str/replace (:run-id effect) ":" "_") ".workspace")))

(defn- diagnostic-path [profile effect join-fn]
  (join-fn (:artifact-dir profile)
           (str (str/replace (:run-id effect) ":" "_") ".diagnostic.txt")))

(defn- git! [ctx workspace & args]
  ((:exec-fn ctx) "/usr/bin/git" (vec args) workspace 30000))

(defn- clean-head! [ctx workspace]
  (let [head (str/trim (git! ctx workspace "rev-parse" "HEAD"))
        status (git! ctx workspace "status" "--porcelain=v1" "--untracked-files=all")]
    (when-not (boolean (re-matches #"[0-9a-f]{40,64}" head))
      (fail! :mithril.hermes/not-git-workspace "workspace has no admitted Git HEAD" {}))
    (when-not (str/blank? status)
      (fail! :mithril.hermes/dirty-workspace
             "coding effects require an isolated clean Git workspace" {}))
    head))

(defn- git-state [ctx workspace]
  {:head (str/trim (git! ctx workspace "rev-parse" "HEAD"))
   :status (git! ctx workspace "status" "--porcelain=v1" "--untracked-files=all")})

(defn- snapshot [ctx profile]
  (let [read-paths (set (or (:read-paths profile) []))]
    (loop [paths (concat (:allowed-paths profile) read-paths) total 0 result []]
    (if-let [relative (first paths)]
      (let [content ((:read-fn ctx) ((:join-fn ctx) (:workspace profile) relative))
            next-total (+ total (byte-count content))]
        (when (> next-total (:max-context-bytes profile))
          (fail! :mithril.hermes/context-budget "workspace snapshot exceeds the context budget" {}))
        (recur (rest paths) next-total
               (conj result {:path relative :content content
                             :read-only? (contains? read-paths relative)})))
      (into result (map (fn [relative] {:path relative :content nil :create? true})
                        (or (:create-paths profile) [])))))))

(defn- proposal-prompt [effect files diagnostic]
  (str "You are a patch advisor in an isolated disposable Git worktree. Use only relative paths and the file tools.\n"
       "Read-only <read-only-file> paths are context and must not change. Read/edit only <allowed-file> paths. You may create only <creatable-file> paths. Do not rename, delete, chmod, add any other file, add binaries, or add symlinks.\n"
       "Apply the requested edit with the patch tool, verify by reading the changed lines, then answer DONE.\n"
       "Goal: " (:goal effect) "\n"
       (when diagnostic
         (str "A previous governed compile/test failed. Repair this bounded diagnostic:\n"
              "<diagnostic>" diagnostic "</diagnostic>\n"))
       (str/join "\n" (map (fn [{:keys [path create? read-only?]}]
                               (cond
                                 create? (str "<creatable-file>" path "</creatable-file>")
                                 read-only? (str "<read-only-file>" path "</read-only-file>")
                                 :else (str "<allowed-file>" path "</allowed-file>")))
                             files))))

(defn- default-propose! [ctx profile effect files diagnostic]
  (let [{program :program proposer-profile :profile timeout-ms :timeout-ms} (:proposer profile)
        proposal-workspace (proposal-workspace-path profile effect (:join-fn ctx))]
    (when-not ((:exists-fn ctx) proposal-workspace)
      ((:exec-fn ctx) "/usr/bin/git"
       ["worktree" "add" "--detach" proposal-workspace
        (str/trim (git! ctx (:workspace profile) "rev-parse" "HEAD"))]
       (:workspace profile) 30000))
    (let [untracked (git! ctx proposal-workspace "ls-files" "--others" "--exclude-standard")
          current-diff (git! ctx proposal-workspace "diff" "--binary" "--")]
      (when (and (str/blank? current-diff) (str/blank? untracked))
        (try
          ((:exec-fn ctx) program
           ["-p" proposer-profile "--ignore-rules" "-t" "file" "--in" proposal-workspace
            "-z" (proposal-prompt effect files diagnostic)]
           proposal-workspace timeout-ms)
          (catch :default _
            (fail! :mithril.hermes/proposer-failed
                   "Hermes proposer did not complete within its governed invocation" {}))))
      (let [untracked-before-intent (->> (str/split-lines
                                           (git! ctx proposal-workspace "ls-files" "--others" "--exclude-standard"))
                                         (remove str/blank?) set)
            creatable (set (or (:create-paths profile) []))
            denied-untracked (set/difference untracked-before-intent creatable)
            _ (when (seq denied-untracked)
                (fail! :mithril.hermes/proposer-workspace-denied
                       "proposer created a non-creatable path" {:paths denied-untracked}))
            _ (when (seq untracked-before-intent)
                (apply git! ctx proposal-workspace "add" "-N" "--"
                       (sort untracked-before-intent)))
            untracked-after (git! ctx proposal-workspace "ls-files" "--others" "--exclude-standard")
            changed (->> (str/split-lines
                          (git! ctx proposal-workspace "diff" "--name-only" "--"))
                         (remove str/blank?) set)
            patch (git! ctx proposal-workspace "diff" "--binary" "--")]
        (when-not (and (str/blank? untracked-after)
                       (seq changed)
                       (every? (into (set (:allowed-paths profile)) creatable) changed))
          (fail! :mithril.hermes/proposer-workspace-denied
                 "proposer changed an untracked or non-allowlisted path" {}))
        patch))))

(defn- diff-paths! [profile patch]
  (when (or (str/blank? patch)
            (> (byte-count patch) (:max-patch-bytes profile))
            (not (str/starts-with? patch "diff --git ")))
    (fail! :mithril.hermes/invalid-patch "proposal is empty, oversized, or not a raw Git diff" {}))
  (when (re-find #"(?mi)^(GIT binary patch|Binary files |rename (from|to) |copy (from|to) |old mode |new mode |deleted file mode |new file mode 120000|index [^\n]+ 160000)" patch)
    (fail! :mithril.hermes/invalid-patch "binary, rename, delete, mode and symlink changes are forbidden" {}))
  (let [pairs (re-seq #"(?m)^diff --git a/([^\n]+) b/([^\n]+)$" patch)
        header-paths (mapcat (fn [[_ left right]] [left right]) pairs)
        marker-paths (->> (re-seq #"(?m)^(?:---|\+\+\+) (?:[ab]/([^\n]+)|/dev/null)$" patch)
                          (keep second))
        paths (vec (distinct (concat header-paths marker-paths)))
        allowed (into (set (:allowed-paths profile)) (or (:create-paths profile) []))]
    (when (or (empty? pairs)
              (some (fn [[_ left right]] (not= left right)) pairs)
              (some #(or (not (relative-file? %)) (not (contains? allowed %))) paths))
      (fail! :mithril.hermes/path-denied "patch names a path outside the exact allowlist" {}))
    paths))

(defn- propose! [effect profile ctx]
  (let [head (clean-head! ctx (:workspace profile))
        files (snapshot ctx profile)
        diagnostic-file (diagnostic-path profile effect (:join-fn ctx))
        diagnostic (when ((:exists-fn ctx) diagnostic-file)
                     ((:read-fn ctx) diagnostic-file))
        patch (if-let [propose-fn (:propose-fn ctx)]
                (propose-fn {:effect effect :profile profile :files files
                             :prompt (proposal-prompt effect files diagnostic)
                             :diagnostic diagnostic})
                (default-propose! ctx profile effect files diagnostic))
        paths (diff-paths! profile patch)
        proposal {:format proposal-format :run-id (:run-id effect) :base-head head
                  :profile-digest (tool-profile-digest profile)
                  :patch-digest (execution/digest patch) :patch patch}
        file (artifact-path profile effect (:join-fn ctx))]
    ((:write-fn ctx) file (pr-str proposal))
    (completed effect (dissoc proposal :patch)
               {:proposal-digest (:patch-digest proposal) :files (count paths)
                :bytes (byte-count patch)})))

(defn- read-proposal! [effect profile ctx]
  (let [file (artifact-path profile effect (:join-fn ctx))
        proposal (reader/read-string ((:read-fn ctx) file))]
    (when-not (and (= #{:format :run-id :base-head :profile-digest :patch-digest :patch}
                      (set (keys proposal)))
                   (= proposal-format (:format proposal))
                   (= (:run-id effect) (:run-id proposal))
                   (= (tool-profile-digest profile) (:profile-digest proposal))
                   (= (execution/digest (:patch proposal)) (:patch-digest proposal)))
      (fail! :mithril.hermes/proposal-integrity "proposal artifact failed identity checks" {}))
    proposal))

(defn- apply-patch! [effect profile ctx]
  (let [proposal (read-proposal! effect profile ctx)
        paths (diff-paths! profile (:patch proposal))
        patch-file (str (artifact-path profile effect (:join-fn ctx)) ".patch")
        _ ((:write-fn ctx) patch-file (:patch proposal))
        {:keys [head status]} (git-state ctx (:workspace profile))]
    (when-not (= head (:base-head proposal))
      (fail! :mithril.hermes/stale-proposal "workspace HEAD changed after proposal" {}))
    (if (str/blank? status)
      (do
        ((:exec-fn ctx) "/usr/bin/git" ["apply" "--check" "--" patch-file]
         (:workspace profile) 30000)
        ((:exec-fn ctx) "/usr/bin/git" ["apply" "--" patch-file]
         (:workspace profile) 30000))
      (try
        ((:exec-fn ctx) "/usr/bin/git" ["apply" "--reverse" "--check" "--" patch-file]
         (:workspace profile) 30000)
        (catch :default _
          (fail! :mithril.hermes/dirty-workspace
                 "dirty workspace is not exactly the already-applied proposal" {}))))
    (let [delta (git! ctx (:workspace profile) "diff" "--binary" "--")]
      (completed effect {:patch-digest (:patch-digest proposal)
                         :workspace-digest (execution/digest delta)}
                 {:files (count paths) :changed true}))))

(defn- reverse-patch! [ctx workspace patch-file]
  ((:exec-fn ctx) "/usr/bin/git" ["apply" "--reverse" "--check" "--" patch-file]
   workspace 30000)
  ((:exec-fn ctx) "/usr/bin/git" ["apply" "--reverse" "--" patch-file]
   workspace 30000)
  ;; Clear intent-to-add entries used to make newly-created files visible in
  ;; the proposal diff. This changes only the private index, never file bytes.
  ((:exec-fn ctx) "/usr/bin/git" ["reset" "--mixed"] workspace 30000)
  (when-not (str/blank? (git! ctx workspace "status" "--porcelain=v1" "--untracked-files=all"))
    (fail! :mithril.hermes/rollback-failed
           "proposal rollback did not restore a clean admitted workspace" {})))

(defn- revert-patch! [effect profile ctx]
  (let [proposal (read-proposal! effect profile ctx)
        _ (diff-paths! profile (:patch proposal))
        patch-file (str (artifact-path profile effect (:join-fn ctx)) ".patch")
        _ ((:write-fn ctx) patch-file (:patch proposal))
        {:keys [head]} (git-state ctx (:workspace profile))
        scratch (proposal-workspace-path profile effect (:join-fn ctx))]
    (when-not (= head (:base-head proposal))
      (fail! :mithril.hermes/stale-proposal "workspace HEAD changed before repair reset" {}))
    (reverse-patch! ctx (:workspace profile) patch-file)
    (when ((:exists-fn ctx) scratch)
      (reverse-patch! ctx scratch patch-file))
    (completed effect {:patch-digest (:patch-digest proposal) :reset true}
               {:files (count (diff-paths! profile (:patch proposal))) :reset true})))

(defn- bounded-diagnostic [profile error]
  (let [parts [(some-> error .-stdout str) (some-> error .-stderr str)
               (some-> error .-message str)]
        text (str/join "\n" (remove str/blank? parts))
        ceiling (min 32768 (:max-context-bytes profile))]
    (subs text 0 (min ceiling (count text)))))

(defn- tool! [effect profile ctx]
  (let [spec (get-in profile [:tools (:operation effect)])]
    (try
      (let [output ((:exec-fn ctx) (:program spec) (:args spec)
                    (:workspace profile) (:timeout-ms spec))]
        (completed effect {:tool (:operation effect) :output-digest (execution/digest output)}
                   {:tool (:operation effect) :exit 0 :output-bytes (byte-count output)}))
      (catch :default error
        (let [code (case (:operation effect)
                     :amu/compile :compile-failed
                     :test/run :test-failed
                     :tool-failed)
              diagnostic (bounded-diagnostic profile error)
              file (diagnostic-path profile effect (:join-fn ctx))]
          ((:write-fn ctx) file diagnostic)
          (failed effect code {:diagnostic-digest (execution/digest diagnostic)
                               :diagnostic-bytes (byte-count diagnostic)}))))))

(defn execute-effect
  "Execute one closed host effect. Coding effects require a digest-bound tool
  profile. All host functions are injectable for contract tests."
  ([effect] (execute-effect effect (default-context)))
  ([effect supplied-context]
   (when-not (and (map? effect)
                  (= "https://mithril.fund/effect/bot-action-v1" (:format effect))
                  (string? (:id effect))
                  (contains? admitted-effects (:operation effect)))
     (fail! :mithril.hermes/effect-denied "effect is outside the Hermes coding catalog" {}))
   (let [ctx (merge (default-context) supplied-context)
         profile (when (contains? coding-effects (:operation effect))
                   (let [profile (profile! effect (:profile ctx))]
                     (runtime-paths! ctx profile (:operation effect))))]
     (try
       (case (:operation effect)
         :workspace/read
         (let [stat ((:stat-fn ctx) (:workspace effect))]
           (when-not (.isDirectory stat)
             (fail! :mithril.hermes/not-directory "workspace is not a directory" {}))
           (let [entries ((:list-fn ctx) (:workspace effect))
                 output {:kind :directory :entry-count (count entries)}]
             (completed effect output output)))

         :git/status
         (let [status-text (if-let [git-fn (:git-fn supplied-context)]
                             (git-fn (:workspace effect))
                             (git! ctx (:workspace effect)
                                   "status" "--porcelain=v1" "--branch"))
               lines (->> (.split status-text "\n")
                          (remove empty?) vec)
               output {:repository true :changed-lines (max 0 (dec (count lines)))
                       :branch-observed (boolean (seq lines))}]
           (completed effect output output))

         :agent/stop (completed effect {:stopped true} {:stopped true})
         :llm/propose-patch (propose! effect profile ctx)
         :workspace/apply-patch (apply-patch! effect profile ctx)
         :workspace/revert-patch (revert-patch! effect profile ctx)
         :amu/compile (tool! effect profile ctx)
         :test/run (tool! effect profile ctx))
       (catch :default error
         (if (and (:mithril/error (ex-data error))
                  (contains? #{:mithril.hermes/effect-denied
                               :mithril.hermes/invalid-tool-profile
                               :mithril.hermes/tool-profile-required
                               :mithril.hermes/tool-profile-mismatch
                               :mithril.hermes/workspace-mismatch}
                             (:mithril/error (ex-data error))))
           (throw error)
           (failed effect (or (:mithril/error (ex-data error))
                              (if (contains? read-only-effects (:operation effect))
                                :host-read-failed
                                :host-effect-failed)))))))))
