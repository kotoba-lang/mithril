(ns mithril.ipld-session
  "CID/ref is the local executable bot-state authority in opt-in primary mode.
  The .edn file is a checked, recoverable projection. A separate state path is
  required for each run; the stable slot ref never silently changes run ID."
  (:require [cljs.reader :as reader]
            [mithril.checkpoint-ipld :as checkpoint-ipld]
            [mithril.checkpoint-ipld-fs :as local]))

(def fs (js/require "node:fs"))
(def path (js/require "node:path"))
(def crypto (js/require "node:crypto"))

(defn- refuse! [reason]
  (throw (ex-info "Mithril primary IPLD session refused"
                  {:mithril/error :mithril.ipld-session/refused :reason reason})))

(defn ref-name [state-path]
  (when-not (and (string? state-path) (.isAbsolute path state-path))
    (refuse! :invalid-state-path))
  (str "session-"
       (.digest (.update (.createHash crypto "sha256")
                         (.resolve path state-path) "utf8") "hex")))

(defn- projection [state-path]
  (when (.existsSync fs state-path)
    (try (reader/read-string (.readFileSync fs state-path "utf8"))
         (catch :default _ (refuse! :invalid-projection)))))

(defn- write-projection! [state-path state]
  (let [temporary (str state-path ".tmp-" (.-pid js/process) "-" (.now js/Date))]
    (.mkdirSync fs (.dirname path state-path) #js {:recursive true})
    (.writeFileSync fs temporary (pr-str state)
                    #js {:encoding "utf8" :flag "wx" :mode 384})
    (.renameSync fs temporary state-path)))

(defn load! [store schema state-path]
  (let [name (ref-name state-path)]
    (when (.existsSync fs (str state-path ".semantic-head"))
      (refuse! :legacy-semantic-head))
    (if-not (local/ref-exists? store name)
      (do
        (when (.existsSync fs state-path) (refuse! :unimported-legacy-state))
        nil)
      (let [history (local/verify-ref! store schema name)
            saved (checkpoint-ipld/read! #(local/get-block store %) schema
                                         (:head history))
            state (:state saved)
            projected (projection state-path)]
        (when-not (= checkpoint-ipld/format-id (:format saved))
          (refuse! :legacy-block))
        (when (and projected (not= state projected))
          (refuse! :projection-diverged))
        (when-not projected (write-projection! state-path state))
        {:state state :stateCid (:cid saved)
         :semanticGraphDigest (:semantic-graph-digest saved)
         :blocks (:blocks history)}))))

(defn save! [store schema state-path previous state]
  (let [name (ref-name state-path)
        prior-state (:state previous)]
    (when (.existsSync fs (str state-path ".semantic-head"))
      (refuse! :legacy-semantic-head))
    (when (and prior-state
               (not= (:run-id prior-state) (:run-id state)))
      (refuse! :run-changed))
    (when (and (nil? previous) (.existsSync fs state-path))
      (refuse! :unimported-legacy-state))
    (when (and (nil? previous) (local/ref-exists? store name))
      (refuse! :missing-prior-state))
    (let [id (local/record-state! store schema name (:stateCid previous) state)
          saved (checkpoint-ipld/read! #(local/get-block store %) schema id)]
      (write-projection! state-path state)
      {:state state :stateCid id
       :semanticGraphDigest (:semantic-graph-digest saved)})))
