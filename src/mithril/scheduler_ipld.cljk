(ns mithril.scheduler-ipld
  "Opt-in, local CID witness for one Hermes BPMN run across cron occurrences.
  The scheduler still owns its attempt/receipt protocol; this adapter refuses
  EDN projection drift and links every accepted post-tick state to its parent."
  (:require [mithril.checkpoint-ipld :as ipld]
            [mithril.checkpoint-ipld-fs :as local]
            [mithril.execution :as execution]
            [mithril.ipld-session :as primary]))

(defn- refuse! [reason]
  (throw (ex-info "Mithril scheduler IPLD witness refused"
                  {:mithril/error :mithril.scheduler-ipld/refused
                   :reason reason})))

(defn primary-state-basename
  "Choose the scheduler's causal state path from its receipt series. Read-only
  primary runs are one-shot and execution-scoped; coding runs use a job session."
  [profile job-id rows]
  (let [readonly (filterv #(= "https://mithril.fund/receipt/hermes-bpmn-scheduler-v1"
                               (get-in % [:receipt :format])) rows)]
    (if (seq readonly)
      (let [execution-id (get-in (first readonly) [:execution :id])]
        (when-not (and (= 1 (count rows)) (= 1 (count readonly))
                       (= "builtin" (get-in (first rows) [:execution :source]))
                       (= "completed" (get-in (first rows) [:receipt :status]))
                       (string? execution-id)
                       (re-matches #"[0-9a-f]{32}" execution-id))
          (refuse! :invalid-readonly-primary-series))
        (str execution-id ".edn"))
      (str profile "-" job-id ".session.edn"))))

(defn ref-name [state]
  (let [id (:run-id state)]
    (when-not (and (string? id)
                   (re-matches #"sha256:[0-9a-f]{64}" id))
      (refuse! :invalid-run-id))
    (str "run-" (subs id 7))))

(defn witness [store schema state]
  (let [name (ref-name state)
        history (local/verify-ref! store schema name)
        saved (ipld/read! #(local/get-block store %) schema (:head history))]
    (when-not (= state (:state saved))
      (refuse! :state-diverged))
    (when-not (ipld/canonical-format? (:format saved))
      (refuse! :legacy-block))
    {:stateCid (:cid saved)
     :semanticGraphDigest (:semantic-graph-digest saved)
     :blocks (:blocks history)}))

(defn record! [store schema prior state]
  (when (and prior (not= (:run-id prior) (:run-id state)))
    (refuse! :run-changed))
  (let [expected (when prior (:stateCid (witness store schema prior)))
        id (local/record-state! store schema (ref-name state) expected state)
        result (witness store schema state)]
    (when-not (= id (:stateCid result))
      (refuse! :head-mismatch))
    result))

(defn verify-occurrences!
  "Verify one fresh single-run scheduler series. Each completed builtin
  occurrence must correspond to exactly one new effect and one causal CID;
  terminal redeliveries must reuse the final CID without an effect."
  [store schema final-state rows]
  (let [history (local/verify-ref! store schema (ref-name final-state))
        builtin (filterv #(= "builtin" (get-in % [:execution :source])) rows)
        direct (count (remove #(= "builtin" (get-in % [:execution :source])) rows))
        completed (filterv #(= "completed" (get-in % [:receipt :status])) builtin)
        terminal (filterv #(= "terminal" (get-in % [:receipt :status])) builtin)]
    (when-not (and (seq completed)
                   (= (count builtin) (+ (count completed) (count terminal)))
                   (= (mapv #(get-in % [:receipt :status]) builtin)
                      (vec (concat (repeat (count completed) "completed")
                                   (repeat (count terminal) "terminal"))))
                   (= (count completed) (:blocks history))
                   (every? #(= "completed" (get-in % [:execution :status])) builtin)
                   (every? #(= "failed" (get-in % [:execution :status]))
                           (remove #(= "builtin" (get-in % [:execution :source])) rows))
                   (every? (fn [{:keys [execution receipt]}]
                             (and (= (:id execution) (:executionId receipt))
                                  (= "builtin" (:source receipt))
                                  (= (:scheduled_instant execution)
                                     (:scheduledInstant receipt))))
                           builtin))
      (refuse! :scheduler-series-mismatch))
    (let [last-cid
          (loop [remaining completed previous nil index 1]
            (if-let [{:keys [receipt]} (first remaining)]
              (let [cid (:stateCid receipt)
                    saved (ipld/read! #(local/get-block store %) schema cid)
                    state (:state saved)
                    effect (last (:receipts state))
                    passed (last (filter #(= :pass (:bpmn/event %))
                                         (get-in state [:bpmn :token-state :bpmn/trace])))
                    action (get-in state [:bpmn :model :bpmn/nodes
                                          (:bpmn/at passed) :mithril/action])]
                (when-not (and (ipld/canonical-format? (:format saved))
                               (= (if previous [previous] []) (:parents saved))
                               (= (ref-name final-state) (ref-name state))
                               (= index (:step state) (count (:receipts state)))
                               (= index (:step receipt))
                               (= (name (:status state)) (:runStatus receipt))
                               (= (:semantic-graph-digest saved)
                                  (:semanticGraphDigest receipt))
                               (= action (:action receipt))
                               (= (:effect-id effect) (:effectId receipt))
                               (= (:output-digest effect) (:outputDigest receipt)))
                  (refuse! :effect-or-cid-mismatch))
                (recur (next remaining) cid (inc index)))
              previous))
          final-saved (ipld/read! #(local/get-block store %) schema last-cid)]
      (when-not (and (= last-cid (:head history))
                     (= final-state (:state final-saved))
                     (every? (fn [{:keys [receipt]}]
                               (and (= last-cid (:stateCid receipt))
                                    (= (:semantic-graph-digest final-saved)
                                       (:semanticGraphDigest receipt))
                                    (= "completed" (:runStatus receipt))
                                    (nil? (:effectId receipt))
                                    (= (count completed) (:step receipt))))
                             terminal))
        (refuse! :terminal-or-head-mismatch))
      {:status "verified"
       :completedEffects (count completed)
       :terminalDeliveries (count terminal)
       :directExecutions direct
       :semanticBlocks (:blocks history)
       :stateCid last-cid
       :semanticGraphDigest (:semantic-graph-digest final-saved)
       :runStatus (name (:status final-state))})))

(defn verify-from-receipts!
  "Reconstruct the final state from the immutable CID head named in scheduler
  receipts, then verify the entire occurrence/effect history. An EDN projection
  is not needed to answer whether the durable semantic state is consistent."
  [store schema rows]
  (let [completed (filterv #(and (= "builtin" (get-in % [:execution :source]))
                                 (= "completed" (get-in % [:receipt :status]))) rows)
        cid (get-in (last completed) [:receipt :stateCid])]
    (when-not (seq completed) (refuse! :missing-completed-effect))
    (let [saved (ipld/read! #(local/get-block store %) schema cid)
          state (:state saved)
          verified (verify-occurrences! store schema state rows)]
      {:state state :verification verified})))

(defn recovery-state!
  "Admit a missing EDN projection only when the complete Hermes receipt series,
  the CID head, the exact task/profile, and the independently checked semantic
  head all name the same state. This function performs no host effect."
  [store schema rows profile-digest task-digest semantic-run-id semantic-state-digest]
  (let [{:keys [state verification]} (verify-from-receipts! store schema rows)]
    (when-not (and (= profile-digest (:profile-digest state))
                   (= task-digest (:task-digest state))
                   (= semantic-run-id (:run-id state))
                   (= semantic-state-digest (execution/digest state)))
      (refuse! :recovery-binding-mismatch))
    {:state state :verification verification}))

(defn verify-primary-occurrences!
  "Verify the CID-primary two-phase journal, with an optional checked initial
  state block for the first Jev decision's causal parent."
  [store schema state-path rows]
  (let [history (local/verify-ref! store schema (primary/ref-name state-path))
        builtin (filterv #(= "builtin" (get-in % [:execution :source])) rows)
        completed (filterv #(contains? #{"completed" "effect-failed"}
                                       (get-in % [:receipt :status])) builtin)
        terminal (filterv #(= "terminal" (get-in % [:receipt :status])) builtin)
        held (filterv #(= "held" (get-in % [:receipt :status])) builtin)
        direct (remove #(= "builtin" (get-in % [:execution :source])) rows)
        effect-held? (and (seq held)
                          (= "held" (get-in (last completed)
                                             [:receipt :runStatus])))
        expected-blocks (+ (* 2 (count completed))
                           (if (and (seq held) (not effect-held?)) 1 0))
        baseline? (= (inc expected-blocks) (:blocks history))]
    (when-not (and (seq builtin)
                   (or (seq completed) (seq held))
                   (not (and (seq held) (seq terminal)))
                   (= (count builtin) (+ (count completed) (count terminal)
                                         (count held)))
                   (= builtin (vec (concat completed terminal held)))
                   (or (= expected-blocks (:blocks history)) baseline?)
                   (or (seq completed) baseline?)
                   (every? (fn [{:keys [execution receipt]}]
                             (and (= (if (= "effect-failed" (:status receipt))
                                       "failed" "completed")
                                     (:status execution))
                                  (case (:status receipt)
                                    "effect-failed" (= "failed" (:effectStatus receipt))
                                    "completed" (contains? #{nil "completed"}
                                                           (:effectStatus receipt))
                                    true))) builtin)
                   (every? #(= "failed" (get-in % [:execution :status])) direct)
                   (every? (fn [{:keys [execution receipt]}]
                             (and (= (:id execution) (:executionId receipt))
                                  (= "builtin" (:source receipt))
                                  (= (:scheduled_instant execution)
                                     (:scheduledInstant receipt)))) builtin))
      (refuse! :primary-scheduler-series-mismatch))
    (let [last-cid
          (loop [remaining completed previous nil index 1]
            (if-let [{:keys [receipt]} (first remaining)]
              (let [final-cid (:stateCid receipt)
                    final (ipld/read! #(local/get-block store %) schema final-cid)
                    request-cid (first (:parents final))
                    requested (ipld/read! #(local/get-block store %) schema request-cid)
                    state (:state final)
                    pending (:state requested)
                    effect (last (:receipts state))
                    passed (last (filter #(= :pass (:bpmn/event %))
                                         (get-in state [:bpmn :token-state :bpmn/trace])))
                    action (get-in pending [:awaiting :action])
                    successful? (not= "effect-failed" (:status receipt))
                    baseline-cid (when (and baseline? (= index 1))
                                   (first (:parents requested)))
                    baseline (when baseline-cid
                               (ipld/read! #(local/get-block store %) schema
                                           baseline-cid))]
                (when-not (and (ipld/canonical-format? (:format final))
                               (ipld/canonical-format? (:format requested))
                               (= [request-cid] (:parents final))
                               (= (if baseline-cid [baseline-cid]
                                      (if previous [previous] []))
                                  (:parents requested))
                               (or (not baseline?)
                                   (not= index 1)
                                   (and baseline
                                        (= 0 (get-in baseline [:state :step]))
                                        (nil? (get-in baseline [:state :awaiting]))
                                        (= 1 (count
                                              (filter #(and (= :decide/jev (:operation %))
                                                            (= :admitted (:status %)))
                                                      (:semantic-receipts pending))))))
                               (= (:run-id pending) (:run-id state))
                               (= (dec index) (:step pending))
                               (= index (:step state) (count (:receipts state)))
                               (= index (:step receipt))
                               (= (:effect-id effect) (:effectId receipt)
                                  (get-in pending [:awaiting :id]))
                               (= (:status effect)
                                  (if successful? :completed :failed))
                               (= (:output-digest effect) (:outputDigest receipt))
                               (= (:semantic-graph-digest final)
                                  (:semanticGraphDigest receipt))
                               (= action (:action receipt))
                               (or (not successful?)
                                   (not (:bpmn state))
                                   (= action
                                      (get-in state [:bpmn :model :bpmn/nodes
                                                     (:bpmn/at passed)
                                                     :mithril/action])))
                               (= (name (:status state)) (:runStatus receipt))
                               (nil? (:awaiting state)))
                  (refuse! :primary-effect-or-cid-mismatch))
                (recur (next remaining) final-cid (inc index)))
              previous))
          held-cid (when (seq held) (get-in (first held) [:receipt :stateCid]))
          held-block (when held-cid
                       (ipld/read! #(local/get-block store %) schema held-cid))
          held-parent (when held-block (first (:parents held-block)))
          baseline (when (and held-block (empty? completed))
                     (ipld/read! #(local/get-block store %) schema held-parent))
          previous-state (cond
                           (seq completed)
                           (:state (ipld/read! #(local/get-block store %) schema last-cid))
                           baseline (:state baseline))
          held-state (:state held-block)
          final-cid (or held-cid last-cid)
          final (ipld/read! #(local/get-block store %) schema final-cid)]
      (when (seq held)
        (when-not (if effect-held?
                    (and (= held-cid last-cid)
                         (= :held (:status held-state))
                         (= :failed (:status (last (:receipts held-state))))
                         (every? (fn [{:keys [receipt]}]
                                   (and (= held-cid (:stateCid receipt))
                                        (= (:semantic-graph-digest held-block)
                                           (:semanticGraphDigest receipt))
                                        (= "held" (:runStatus receipt))
                                        (= (str (:hold-reason held-state))
                                           (:reason receipt))
                                        (= (:step held-state) (:step receipt))
                                        (nil? (:effectId receipt))
                                        (nil? (:action receipt)))) held))
                    (and (= [(or last-cid held-parent)] (:parents held-block))
                       (= (if (seq completed) last-cid held-parent) held-parent)
                       (or (seq completed)
                           (and baseline? (= 0 (:step previous-state))
                                (= :running (:status previous-state))
                                (nil? (:awaiting previous-state))
                                (empty? (:receipts previous-state))
                                (empty? (:parents baseline))))
                       (= :held (:status held-state))
                       (keyword? (:hold-reason held-state))
                       (= (:step previous-state) (:step held-state))
                       (= (dissoc previous-state :lease :status :hold-reason
                                  :semantic-receipts)
                          (dissoc held-state :lease :status :hold-reason
                                  :semantic-receipts))
                       (= (conj (:semantic-receipts previous-state)
                                (last (:semantic-receipts held-state)))
                          (:semantic-receipts held-state))
                       (= :decide/jev
                          (:operation (last (:semantic-receipts held-state))))
                       (= :refused
                          (:status (last (:semantic-receipts held-state))))
                       (= (execution/digest [(:run-id held-state)
                                             (:step held-state)
                                             (:hold-reason held-state)])
                          (:output-digest
                           (last (:semantic-receipts held-state))))
                       (= {:step (:step held-state)}
                          (:metrics (last (:semantic-receipts held-state))))
                       (every? (fn [{:keys [receipt]}]
                                 (and (= held-cid (:stateCid receipt))
                                      (= (:semantic-graph-digest held-block)
                                         (:semanticGraphDigest receipt))
                                      (= "held" (:runStatus receipt))
                                      (= (str (:hold-reason held-state))
                                         (:reason receipt))
                                      (= (:step held-state) (:step receipt))
                                      (nil? (:effectId receipt))
                                      (nil? (:action receipt)))) held)))
          (refuse! :primary-held-or-cid-mismatch)))
      (when-not (and (= final-cid (:head history))
                     (every? (fn [{:keys [receipt]}]
                               (and (= last-cid (:stateCid receipt))
                                    (= (:semantic-graph-digest final)
                                       (:semanticGraphDigest receipt))
                                    (= "completed" (:runStatus receipt))
                                    (nil? (:effectId receipt))
                                    (= (count completed) (:step receipt)))) terminal))
        (refuse! :primary-terminal-or-head-mismatch))
      {:status "verified" :mode "ipld-primary"
       :completedEffects (count (remove #(= "effect-failed"
                                          (get-in % [:receipt :status]))
                                        completed))
       :failedEffects (count (filter #(= "effect-failed"
                                        (get-in % [:receipt :status]))
                                     completed))
       :terminalDeliveries (count terminal)
       :heldDeliveries (count held)
       :directExecutions (count direct)
       :semanticBlocks (:blocks history)
       :stateCid final-cid
       :semanticGraphDigest (:semantic-graph-digest final)
       :runStatus (name (get-in final [:state :status]))
       :state (:state final)})))
