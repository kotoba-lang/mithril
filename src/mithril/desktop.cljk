(ns mithril.desktop
  "Closed Mithril Desktop IR and deterministic Hermes Desktop plugin emitter.

  Source describes the application and bounded agent state machine. It cannot
  inject JavaScript, CSS, RPC method names, or host capabilities."
  (:require [clojure.string :as str]
            [mithril.bot :as bot]
            [mithril.compiler :as compiler]))

(def artifact-format "https://mithril.fund/artifact/desktop-application-v1")
(def goal "https://mithril.fund/id/goal/hermes-agent-loop")
(def source-keys #{"@context" "@id" "@type" "goal" "page" "loop" "actor" "activity"})
(def page-keys #{"name" "description" "headline" "summary" "path" "navLabel" "codicon"})
(def loop-keys #{"maxSteps" "maxPolls" "pollIntervalMs" "sessionTitle" "actions"})
(def actor-keys #{"protocol" "governor" "receiptPolicy" "workspacePolicy" "maxGoalChars"})
(def activity-keys #{"schedulerPolicy" "boardPolicy" "maxActiveJobs" "maxDispatchTasks"})
(def required-actions
  ["https://mithril.fund/id/action/profiles-list"
   "https://mithril.fund/id/action/session-list"
   "https://mithril.fund/id/action/session-create"
   "https://mithril.fund/id/action/session-resume"
   "https://mithril.fund/id/action/prompt-submit"
   "https://mithril.fund/id/action/session-status"
   "https://mithril.fund/id/action/session-history"
   "https://mithril.fund/id/action/session-interrupt"
   "https://mithril.fund/id/action/cron-list"
   "https://mithril.fund/id/action/cron-add"
   "https://mithril.fund/id/action/cron-pause"
   "https://mithril.fund/id/action/cron-resume"
   "https://mithril.fund/id/action/cron-remove"
   "https://mithril.fund/id/action/kanban-board-read"
   "https://mithril.fund/id/action/kanban-task-create"
   "https://mithril.fund/id/action/kanban-dispatch"
   "https://mithril.fund/id/action/stop"])

(def actor-contract
  {"protocol" "https://mithril.fund/id/protocol/hermes-coding-agent-v1"
   "governor" "https://mithril.fund/id/governor/user-commit-v1"
   "receiptPolicy" "https://mithril.fund/id/receipt/append-only-v1"
   "workspacePolicy" "https://mithril.fund/id/workspace/user-selected-local-v1"})

(def activity-contract
  {"schedulerPolicy" "https://mithril.fund/id/scheduler/hermes-profile-cron-v1"
   "boardPolicy" "https://mithril.fund/id/board/hermes-kanban-v1"})

(defn- fail! [code detail]
  (throw (ex-info detail {:mithril/error code :detail detail})))

(defn- bounded-text! [value label ceiling]
  (when-not (and (string? value) (not (str/blank? value)) (<= (count value) ceiling))
    (fail! :mithril.desktop/invalid-text (str label " must be 1 through " ceiling " characters")))
  value)

(defn compile-document [path doc]
  (when-not (compiler/source-path? path)
    (fail! :mithril/unsupported-extension "desktop source must end in .mith or .mithril"))
  (when-not (= compiler/context-uri (get doc "@context"))
    (fail! :mithril/unpinned-context "desktop source must use the pinned context"))
  (when-not (= "DesktopApplication" (get doc "@type"))
    (fail! :mithril/unexpected-source-type "@type must be DesktopApplication"))
  (when-not (= source-keys (set (keys doc)))
    (fail! :mithril/unknown-source-key "desktop source has an unknown or missing key"))
  (when-not (= goal (get doc "goal"))
    (fail! :mithril/unknown-goal "desktop goal is outside the closed catalog"))
  (let [page (get doc "page") loop-spec (get doc "loop") actor (get doc "actor")
        activity (get doc "activity")]
    (when-not (= page-keys (set (keys page)))
      (fail! :mithril.desktop/invalid-page "desktop page has an unknown or missing key"))
    (doseq [[field ceiling] [["name" 80] ["description" 240] ["headline" 120]
                             ["summary" 480] ["navLabel" 32] ["codicon" 40]]]
      (bounded-text! (get page field) field ceiling))
    (when-not (boolean (re-matches #"/[a-z0-9-]+" (or (get page "path") "")))
      (fail! :mithril.desktop/invalid-path "desktop route must be one lowercase path segment"))
    (when-not (= loop-keys (set (keys loop-spec)))
      (fail! :mithril.desktop/invalid-loop "desktop loop has an unknown or missing key"))
    (when-not (= required-actions (get loop-spec "actions"))
      (fail! :mithril.desktop/invalid-actions "desktop v1 requires the closed seventeen-action state machine"))
    (when-not (= 17 (get loop-spec "maxSteps"))
      (fail! :mithril.desktop/invalid-budget "desktop v1 requires exactly seventeen admitted actions"))
    (let [max-polls (get loop-spec "maxPolls") poll-ms (get loop-spec "pollIntervalMs")]
      (when-not (and (integer? max-polls) (<= 1 max-polls 300))
        (fail! :mithril.desktop/invalid-budget "maxPolls must be 1 through 300"))
      (when-not (and (integer? poll-ms) (<= 250 poll-ms 10000))
        (fail! :mithril.desktop/invalid-budget "pollIntervalMs must be 250 through 10000")))
    (bounded-text! (get loop-spec "sessionTitle") "sessionTitle" 80)
    (when-not (= actor-keys (set (keys actor)))
      (fail! :mithril.desktop/invalid-actor "desktop actor has an unknown or missing key"))
    (doseq [[field expected] actor-contract]
      (when-not (= expected (get actor field))
        (fail! :mithril.desktop/invalid-actor (str field " is outside the closed actor catalog"))))
    (when-not (= 4096 (get actor "maxGoalChars"))
      (fail! :mithril.desktop/invalid-actor "desktop v1 maxGoalChars must be 4096"))
    (when-not (= activity-keys (set (keys activity)))
      (fail! :mithril.desktop/invalid-activity "desktop activity has an unknown or missing key"))
    (doseq [[field expected] activity-contract]
      (when-not (= expected (get activity field))
        (fail! :mithril.desktop/invalid-activity (str field " is outside the closed activity catalog"))))
    (when-not (and (integer? (get activity "maxActiveJobs"))
                   (<= 1 (get activity "maxActiveJobs") 64))
      (fail! :mithril.desktop/invalid-activity "maxActiveJobs must be 1 through 64"))
    (when-not (and (integer? (get activity "maxDispatchTasks"))
                   (<= 1 (get activity "maxDispatchTasks") 16))
      (fail! :mithril.desktop/invalid-activity "maxDispatchTasks must be 1 through 16"))
    {:format artifact-format
     :media-type compiler/media-type
     :graph-digest (compiler/graph-digest doc)
     :desktop-ir {:version :mithril.desktop/v1
                  :host :hermes-desktop
                  :page {:name (get page "name") :description (get page "description")
                         :headline (get page "headline") :summary (get page "summary")
                         :path (get page "path") :nav-label (get page "navLabel")
                         :codicon (get page "codicon")}
                  :loop {:max-steps 17 :max-polls (get loop-spec "maxPolls")
                         :poll-interval-ms (get loop-spec "pollIntervalMs")
                         :session-title (get loop-spec "sessionTitle")
                         :actions [:profiles/list :session/list :session/create
                                   :session/resume :prompt/submit :session/status
                                   :session/history :session/interrupt
                                   :cron/list :cron/add :cron/pause :cron/resume :cron/remove
                                   :kanban/board-read :kanban/task-create :kanban/dispatch :stop]}
                  :actor {:protocol (get actor "protocol")
                          :governor (get actor "governor")
                          :receipt-policy (get actor "receiptPolicy")
                          :workspace-policy (get actor "workspacePolicy")
                          :max-goal-chars 4096}
                  :activity {:scheduler-policy (get activity "schedulerPolicy")
                             :board-policy (get activity "boardPolicy")
                             :max-active-jobs (get activity "maxActiveJobs")
                             :max-dispatch-tasks (get activity "maxDispatchTasks")}
                  :bot {:version :mithril.bot/v1
                        :max-retries 2 :lease-seconds 900 :confidence-floor 6000
                        :actions (mapv :id bot/action-catalog)
                        :effects (mapv (fn [action]
                                         (str (namespace (:effect action)) "/" (name (:effect action))))
                                       bot/action-catalog)}
                  :capabilities [:hermes/profile-read :hermes/session-create
                                 :hermes/session-resume :hermes/session-read
                                 :hermes/session-interrupt :hermes/prompt-submit
                                 :hermes/cron-manage :hermes/kanban-read
                                 :hermes/kanban-task-create :hermes/kanban-dispatch
                                 :plugin/storage]}}))

(defn compile-text [path text]
  (compile-document path (compiler/parse-source text)))

(defn- json [value]
  #?(:cljs (js/JSON.stringify (clj->js value))
     :clj (fail! :mithril.desktop/json-host-unavailable "plugin emission requires the kbb host")))

(defn emit-plugin
  "Emit the one-file Hermes Desktop plugin. All executable code is a pinned
  compiler template; source values enter only as JSON data after validation."
  [artifact]
  (when-not (= artifact-format (:format artifact))
    (fail! :mithril.desktop/invalid-artifact "artifact is not a desktop application"))
  (let [ir (:desktop-ir artifact)
        page (:page ir)
        loop-spec (:loop ir)
        actor (:actor ir)
        activity (:activity ir)
        bot-policy (:bot ir)
        data (json {"version" "mithril.desktop/v1"
                    "graphDigest" (:graph-digest artifact)
                    "page" {"name" (:name page) "description" (:description page)
                            "headline" (:headline page) "summary" (:summary page)
                            "path" (:path page) "navLabel" (:nav-label page)
                            "codicon" (:codicon page)}
                    "loop" {"maxSteps" (:max-steps loop-spec)
                            "maxPolls" (:max-polls loop-spec)
                            "pollIntervalMs" (:poll-interval-ms loop-spec)
                            "sessionTitle" (:session-title loop-spec)}
                    "actor" {"protocol" (:protocol actor)
                             "governor" (:governor actor)
                             "receiptPolicy" (:receipt-policy actor)
                             "workspacePolicy" (:workspace-policy actor)
                             "maxGoalChars" (:max-goal-chars actor)}
                    "activity" {"schedulerPolicy" (:scheduler-policy activity)
                                "boardPolicy" (:board-policy activity)
                                "maxActiveJobs" (:max-active-jobs activity)
                                "maxDispatchTasks" (:max-dispatch-tasks activity)}
                    "bot" {"version" "mithril.bot/v1"
                           "maxRetries" (:max-retries bot-policy)
                           "leaseSeconds" (:lease-seconds bot-policy)
                           "confidenceFloor" (:confidence-floor bot-policy)
                           "actions" (:actions bot-policy)
                           "effects" (:effects bot-policy)}})]
    (str
     "// Generated by mithril.desktop/v1. Do not edit.\n"
     "import React,{useEffect,useState} from 'react';\n"
     "import {jsx,jsxs} from 'react/jsx-runtime';\n"
     "import {ROUTES_AREA,SIDEBAR_NAV_AREA,Button,Input,Textarea,Badge,StatusDot,ScrollArea,host} from '@hermes/plugin-sdk';\n"
     "const IR=" data ";\n"
     "const sleep=ms=>new Promise(resolve=>setTimeout(resolve,ms));\n"
     "const semanticRequest=(kind,text,workspace)=>'('+kind+' :protocol '+IR.actor.protocol+' :workspace '+JSON.stringify(workspace)+' :input '+JSON.stringify(text)+' :governor '+IR.actor.governor+' :decision-output typed-action-only :generated-text false :action-candidates '+JSON.stringify(IR.bot.actions)+' :effect-catalog '+JSON.stringify(IR.bot.effects)+' :output mithril/bot-effect-receipt)';\n"
     "const absolutePath=value=>value.startsWith('/')||/^[A-Za-z]:[\\\\/]/.test(value);\n"
     "const errorText=error=>String(error?.message||error);\n"
     "async function stableKey(value){const bytes=new TextEncoder().encode(value);const hash=await crypto.subtle.digest('SHA-256',bytes);return Array.from(new Uint8Array(hash)).map(x=>x.toString(16).padStart(2,'0')).join('');}\n"
     "function appendReceipt(ctx,receipt){const all=ctx.storage.get('receipts-v1',[]);ctx.storage.set('receipts-v1',[...all,receipt]);}\n"
     "function activityReceipt(ctx,update,action,status,detail){const receipt={id:Date.now()+'-'+action,at:new Date().toISOString(),action,status,detail};appendReceipt(ctx,receipt);update(current=>({...current,phase:status,receipts:[...current.receipts.slice(-99),receipt]}));return receipt;}\n"
     "function govern({text,workspace,profile,profiles}){if(!text.trim()||text.length>IR.actor.maxGoalChars)throw new Error('Input must be 1 through '+IR.actor.maxGoalChars+' characters');if(!workspace.trim()||workspace.length>1024||!absolutePath(workspace))throw new Error('Workspace must be an absolute local path');if(profile&&profiles.length&&!profiles.some(p=>p.name===profile))throw new Error('Selected bot/profile is not in the live catalog');}\n"
     "async function runTurn(input,ctx,update){const receipts=[];const record=(action,status,detail)=>{const receipt={id:Date.now()+'-'+(receipts.length+1),at:new Date().toISOString(),action,status,detail};receipts.push(receipt);appendReceipt(ctx,receipt);update({phase:status,receipts:[...receipts]});return receipt;};govern(input);let active=input.session;try{if(!active?.runtimeId){record('session/create','running',{workspace:input.workspace,profile:input.profile||null});const created=await host.request('session.create',{title:IR.loop.sessionTitle,source:'mithril-desktop',cwd:input.workspace,profile:input.profile||null,hidden:false,follow_profile_config:true});active={runtimeId:created.session_id,storedId:created.stored_session_id||created.info?.stored_session_id||created.session_id,title:created.info?.title||IR.loop.sessionTitle};record('session/create','executed',{session_id:active.runtimeId,stored_session_id:active.storedId});update({session:active,messages:created.messages||[]});}const before=await host.request('session.history',{session_id:active.runtimeId,profile:input.profile||null});const baseline=before.count||0;record('prompt/submit','running',{kind:input.kind,baseline});await host.request('prompt.submit',{session_id:active.runtimeId,profile:input.profile||null,text:semanticRequest(input.kind,input.text,input.workspace),surface:'mithril-desktop',title_preview:input.text.slice(0,80)});record('prompt/submit','executed',null);for(let poll=1;poll<=IR.loop.maxPolls;poll++){const status=await host.request('session.status',{session_id:active.runtimeId,profile:input.profile||null});const history=await host.request('session.history',{session_id:active.runtimeId,profile:input.profile||null});const fresh=(history.messages||[]).slice(baseline);const answer=[...fresh].reverse().find(m=>m.role==='assistant'&&m.text);update({messages:history.messages||[],session:active});if(answer){record('session/status','executed',{poll,output:status.output});record('session/history','executed',{poll,count:history.count});record('stop','committed',{reason:'assistant-complete',session_id:active.runtimeId});return {receipts,session:active,messages:history.messages||[]};}await sleep(IR.loop.pollIntervalMs);}record('stop','held',{reason:'poll-budget-exhausted',session_id:active.runtimeId});return {receipts,session:active,messages:[]};}catch(error){record('stop','refused',{reason:errorText(error)});throw error;}}\n"
     "const tabStyle=active=>({padding:'7px 12px',border:'1px solid var(--ui-stroke-secondary)',borderRadius:'6px',background:active?'var(--ui-bg-secondary)':'transparent',color:'var(--ui-text-primary)',cursor:'pointer'});\n"
     "const cardStyle={padding:'12px',border:'1px solid var(--ui-stroke-secondary)',borderRadius:'8px',background:'var(--ui-bg-secondary)'};\n"
     "function App({ctx}){const [tab,setTab]=useState('coding');const [workspace,setWorkspace]=useState(()=>ctx.storage.get('workspace',''));const [goal,setGoal]=useState('Implement and verify one bounded change in this workspace.');const [chat,setChat]=useState('');const [profiles,setProfiles]=useState([]);const [profile,setProfile]=useState(()=>ctx.storage.get('profile',''));const [sessions,setSessions]=useState([]);const [session,setSession]=useState(null);const [messages,setMessages]=useState([]);const [busy,setBusy]=useState(false);const [cronJobs,setCronJobs]=useState([]);const [board,setBoard]=useState({columns:[]});const [routine,setRoutine]=useState({name:'Mithril routine',schedule:'every 1h',prompt:'Inspect the selected workspace and complete one bounded, verified improvement.'});const [card,setCard]=useState({title:'Mithril coding task',body:'Complete one bounded change and verify it.'});const [state,setState]=useState({phase:'idle',receipts:ctx.storage.get('receipts-v1',[]).slice(-100)});const running=busy;const update=patch=>setState(current=>({...current,...patch}));\n"
     " const refreshProfiles=async()=>{const result=await host.request('profiles.list',{include_sessions:true});const rows=result.profiles||[];setProfiles(rows);if(!profile){const chosen=rows.find(p=>p.is_default)?.name||rows[0]?.name||'';setProfile(chosen);ctx.storage.set('profile',chosen);}return rows;};\n"
     " const refreshSessions=async(selected=profile)=>{const result=await host.request('session.list',{profile:selected||null,limit:100,include_hidden:false});setSessions(result.sessions||[]);};\n"
     " const refreshCron=async(selected=profile)=>{const result=await host.request('cron.manage',{action:'list',include_disabled:true,profile:selected||null});setCronJobs((result.jobs||result.crons||[]).slice(0,IR.activity.maxActiveJobs));return result;};\n"
     " const refreshBoard=async()=>{const result=await ctx.rest('/kanban/board');setBoard(result||{columns:[]});return result;};\n"
     " useEffect(()=>{let disposed=false,attempt=0,timer=null;const load=async()=>{refreshBoard().catch(error=>update({phase:'refused',error:errorText(error)}));if(profile)refreshCron(profile).catch(error=>update({phase:'refused',error:errorText(error)}));try{const rows=await refreshProfiles();const selected=profile||rows.find(p=>p.is_default)?.name||rows[0]?.name||'';await Promise.all([refreshSessions(selected),selected===profile?Promise.resolve():refreshCron(selected)]);if(!disposed)update({phase:'idle',error:null});}catch(error){if(disposed)return;update({phase:'refused',error:errorText(error)});attempt+=1;if(attempt<20)timer=setTimeout(load,1500);}};load();return()=>{disposed=true;if(timer)clearTimeout(timer);};},[]);\n"
     " const chooseProfile=value=>{setProfile(value);ctx.storage.set('profile',value);setSession(null);setMessages([]);refreshSessions(value).catch(error=>update({phase:'refused',error:errorText(error)}));};\n"
     " const chooseWorkspace=value=>{setWorkspace(value);ctx.storage.set('workspace',value);};\n"
     " const resume=async row=>{setBusy(true);update({phase:'running',error:null});try{const result=await host.request('session.resume',{session_id:row.id,profile:profile||null,eager_build:true});const active={runtimeId:result.session_id,storedId:result.stored_session_id||row.id,title:row.title||result.info?.title||''};setSession(active);setMessages(result.messages||[]);update({phase:'executed'});setTab('chat');}catch(error){update({phase:'refused',error:errorText(error)});}finally{setBusy(false);}};\n"
     " const submit=async(kind,text,clear)=>{setBusy(true);update({phase:'running',receipts:[],error:null});try{const result=await runTurn({kind,text,workspace,profile,profiles,session},ctx,patch=>{if(patch.session)setSession(patch.session);if(patch.messages)setMessages(patch.messages);update(patch);});setSession(result.session);setMessages(result.messages);update({phase:result.receipts.at(-1)?.status||'executed',receipts:result.receipts});if(clear)setChat('');refreshSessions(profile);}catch(error){update({phase:'refused',error:errorText(error)});}finally{setBusy(false);}};\n"
     " const cronAction=async(action,job)=>{setBusy(true);activityReceipt(ctx,setState,'cron/'+action,'running',{profile,job:job?.job_id||null});try{const params={action,profile:profile||null};if(action==='add'){govern({text:routine.prompt,workspace,profile,profiles});const name='[mithril:'+profile+'] '+routine.name;if(cronJobs.some(j=>j.enabled!==false&&j.name===name))throw new Error('An enabled Mithril routine with this identity already exists');if(cronJobs.filter(j=>j.enabled!==false).length>=IR.activity.maxActiveJobs)throw new Error('Mithril active-job budget is exhausted');Object.assign(params,{name,schedule:routine.schedule,prompt:semanticRequest('mithril/cron-task',routine.prompt,workspace),repeat:true,continuity:'new',deliver:false});}else params.name=job.job_id;const result=await host.request('cron.manage',params);if(result?.error)throw new Error(result.error);activityReceipt(ctx,setState,'cron/'+action,'committed',result);await refreshCron(profile);}catch(error){activityReceipt(ctx,setState,'cron/'+action,'refused',{reason:errorText(error)});}finally{setBusy(false);}};\n"
     " const createCard=async()=>{setBusy(true);activityReceipt(ctx,setState,'kanban/task-create','running',{profile,workspace});try{govern({text:card.body,workspace,profile,profiles});const key=await stableKey([profile,workspace,card.title,card.body,IR.graphDigest].join('\\n'));const created=await ctx.rest('/kanban/tasks',{method:'POST',body:{title:card.title,body:semanticRequest('mithril/kanban-task',card.body,workspace),assignee:profile||null,workspace_kind:'dir',workspace_path:workspace,triage:false,idempotency_key:'mithril-'+key,max_runtime_seconds:IR.bot.leaseSeconds,max_retries:IR.bot.maxRetries,completion_contract:'terminal receipt with compile/test evidence'}});activityReceipt(ctx,setState,'kanban/task-create','committed',{task_id:created?.task?.id,idempotency_key:'mithril-'+key});const dispatched=await ctx.rest('/kanban/dispatch?max='+IR.activity.maxDispatchTasks,{method:'POST'});activityReceipt(ctx,setState,'kanban/dispatch','executed',dispatched);await refreshBoard();}catch(error){activityReceipt(ctx,setState,'kanban/task-create','refused',{reason:errorText(error)});}finally{setBusy(false);}};\n"
     " const interrupt=async()=>{if(!session?.runtimeId)return;try{await host.request('session.interrupt',{session_id:session.runtimeId,profile:profile||null});update({phase:'held'});}catch(error){update({phase:'refused',error:errorText(error)});}};\n"
     " const header=jsxs('header',{children:[jsx(Badge,{children:'Mithril governed coding'}),jsx('h1',{style:{fontSize:'24px',margin:'10px 0 4px'},children:IR.page.headline}),jsx('p',{style:{color:'var(--ui-text-secondary)',maxWidth:'820px'},children:IR.page.summary}),jsxs('div',{style:{display:'flex',gap:'8px',marginTop:'12px',flexWrap:'wrap'},children:['coding','chat','sessions','bots','activity'].map(name=>jsx('button',{style:tabStyle(tab===name),onClick:()=>setTab(name),children:name[0].toUpperCase()+name.slice(1)},name))})]});\n"
     " const controls=jsxs('section',{style:{display:'grid',gridTemplateColumns:'minmax(260px,1fr) minmax(180px,280px)',gap:'10px'},children:[jsx(Input,{value:workspace,onChange:e=>chooseWorkspace(e.target.value),placeholder:'/absolute/path/to/workspace','aria-label':'Coding workspace'}),profiles.length?jsx('select',{value:profile,onChange:e=>chooseProfile(e.target.value),style:{padding:'8px',borderRadius:'6px',background:'var(--ui-bg-secondary)',color:'var(--ui-text-primary)',border:'1px solid var(--ui-stroke-secondary)'},'aria-label':'Bot profile',children:profiles.map(p=>jsx('option',{value:p.name,children:(p.display_name||p.name)+(p.model?' — '+p.model:'')},p.name))}):jsx(Input,{value:profile,onChange:e=>chooseProfile(e.target.value),placeholder:'Hermes profile name','aria-label':'Bot profile'})]});\n"
     " const coding=jsxs('section',{style:{display:'grid',gap:'10px'},children:[jsx(Textarea,{value:goal,onChange:e=>setGoal(e.target.value),rows:6,'aria-label':'Coding goal'}),jsxs('div',{style:{display:'flex',gap:'10px',alignItems:'center'},children:[jsx(Button,{onClick:()=>submit('mithril/coding-request',goal,false),disabled:running,children:running?'Coding…':session?'Continue coding session':'Run coding agent'}),session&&jsx(Button,{variant:'secondary',onClick:()=>{setSession(null);setMessages([]);},disabled:running,children:'New session'}),jsx(StatusDot,{status:state.phase==='committed'||state.phase==='executed'?'online':state.phase==='refused'?'error':'idle'}),jsx('span',{style:{color:'var(--ui-text-secondary)'},children:state.phase})]}),state.error&&jsx('p',{style:{color:'var(--ui-danger-foreground)'},children:state.error}),jsx('p',{style:{color:'var(--ui-text-tertiary)',fontSize:'12px'},children:'The user commits the task. The model proposes changes; Hermes tools and checks execute them inside the selected workspace. Every transition is receipted.'})]});\n"
