(ns mithril.reason
  "Generic OWL 2 RL entailment and SHACL Core checking over ANY compiled
  Mithril ontology and a caller's data graph.

  The domain modules (checkpoint, decision_semantic, domain_rdf, execution,
  growth_semantic, state_ontology) each accept only their own fixed ontology.
  This namespace takes the ontology as input instead:

    (reason (compiler/compile-ontology-text path text)
            (parse-data path data-text)
            {})

  ## What is entailed

  Axioms are read from the ontology's RDF (the JSON-LD dataset the compiler
  produced, expanded to quads), never from compact keys, so any context term
  that expands to one of the accepted predicates is honoured. Entailment is
  `oak.semantic/materialize :owl2-rl`, i.e. `owl.rules/triple-rules`.

  Which OWL / RDFS terms are ACCEPTED as axioms is a capability set,
  `owl-vocabulary`: `owl.rules/supported-vocabulary` when the pinned
  org-w3-owl2 defines it, otherwise `fixed-owl-vocabulary` -- the terms the
  current pin's rules implement:

    rdfs11   rdfs:subClassOf is transitive
             (owl:equivalentClass folds in as subsumption both ways)
    rdfs5    rdfs:subPropertyOf is transitive
    rdfs9    rdf:type climbs the class hierarchy, from asserted AND derived types
    rdfs7    a sub-property's triples are the super-property's
    rdfs2    rdfs:domain types the subject
    rdfs3    rdfs:range types the object
    prp-trp  owl:TransitiveProperty closes over derived triples
    prp-symp owl:SymmetricProperty reads backwards
    prp-inv  owl:inverseOf, both directions

  Bumping the owl2 / oak pin to one that exports `supported-vocabulary`
  (and `supported-rules`) widens both with no change here. Any OWL / RDFS
  axiom outside the capability set (owl:FunctionalProperty, owl:disjointWith,
  owl:someValuesFrom, ... at the current pin) REFUSES with
  `:unsupported-owl-axiom`: reasoning without it would silently answer a
  subset. owl:ReflexiveProperty is outside OWL 2 RL and always refuses with
  `:not-owl2-rl`.

  ## What is checked (SHACL Core)

  `mithril.shacl`: every SHACL Core target, shape, path and constraint
  component (W3C SHACL §2-4), evaluated over the ENTAILED graph -- so
  sh:class accepts an entailed type, and a sub-property's triple counts for
  its super-property's path. SHACL-SPARQL and any unknown sh: term refuse by
  name. The result carries a W3C-shaped validation report (`:report`).

  ## Outcomes

  `:status` is `:conforms`, `:violations` (the report does not conform, at
  any severity) or `:refused`. A refusal names its reason; zero data triples
  is a refusal (`:no-data-triples`), not a pass."
  (:require [clojure.string :as str]
            [json-ld-api.core :as jsonld]
            [json-ld-api.to-rdf :as to-rdf]
            [nquads.core :as nq]
            [oak.semantic :as oak]
            [owl.rules]
            [mithril.compiler :as compiler]
            [mithril.shacl :as shacl]))

(def rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#")
(def rdfs "http://www.w3.org/2000/01/rdf-schema#")
(def owl "http://www.w3.org/2002/07/owl#")
(def sh "http://www.w3.org/ns/shacl#")
(def xsd "http://www.w3.org/2001/XMLSchema#")
(def rdf-type (str rdf "type"))

;; ── the OWL capability set ──────────────────────────────────────────────────

(defn- owl-rules-export
  "The value of `owl.rules/<sym>` when the pinned org-w3-owl2 defines it
  (a zero-arity fn is called), else nil. This is the seam a pin bump widens."
  [sym]
  (when-let [v (resolve (symbol "owl.rules" (name sym)))]
    (let [x @v] (if (fn? x) (x) x))))

(def fixed-rules
  "The rules the current owl2 pin's `triple-rules` implements."
  [:rdfs11 :rdfs5 :rdfs9 :rdfs7 :rdfs2 :rdfs3 :prp-trp :prp-symp :prp-inv])

(def rules
  "The rule names `reason` evaluates: `owl.rules/supported-rules` when the
  pin exports it, else `fixed-rules`."
  (vec (or (owl-rules-export 'supported-rules) fixed-rules)))

(def fixed-owl-vocabulary
  "The OWL / RDFS terms (as IRIs) the current pin's rules read: predicates
  whose triples are axioms, and rdf:type objects that switch a rule on."
  #{(str rdfs "subClassOf") (str rdfs "subPropertyOf") (str rdfs "domain")
    (str rdfs "range") (str owl "equivalentClass") (str owl "inverseOf")
    (str owl "TransitiveProperty") (str owl "SymmetricProperty")})

(def ^:private prefixes {"rdf" rdf "rdfs" rdfs "owl" owl})

(defn vocabulary-term->iri
  "A vocabulary entry as an IRI: an IRI string as is, or a keyword in the
  `owl.rules/keyword-vocabulary` convention (:owl/FunctionalProperty)."
  [t]
  (cond
    (string? t) t
    (and (keyword? t) (contains? prefixes (namespace t))) (str (get prefixes (namespace t)) (name t))
    :else nil))

(defn owl-vocabulary
  "The accepted OWL / RDFS axiom terms as IRIs. `supported` is what
  `owl.rules/supported-vocabulary` holds -- a map (its values are read, as
  in `owl.rules/keyword-vocabulary`) or a collection of keywords / IRIs --
  or nil, meaning the pin predates it and `fixed-owl-vocabulary` applies."
  ([] (owl-vocabulary (owl-rules-export 'supported-vocabulary)))
  ([supported]
   (if (nil? supported)
     fixed-owl-vocabulary
     (set (keep vocabulary-term->iri (if (map? supported) (vals supported) supported))))))

(def not-owl2-rl
  "Terms refused whatever the capability set says: outside OWL 2 RL."
  #{(str owl "ReflexiveProperty")})

(def list-predicates #{(str rdf "first") (str rdf "rest")})

(def declaration-classes
  "rdf:type objects that only declare a term; no rule reads them."
  #{(str owl "Class") (str owl "ObjectProperty") (str owl "DatatypeProperty")
    (str owl "AnnotationProperty") (str owl "NamedIndividual") (str owl "Ontology")
    (str owl "Thing") (str rdfs "Class") (str rdf "Property")
    (str sh "NodeShape") (str sh "PropertyShape")})

(def annotation-predicates
  #{(str rdfs "label") (str rdfs "comment") (str rdfs "seeAlso")
    (str rdfs "isDefinedBy") (str owl "versionInfo") (str owl "deprecated")})

(defn- refusal [reason detail]
  (ex-info (str "mithril.reason refused: " (name reason))
           {:mithril.reason/refusal reason :detail detail}))

(defn- refuse! [reason detail] (throw (refusal reason detail)))

;; ── RDF terms ────────────────────────────────────────────────────────────────

(defn- in-ns? [iri ns*] (and (string? iri) (str/starts-with? iri ns*)))

(defn- iri->term
  "rdf: / rdfs: / owl: IRIs become the keywords the `owl.rules` keyword
  vocabulary uses (:rdfs/subClassOf); everything else stays an IRI string."
  [iri]
  (or (some (fn [[p ns*]]
              (let [local (when (in-ns? iri ns*) (subs iri (count ns*)))]
                (when (and local (re-matches #"[A-Za-z][A-Za-z0-9_]*" local))
                  (keyword p local))))
            prefixes)
      iri))

(defn- term-value
  "An RDF term as a reasoner value: IRIs as strings (or the rule vocabulary's
  keyword), blank nodes as `_:<scope>-<label>` so data and ontology blank nodes
  can never merge, literals as maps."
  [scope {:keys [type value datatype language]}]
  (case type
    :iri (iri->term value)
    :blank (str "_:" scope "-" value)
    :literal (cond-> {:literal value
                      :datatype (cond language (str rdf "langString")
                                      datatype datatype
                                      :else (str xsd "string"))}
               language (assoc :language language))
    (refuse! :unsupported-rdf-term {:term type})))

(defn- iri-of [v] (if (keyword? v) (str (get prefixes (namespace v)) (name v)) v))

(defn- literal? [v] (map? v))

(def context-prefixes
  "The prefixes the Mithril context declares (`rdfs`, `sh`, `mith`, ...)."
  (set (keep (fn [[k v]] (when (and (string? v) (re-find #"[#/]$" v)) k))
             (get compiler/context-document "@context"))))

(defn- unexpanded-compact-iri?
  "True for `rdfs:subClassOf`-shaped strings: a scheme that is really one of
  the context's prefixes. Such a string passes an absolute-IRI check, which
  is how a half-expanded JSON-LD document reaches RDF unnoticed."
  [iri]
  (let [scheme (second (re-find #"^([A-Za-z][A-Za-z0-9+.\-]*):" (str iri)))]
    (or (nil? scheme) (contains? context-prefixes scheme))))

(defn quads->triples
  "Quads (json-ld-api / nquads shape) -> oak triples. The graph position is
  dropped: default and named graphs are reasoned over as one graph. A
  predicate that is not an absolute IRI, or is a compact IRI whose prefix
  was never expanded, refuses with `:non-iri-predicate`."
  [scope quads]
  (mapv (fn [{:keys [subject predicate object]}]
          (let [p (:value predicate)]
            (when (or (not= :iri (:type predicate)) (unexpanded-compact-iri? p))
              (refuse! :non-iri-predicate {:predicate p :scope scope}))
            (oak/triple (term-value scope subject)
                        (term-value scope predicate)
                        (term-value scope object))))
        quads))

(defn- out-triple [{:keys [s p o]}]
  {:s (iri-of s) :p (iri-of p) :o (if (literal? o) o (iri-of o))})

;; ── inputs ───────────────────────────────────────────────────────────────────

(defn ontology-quads
  "The compiled ontology's RDF dataset as quads."
  [artifact]
  (when-not (= "https://mithril.fund/artifact/ontology-v1" (:format artifact))
    (refuse! :not-an-ontology-artifact {:format (:format artifact)}))
  (compiler/ontology-quads artifact))

(defn data-format [path]
  (let [ext (some-> (re-find #"\.([A-Za-z]+)$" (str path)) second str/lower-case)]
    (case ext
      ("nq" "nt") :nquads
      ("jsonld" "json") :jsonld
      nil)))

(defn parse-data
  "Data text -> quads. N-Quads / N-Triples through `nquads.core/parse`;
  JSON-LD through the same expansion the compiler uses, with the Mithril
  context supplied and every other remote context refused (never fetched)."
  [path text]
  (case (data-format path)
    :nquads (nq/parse text)
    :jsonld (to-rdf/to-rdf (jsonld/expand (compiler/parse-json text)
                                          {:contexts {compiler/context-uri
                                                      compiler/context-document}}))
    (refuse! :unknown-data-format {:path path :supported [".nq" ".nt" ".jsonld" ".json"]})))

;; ── ontology -> axioms and shapes ────────────────────────────────────────────

(defn- classify-ontology-triple
  "One of :axiom, :list, :declaration, :shape, :annotation, or
  [:refuse reason detail]. The triple has its IRIs as strings."
  [vocabulary {:keys [shape-ids owned]} {:keys [s p o]}]
  (cond
    (contains? owned s) :shape
    (and (contains? shape-ids s)
         (or (in-ns? p sh) (and (= rdf-type p) (in-ns? o sh)))) :shape
    (contains? list-predicates p) :list
    (= rdf-type p) (cond (contains? not-owl2-rl o) [:refuse :not-owl2-rl {:subject s :type o}]
                         (contains? vocabulary o) :axiom
                         (contains? declaration-classes o) :declaration
                         (or (in-ns? o owl) (in-ns? o rdfs) (in-ns? o sh))
                         [:refuse :unsupported-owl-axiom {:subject s :type o}]
                         :else :declaration)
    (contains? vocabulary p) :axiom
    (contains? annotation-predicates p) :annotation
    (or (in-ns? p owl) (in-ns? p rdfs) (in-ns? p rdf))
    [:refuse :unsupported-owl-axiom {:subject s :predicate p}]
    (in-ns? p sh) [:refuse :unsupported-shacl-constraint {:subject s :constraint p}]
    :else :annotation))

(defn compile-ontology
  "Ontology artifact -> {:axioms #{triple} :shapes compiled-shapes :counts {...}},
  or a refusal (thrown as ex-info carrying :mithril.reason/refusal).
  `vocabulary` defaults to `(owl-vocabulary)`. rdf:first / rdf:rest outside
  the shapes are list structure and travel with the axioms that use them;
  the first refusal in term order is thrown, its detail's :all lists every
  refused triple."
  ([artifact] (compile-ontology artifact (owl-vocabulary)))
  ([artifact vocabulary]
   (let [triples (quads->triples "o" (ontology-quads artifact))
         plain (mapv out-triple triples)
         shapes (shacl/compile-shapes plain)
         classes (mapv (fn [t pt] [t (classify-ontology-triple vocabulary shapes pt)])
                       triples plain)
         refusals (sort-by pr-str (keep (fn [[_ c]] (when (vector? c) c)) classes))
         _ (when-let [[_ reason detail] (first refusals)]
             (refuse! reason (assoc detail :all (mapv #(nth % 2) refusals))))
         by (group-by second classes)
         compiled (vals (:shapes shapes))
         node-shapes (remove :path compiled)]
     {:axioms (into (set (map first (get by :axiom))) (map first (get by :list)))
      :shapes shapes
      :vocabulary vocabulary
      :counts {:ontology-triples (count triples)
               :axioms (count (get by :axiom))
               :declarations (count (get by :declaration))
               :annotations (count (get by :annotation))
               :shape-triples (count (get by :shape))
               :node-shapes (count node-shapes)
               :property-shapes (count (filter :path compiled))
               :untargeted-node-shapes
               (count (filter (fn [{:keys [targets]}]
                                (and (every? empty? (vals (dissoc targets :implicit-class?)))
                                     (not (:implicit-class? targets))))
                              node-shapes))
               :inactive-parameters (count (:inactive shapes))}})))

;; ── SHACL results as the violation list ─────────────────────────────────────

(defn- violation
  "A report result in the shape the CLI prints (focus / constraint / path /
  expected / value / count / shape), plus the component and severity."
  [{:keys [focus-node result-path value source-shape source-constraint-component
           result-severity param expected count] :as r}]
  (cond-> {:focus focus-node
           :constraint (str "sh:" (subs param (clojure.core/count sh)))
           :component source-constraint-component
           :severity result-severity
           :expected expected
           :shape source-shape}
    (some? result-path) (assoc :path result-path)
    (contains? r :value) (assoc :value value)
    (some? count) (assoc :count count)))

;; ── the entry ────────────────────────────────────────────────────────────────

(defn reason
  "ontology-artifact: `mithril.compiler/compile-ontology-text` output.
  data-triples: quads (as `parse-data` returns) or oak triples ({:s :p :o}).
  opts: {:query-type <class IRI>} narrows :types to that class;
        {:vocabulary #{iri}} overrides the OWL capability set.

  Returns {:status :conforms|:violations|:refused
           :refusal {:reason kw :detail {...}}   ; only when refused
           :entailed [triple] :inferred [triple] :types [triple]
           :report {:conforms bool :results [...]} ; W3C-shaped, mithril.shacl/report
           :violations [...] :inactive [...] :rules [...] :counts {...}}"
  [ontology-artifact data-triples opts]
  (try
    (let [{:keys [axioms shapes counts]} (compile-ontology ontology-artifact
                                                           (or (:vocabulary opts) (owl-vocabulary)))
          data (if (every? #(contains? % :s) data-triples)
                 (vec data-triples)
                 (quads->triples "d" data-triples))
          _ (when (empty? data)
              (refuse! :no-data-triples {:data-triples 0}))
          asserted (into (set axioms) data)
          entailed (oak/materialize :owl2-rl asserted)
          data-nodes (set (concat (map :s data)
                                  (keep #(when-not (literal? (:o %)) (:o %)) data)))
          inferred (remove asserted entailed)
          types (->> entailed
                     (filter #(and (= :rdf/type (:p %)) (contains? data-nodes (:s %))))
                     (filter #(or (nil? (:query-type opts))
                                  (= (:query-type opts) (iri-of (:o %)))))
                     (map #(assoc (out-triple %) :inferred? (not (contains? asserted %))))
                     (sort-by (juxt :s :o))
                     vec)
          validation (shacl/validate shapes (map out-triple entailed))
          violations (mapv violation (:results validation))]
      {:status (if (:conforms validation) :conforms :violations)
       :rules rules
       :entailed (mapv out-triple (sort-by pr-str entailed))
       :inferred (mapv out-triple (sort-by pr-str inferred))
       :types types
       :report (shacl/report validation)
       :violations violations
       :inactive (:inactive shapes)
       :counts (merge counts
                      {:data-triples (count data)
                       :data-nodes (count data-nodes)
                       :entailed (count entailed)
                       :inferred (count inferred)
                       :types (count types)
                       :focus-nodes (get-in validation [:counts :focus-nodes])
                       :checks (get-in validation [:counts :checks])
                       :violations (count violations)})})
    (catch #?(:cljs :default :clj Exception) e
      (if-let [reason* (:mithril.reason/refusal (ex-data e))]
        {:status :refused
         :refusal {:reason reason* :detail (:detail (ex-data e))}
         :rules rules :entailed [] :inferred [] :types [] :violations []
         :counts {}}
        (throw e)))))
