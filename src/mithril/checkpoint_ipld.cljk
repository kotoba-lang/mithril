(ns mithril.checkpoint-ipld
  "Private IPLD blocks for ontology-validated bot state. Branches are immutable
  CIDs; the bounded merge below admits only additive semantic facts, never
  divergent tool effects. Mutable names and distributed synchronization are
  deliberately outside this value layer."
  (:require #?(:cljs [cljs.reader :as reader]
               :clj [clojure.edn :as reader])
            [clojure.set :as set]
            [ipld.core :as ipld]
            [mithril.checkpoint :as checkpoint]
            [mithril.domain-rdf :as domain-rdf]
            [mithril.decision-proof :as decision-proof]
            [mithril.decision-semantic :as decision-semantic]
            [mithril.execution :as execution]
            [mithril.state-ontology :as state-ontology]
            [mithril.state-rdf :as state-rdf]
            [mithril.state-node :as state-node]
            [multiformats.core :as multiformats]))

(def format-v1 "https://mithril.fund/block/bot-checkpoint-ipld-v1")
(def format-v2 "https://mithril.fund/block/bot-checkpoint-ipld-v2")
(def format-v3 "https://mithril.fund/block/bot-checkpoint-ipld-v3")
(def format-v4 "https://mithril.fund/block/bot-checkpoint-ipld-v4")
(def format-v5 "https://mithril.fund/block/bot-checkpoint-ipld-v5")
(def format-v6 "https://mithril.fund/block/bot-checkpoint-ipld-v6")
(def format-id "https://mithril.fund/block/bot-checkpoint-ipld-v7")
(defn canonical-format? [value]
  (contains? #{format-v2 format-v3 format-v4 format-v5 format-v6 format-id} value))
(def node-keys-v1
  #{"format" "ontologyDigest" "checkpointDigest" "graphDigest"
    "stateDigest" "stateEdn" "source" "parents"})
(def node-keys-v2
  (into node-keys-v1
        #{"semanticOntologySource" "semanticContext" "semanticSource"
          "semanticGraphDigest"}))
(def node-keys-v3
  (conj (disj node-keys-v2 "stateEdn") "stateNode"))
(def node-keys-v4
  (conj (disj node-keys-v3 "stateNode") "stateDataset"))
(def node-keys-v5
  (into node-keys-v4 #{"stateOntologySource" "stateOntologyDigest"}))
(def node-keys-v6
  (into node-keys-v5 #{"domainOntologySource" "domainOntologyDigest"
                       "domainDataset" "domainGraphDigest"}))
(def node-keys-v7
  (into node-keys-v6 #{"decisionOntologySource" "decisionOntologyDigest"
                       "decisionOutputDataset" "decisionOutputGraphDigest"}))

(defn- local-state-ontology-source []
  #?(:cljs (.readFileSync (js/require "node:fs")
                         state-ontology/ontology-path "utf8")
     :clj (slurp state-ontology/ontology-path)))

(defn- local-domain-ontology-source []
  #?(:cljs (.readFileSync (js/require "node:fs")
                         domain-rdf/ontology-path "utf8")
     :clj (slurp domain-rdf/ontology-path)))

(defn- local-decision-ontology-source []
  #?(:cljs (.readFileSync (js/require "node:fs")
                         decision-semantic/ontology-path "utf8")
     :clj (slurp decision-semantic/ontology-path)))

(defn ontology-source-contract
  "Snapshot the local ontology inputs read by checkpoint verification.
  A CAR proof may only be reused for import while these sources stay equal."
  []
  {:state (local-state-ontology-source)
   :domain (local-domain-ontology-source)
   :decision (local-decision-ontology-source)})

(defn- refuse! [reason]
  (throw (ex-info "Mithril IPLD checkpoint refused"
                  {:mithril/error :mithril.checkpoint-ipld/refused
                   :reason reason})))

(defn- valid-cid? [id]
  (try
    (and (string? id)
         (= multiformats/codec-dag-cbor (ipld/cid-codec id)))
    (catch #?(:cljs :default :clj Exception) _ false)))

(defn- valid-parents! [parents]
  (when-not (and (vector? parents)
                 (<= (count parents) 2)
                 (= parents (vec (sort (distinct parents))))
                 (every? valid-cid? parents))
    (refuse! :invalid-parents))
  parents)

(defn- node-v1 [schema state parents]
  (valid-parents! parents)
  (let [{:keys [digest block]} (checkpoint/build schema state nil)]
    {"format" format-v1
     "ontologyDigest" (:ontology-digest schema)
     "checkpointDigest" digest
     "graphDigest" (:graph-digest block)
     "stateDigest" (:state-digest block)
     "stateEdn" (execution/canonical-edn-text state)
     "source" (:source block)
     "parents" (mapv ipld/link parents)}))

(defn- node-v2 [schema state parents]
  (let [base (node-v1 schema state parents)
        semantic (checkpoint/semantic-graph state nil)]
    (assoc base
           "format" format-v2
           "semanticOntologySource" (:ontology-source schema)
           "semanticContext" checkpoint/semantic-context-uri
           "semanticSource" (:source semantic)
           "semanticGraphDigest" (:graph-digest semantic))))

(defn- node-v3 [schema state parents]
  (-> (node-v2 schema state parents)
      (dissoc "stateEdn")
      (assoc "format" format-v3
             "stateNode" (state-node/encode-value state))))

(defn- node-v4 [schema state parents]
  (let [dataset (state-rdf/quads (state-rdf/document state))]
    (-> (node-v3 schema state parents)
        (dissoc "stateNode")
        (assoc "format" format-v4
               "stateDataset" (state-rdf/pack-quads dataset)))))

(defn- node-v5 [schema state parents ontology-source]
  (let [base (node-v4 schema state parents)
        checked (state-ontology/schema ontology-source)
        report (state-ontology/validate!
                checked (state-rdf/unpack-quads! (get base "stateDataset")))]
    (when-not (:valid? report)
      (throw (ex-info "checkpoint violates state graph SHACL shape"
                      {:mithril/error :mithril.checkpoint-ipld/state-shacl-violation
                       :report report})))
    (assoc base "format" format-v5
           "stateOntologySource" ontology-source
           "stateOntologyDigest" (:ontology-digest checked))))

(defn- node-v6 [schema state parents state-source domain-source]
  (let [base (node-v5 schema state parents state-source)
        checked (domain-rdf/schema domain-source)
        domain-state (assoc state :task-digest (checkpoint/task-identity state))
        dataset (domain-rdf/quads (domain-rdf/document domain-state))
        report (domain-rdf/validate! checked dataset)]
    (when-not (:valid? report)
      (throw (ex-info "checkpoint violates domain SHACL shape"
                      {:mithril/error :mithril.checkpoint-ipld/domain-shacl-violation
                       :report report})))
    (assoc base "format" format-v6
           "domainOntologySource" domain-source
           "domainOntologyDigest" (:ontology-digest checked)
           "domainDataset" (domain-rdf/pack-quads dataset)
           "domainGraphDigest" (domain-rdf/graph-digest dataset))))

(defn- decision-output-dataset [state checked]
  (let [records (filterv #(and (= :decide/jev (:operation %))
                               (= :admitted (:status %)))
                         (:semantic-receipts state))
        proofs (mapv :proof records)
        _ (when (> (count proofs) 64) (refuse! :too-many-decisions))
        quads (vec (mapcat #(decision-semantic/checked-output-quads! checked %)
                           proofs))
        subjects (filterv #(= decision-semantic/decision-class
                              (get-in % [:object :value]))
                          (filter #(= state-rdf/rdf-type
                                      (get-in % [:predicate :value])) quads))]
    (when-not (= (count proofs)
                 (count (set (map #(get-in % [:subject :value]) subjects))))
      (refuse! :duplicate-decision-output))
    quads))

(defn- node-v7 [schema state parents state-source domain-source decision-source]
  (let [base (node-v6 schema state parents state-source domain-source)
        checked (decision-semantic/schema decision-source)
        dataset (decision-output-dataset state checked)]
    (assoc base "format" format-id
           "decisionOntologySource" decision-source
           "decisionOntologyDigest" (:ontology-digest checked)
           "decisionOutputDataset" (domain-rdf/pack-quads dataset)
           "decisionOutputGraphDigest" (domain-rdf/graph-digest dataset))))

(defn block
  "Create canonical DAG-CBOR bytes and a real CID for one checked state."
  [schema state parents]
  (ipld/node->block (node-v7 schema state parents
                             (local-state-ontology-source)
                             (local-domain-ontology-source)
                             (local-decision-ontology-source))))

(defn read!
  "Resolve and rehash a CID, then rerun Mithril parsing, OWL, SPARQL and SHACL
  over its full state. Never trust the CID lookup or the stored projection alone."
  [get-fn schema id]
  (when-not (valid-cid? id) (refuse! :invalid-cid))
  (let [value (ipld/get-node get-fn id)]
    (when-not value (refuse! :missing-block))
    (let [version (get value "format")
          v7? (= format-id version)
          v6? (= format-v6 version)
          v5? (= format-v5 version)
          v4? (= format-v4 version)
          v3? (= format-v3 version)
          semantic? (canonical-format? version)]
    (when-not (and (map? value)
                   (contains? #{format-v1 format-v2 format-v3 format-v4 format-v5
                                format-v6 format-id}
                              version)
                   (= (cond v7? node-keys-v7
                            v6? node-keys-v6
                            v5? node-keys-v5
                            v4? node-keys-v4
                            v3? node-keys-v3
                            semantic? node-keys-v2
                            :else node-keys-v1)
                      (set (keys value)))
                   (= (:ontology-digest schema) (get value "ontologyDigest"))
                   (or (not semantic?)
                       (and (= (:ontology-source schema)
                               (get value "semanticOntologySource"))
                            (= checkpoint/semantic-context-uri
                               (get value "semanticContext"))
                            (string? (get value "semanticSource"))
                            (string? (get value "semanticGraphDigest"))))
                   (cond (or v7? v6?) (and (map? (get value "stateDataset"))
                                  (map? (get value "domainDataset"))
                                  (string? (get value "domainGraphDigest"))
                                  (string? (get value "stateOntologyDigest"))
                                  (= (local-state-ontology-source)
                                     (get value "stateOntologySource"))
                                  (string? (get value "domainOntologyDigest"))
                                  (= (local-domain-ontology-source)
                                     (get value "domainOntologySource"))
                                  (or (not v7?)
                                      (and (map? (get value "decisionOutputDataset"))
                                           (string? (get value "decisionOutputGraphDigest"))
                                           (string? (get value "decisionOntologyDigest"))
                                           (= (local-decision-ontology-source)
                                              (get value "decisionOntologySource")))))
                         v5? (and (map? (get value "stateDataset"))
                                  (string? (get value "stateOntologySource"))
                                  (string? (get value "stateOntologyDigest"))
                                  (= (local-state-ontology-source)
                                     (get value "stateOntologySource")))
                         v4? (map? (get value "stateDataset"))
                         v3? (map? (get value "stateNode"))
                         :else (string? (get value "stateEdn")))
                   (vector? (get value "parents"))
                   (every? ipld/link? (get value "parents")))
      (refuse! :invalid-node))
    (let [parents (mapv ipld/link-cid (get value "parents"))
          _ (valid-parents! parents)
          state (cond (or v7? v6? v5? v4?)
                      (state-rdf/decode-packed! (get value "stateDataset"))
                      v3? (state-node/decode-canonical! (get value "stateNode"))
                      :else (try (reader/read-string (get value "stateEdn"))
                                 (catch #?(:cljs :default :clj Exception) _
                                   (refuse! :invalid-state-edn))))
          expected (cond v7? (let [domain-dataset
                                      (domain-rdf/unpack-quads!
                                       (get value "domainDataset"))
                                  _ (when-not (= (get value "domainGraphDigest")
                                                 (domain-rdf/graph-digest domain-dataset))
                                      (refuse! :domain-graph-digest-mismatch))
                                  decision-dataset
                                      (domain-rdf/unpack-quads!
                                       (get value "decisionOutputDataset"))]
                                  (when-not (= (get value "decisionOutputGraphDigest")
                                               (domain-rdf/graph-digest decision-dataset))
                                    (refuse! :decision-graph-digest-mismatch))
                                  (node-v7 schema state parents
                                           (get value "stateOntologySource")
                                           (get value "domainOntologySource")
                                           (get value "decisionOntologySource")))
                         v6? (let [domain-dataset
                                     (domain-rdf/unpack-quads!
                                      (get value "domainDataset"))]
                                 (when-not (= (get value "domainGraphDigest")
                                              (domain-rdf/graph-digest domain-dataset))
                                   (refuse! :domain-graph-digest-mismatch))
                                 (node-v6 schema state parents
                                          (get value "stateOntologySource")
                                          (get value "domainOntologySource")))
                         v5? (node-v5 schema state parents
                                      (get value "stateOntologySource"))
                         v4? (node-v4 schema state parents)
                         v3? (node-v3 schema state parents)
                         semantic? (node-v2 schema state parents)
                         :else (node-v1 schema state parents))]
      (when-not (= value expected) (refuse! :noncanonical-checkpoint))
      {:cid id :format version :parents parents :state state
       :source (get value "source")
       :graph-digest (get value "graphDigest")
       :semantic-source (get value "semanticSource")
       :semantic-graph-digest (get value "semanticGraphDigest")
       :domain-graph-digest (get value "domainGraphDigest")
       :decision-output-graph-digest (get value "decisionOutputGraphDigest")
       :decision-output-dataset (get value "decisionOutputDataset")
       :checkpoint-digest (get value "checkpointDigest")}))))

(defn put!
  "Store a checked block through the injected CID/bytes port. Parents must
  already resolve and share the exact run/profile/task binding."
  [put-fn get-fn schema state parents]
  (valid-parents! parents)
  (doseq [parent parents]
    (let [saved (:state (read! get-fn schema parent))]
      (when-not (and (= (:run-id saved) (:run-id state))
                     (= (:profile-digest saved) (:profile-digest state))
                     (= (checkpoint/task-identity saved)
                        (checkpoint/task-identity state))
                     (<= (:step saved) (:step state)))
        (refuse! :parent-binding-mismatch))
      (decision-proof/verify-transition! saved state)))
  (let [{:keys [cid bytes]} (block schema state parents)]
    (put-fn cid bytes)
    cid))

(defn- ancestor? [get-fn schema ancestor descendant]
  (loop [queue [descendant] seen #{}]
    (cond
      (empty? queue) false
      (> (count seen) 256) (refuse! :ancestry-limit)
      :else
      (let [current (first queue)
            remaining (subvec (vec queue) 1)]
        (cond
          (= ancestor current) true
          (contains? seen current) (recur remaining seen)
          :else (recur (into remaining (:parents (read! get-fn schema current)))
                       (conj seen current)))))))

(defn verify-history-nodes!
  "Verify every reachable IPLD block and return its checked nodes for this call.
  The returned map is invocation-local, never a persisted trust cache."
  [get-fn schema head]
  (loop [queue [head] checked {}]
    (cond
      (> (count checked) 256) (refuse! :ancestry-limit)
      (empty? queue)
      (do
        (doseq [[_ {:keys [parents] :as child}] checked
                parent parents]
          (let [prior (get checked parent)]
            (when-not (and prior
                           (= (:run-id prior) (:run-id child))
                           (= (:profile-digest prior) (:profile-digest child))
                           (= (:task-identity prior) (:task-identity child))
                           (<= (:step prior) (:step child)))
              (refuse! :invalid-ancestry))
            (decision-proof/verify-transition! (:state prior) (:state child))))
        {:head head :blocks (count checked)
         :nodes (into {} (map (fn [[id binding]] [id (:block binding)]) checked))})
      :else
      (let [current (first queue)
            remaining (subvec (vec queue) 1)]
        (if (contains? checked current)
          (recur remaining checked)
          (let [{:keys [state parents] :as block} (read! get-fn schema current)
                binding {:parents parents
                         :run-id (:run-id state)
                         :profile-digest (:profile-digest state)
                         :task-identity (checkpoint/task-identity state)
                         :step (:step state)
                         :state state
                         :block block}]
            (recur (into remaining parents) (assoc checked current binding))))))))

(defn verify-history!
  "Verify every reachable IPLD block and its checked semantic projection."
  [get-fn schema head]
  (dissoc (verify-history-nodes! get-fn schema head) :nodes))

(defn merge-facts!
  "Three-way merge of disjoint, additive facts over one immutable ancestor.
  Effects, receipts, steps, leases, policy and BPMN token must be identical;
  a workflow branch with divergent execution needs explicit reconciliation."
  [put-fn get-fn schema base-id left-id right-id]
  (when-not (and (ancestor? get-fn schema base-id left-id)
                 (ancestor? get-fn schema base-id right-id))
    (refuse! :not-common-ancestor))
  (let [base (:state (read! get-fn schema base-id))
        left (:state (read! get-fn schema left-id))
        right (:state (read! get-fn schema right-id))
        base-facts (:facts base)
        left-facts (:facts left)
        right-facts (:facts right)]
    (when-not (and (= :running (:status base) (:status left) (:status right))
                   (every? nil? (map :awaiting [base left right]))
                   (= (dissoc base :facts) (dissoc left :facts) (dissoc right :facts))
                   (set? base-facts) (set? left-facts) (set? right-facts)
                   (set/subset? base-facts left-facts)
                   (set/subset? base-facts right-facts))
      (refuse! :non-additive-or-effect-conflict))
    (put! put-fn get-fn schema
          (assoc base :facts (set/union left-facts right-facts))
          (vec (sort (distinct [left-id right-id]))))))
