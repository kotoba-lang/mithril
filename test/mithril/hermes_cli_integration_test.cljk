(ns mithril.hermes-cli-integration-test
  (:require [cljs.test :refer [deftest is]]
            [cljs.reader :as reader]
            [mithril.bot :as bot]
            [mithril.compiler :as compiler]
            [mithril.checkpoint :as checkpoint]
            [mithril.checkpoint-ipld :as checkpoint-ipld]
            [mithril.checkpoint-ipld-fs :as local]
            [mithril.execution :as execution]
            [mithril.hermes :as hermes]
            [mithril.ipld-session :as ipld-session]))

(def fs (js/require "node:fs"))
(def cp (js/require "node:child_process"))

(defn- exec! [cwd program & args]
  (.execFileSync cp program (clj->js args)
                 #js {:cwd cwd :encoding "utf8" :stdio #js ["ignore" "pipe" "pipe"]}))

(defn- terminal-fixture [dir]
  (let [task {:id "cli-task" :workspace dir :goal "Observe one terminal delivery"}
        artifact (bot/compile-text "examples/governed-coding-bot.mith"
                                   (.readFileSync fs "examples/governed-coding-bot.mith" "utf8"))]
    {:task task
     :state (assoc (bot/start-run artifact task "cli-test" 1000) :status :completed)}))

(defn- invoke-terminal! [task-path state-path]
  (.execFileSync
   cp "kbb"
   #js ["--backend" "sci" "bin/mithril-hermes.cljk" "tick"
        "examples/governed-coding-bot.mith" task-path state-path
        "cli-test" "workspace/read,git/status,agent/stop" "execute"]
   #js {:cwd (.cwd js/process) :encoding "utf8"
        :stdio #js ["ignore" "pipe" "pipe"]}))

(defn- invoke-migrate! [task-path state-path]
  (.execFileSync
   cp "kbb"
   #js ["--backend" "sci" "bin/mithril-hermes.cljk" "migrate"
        "examples/governed-coding-bot.mith" task-path state-path "cli-test"]
   #js {:cwd (.cwd js/process) :encoding "utf8"
        :stdio #js ["ignore" "pipe" "pipe"]}))

(defn- invoke-semantic-import [task-path state-path]
  (.spawnSync cp "kbb"
              #js ["--backend" "sci" "bin/mithril-hermes.cljk" "semantic-import"
                   "examples/governed-coding-bot.mith" task-path state-path "cli-test"]
              #js {:cwd (.cwd js/process) :encoding "utf8"}))

(defn- legacy-running-fixture [dir]
  (let [current-doc (compiler/parse-source
                     (.readFileSync fs "examples/governed-coding-bot.mith" "utf8"))
        old-artifact (bot/compile-document
                      "legacy.mith" (dissoc current-doc "process" "legacyProfiles"))
        task {:id "legacy-cli-task" :workspace dir :goal "Resume one legacy checkpoint"}]
    {:task task
     :state (-> (bot/start-run old-artifact task "cli-test" 1000)
                (assoc :profile-digest
                       "sha256:c53e7a4cddfee776084a68bd926924f1554d60cb0888f2000a5672ba2de5136d"
                       :facts #{:semantic/prefix-valid :workspace/inspected}
                       :step 1)
                (update-in [:policy :actions]
                           #(vec (remove #{"https://mithril.fund/id/action/patch-reset"} %)))
                (update-in [:policy :effects]
                           #(vec (remove #{:workspace/revert-patch} %))))}))

(deftest ipld-execute-journals-the-request-before-the-real-host-effect
  (let [dir (.mkdtempSync fs "/tmp/mithril-primary-cli-")
        workspace (str dir "/workspace")
        artifacts (str dir "/artifacts")
        task-path (str dir "/task.json")
        state-path (str dir "/state.edn")
        tools-path (str dir "/tools.json")]
    (try
      (.mkdirSync fs workspace)
      (.mkdirSync fs artifacts)
      (.writeFileSync fs (str workspace "/app.mith") "value 1\n" "utf8")
      (exec! workspace "/usr/bin/git" "init" "-q")
      (exec! workspace "/usr/bin/git" "add" "app.mith")
      (exec! workspace "/usr/bin/git" "-c" "user.name=Mithril Test"
             "-c" "user.email=mithril@example.invalid" "commit" "-qm" "base")
      (let [profile {:format hermes/tool-profile-format :workspace workspace
                     :artifact-dir artifacts :allowed-paths ["app.mith"]
                     :max-patch-bytes 8192 :max-context-bytes 8192
                     :proposer {:program "/bin/echo" :profile "fixture" :timeout-ms 5000}
                     :tools {:amu/compile {:program "/usr/bin/git" :args ["diff" "--check"]
                                            :timeout-ms 5000}
                             :test/run {:program "/usr/bin/grep"
                                        :args ["-q" "value 1" "app.mith"]
                                        :timeout-ms 5000}}}
            task {:id "primary-cli" :workspace workspace :goal "Inspect workspace"
                  :tool-profile-digest (hermes/tool-profile-digest profile)}
            schema (checkpoint/schema (.readFileSync fs checkpoint/ontology-path "utf8"))
            store (local/open! (str dir "/ipld-checkpoints"))]
        (.writeFileSync fs task-path (.stringify js/JSON (clj->js task)) "utf8")
        (.writeFileSync fs tools-path
                        (.stringify js/JSON
                                    (clj->js (assoc profile :tools
                                                    {"amu/compile" (get-in profile [:tools :amu/compile])
                                                     "test/run" (get-in profile [:tools :test/run])})))
                        "utf8")
        (let [tick (.spawnSync cp "kbb"
                               #js ["--backend" "sci" "bin/mithril-hermes.cljk" "tick"
                                    "examples/governed-coding-bot.mith" task-path state-path
                                    "primary-cli" "workspace/read" "ipld-execute" tools-path]
                               #js {:cwd (.cwd js/process) :encoding "utf8"})
              result (when (= 0 (.-status tick))
                       (js->clj (js/JSON.parse (.-stdout tick)) :keywordize-keys true))
              current (when result (ipld-session/load! store schema state-path))]
          (is (= 0 (.-status tick)) (str (.-stdout tick) (.-stderr tick)))
          (when current
            (let [saved (checkpoint-ipld/read!
                         #(local/get-block store %) schema (:stateCid current))
                  parent (checkpoint-ipld/read!
                          #(local/get-block store %) schema (first (:parents saved)))]
              (is (= 2 (:blocks current)))
              (is (= (:state-cid result) (:stateCid current)))
              (is (= 1 (count (:parents saved))))
              (is (some? (get-in parent [:state :awaiting :id])))
              (is (nil? (get-in saved [:state :awaiting])))
              (is (= 1 (get-in saved [:state :step])))
              (.unlinkSync fs state-path)
              (is (= (:state saved) (:state (ipld-session/load! store schema state-path))))
              (is (.existsSync fs state-path))))))
      (finally (.rmSync fs dir #js {:recursive true :force true})))))

(deftest primary-reconcile-consumes-an-existing-proposal-without-proposing-again
  (let [dir (.mkdtempSync fs "/tmp/mithril-primary-reconcile-")
        workspace (str dir "/workspace")
        artifacts (str dir "/artifacts")
        task-path (str dir "/task.json")
        state-path (str dir "/state.edn")
        tools-path (str dir "/tools.json")]
    (try
      (.mkdirSync fs workspace)
      (.mkdirSync fs artifacts)
      (.writeFileSync fs (str workspace "/app.mith") "value 1\n" "utf8")
      (exec! workspace "/usr/bin/git" "init" "-q")
      (exec! workspace "/usr/bin/git" "add" "app.mith")
      (exec! workspace "/usr/bin/git" "-c" "user.name=Mithril Test"
             "-c" "user.email=mithril@example.invalid" "commit" "-qm" "base")
      (let [profile {:format hermes/tool-profile-format :workspace workspace
                     :artifact-dir artifacts :allowed-paths ["app.mith"]
                     :max-patch-bytes 8192 :max-context-bytes 8192
                     :proposer {:program "/bin/echo" :profile "fixture" :timeout-ms 5000}
                     :tools {:amu/compile {:program "/usr/bin/git" :args ["diff" "--check"]
                                            :timeout-ms 5000}
                             :test/run {:program "/usr/bin/grep"
                                        :args ["-q" "value 2" "app.mith"]
                                        :timeout-ms 5000}}}
            task {:id "reconcile-cli" :workspace workspace :goal "Review a fixed patch"
                  :tool-profile-digest (hermes/tool-profile-digest profile)}
            artifact (bot/compile-text "examples/governed-coding-bot.mith"
                                       (.readFileSync fs "examples/governed-coding-bot.mith" "utf8"))
            s0 (bot/start-run artifact task "reconcile-cli" 1000)
            read-request (bot/request-effect
                          s0 {:action (get bot/action-by-label "workspace-inspect")
                              :confidence 10000}
                          #{:workspace/read} "reconcile-cli" 1001)
            s1 (bot/apply-receipt
                (:state read-request)
                {:format bot/receipt-format
                 :effect-id (get-in read-request [:effect :id])
                 :status :completed :output-digest (execution/digest :inspected)}
                "reconcile-cli" 1002)
            proposal-request (bot/request-effect
                              s1 {:action (get bot/action-by-label "code-propose")
                                  :confidence 10000}
                              #{:llm/propose-patch} "reconcile-cli" 1003)
            pending (:state proposal-request)
            effect (:effect proposal-request)
            store (local/open! (str dir "/ipld-checkpoints"))
            schema (checkpoint/schema (.readFileSync fs checkpoint/ontology-path "utf8"))
            initial (ipld-session/save! store schema state-path nil pending)
            patch (str "diff --git a/app.mith b/app.mith\n"
                       "--- a/app.mith\n+++ b/app.mith\n"
                       "@@ -1 +1 @@\n-value 1\n+value 2\n")]
        (.writeFileSync fs task-path (.stringify js/JSON (clj->js task)) "utf8")
        (.writeFileSync fs tools-path
                        (.stringify js/JSON
                                    (clj->js (assoc profile :tools
                                                    {"amu/compile" (get-in profile [:tools :amu/compile])
                                                     "test/run" (get-in profile [:tools :test/run])})))
                        "utf8")
        (is (= :completed
               (get-in (hermes/execute-effect effect
                                              {:profile profile
                                               :propose-fn (fn [_] patch)})
                       [:receipt :status])))
        (let [reconciled (.spawnSync cp "kbb"
                                     #js ["--backend" "sci" "bin/mithril-hermes.cljk"
                                          "reconcile" "examples/governed-coding-bot.mith"
                                          task-path state-path "reconcile-cli" tools-path]
                                     #js {:cwd (.cwd js/process) :encoding "utf8"})
              result (when (= 0 (.-status reconciled))
                       (js->clj (js/JSON.parse (.-stdout reconciled))
                                :keywordize-keys true))
              current (ipld-session/load! store schema state-path)]
          (is (= 0 (.-status reconciled))
              (str (.-stdout reconciled) (.-stderr reconciled)))
          (is (= 2 (:blocks current)))
          (is (not= (:stateCid initial) (:stateCid current)))
          (is (= (:state-cid result) (:stateCid current)))
          (is (nil? (get-in current [:state :awaiting])))
          (is (= "value 1\n" (.readFileSync fs (str workspace "/app.mith") "utf8"))
              "reconciliation must not apply or regenerate the proposal")))
      (finally (.rmSync fs dir #js {:recursive true :force true})))))

(deftest semantic-execute-persists-and-verifies-one-real-host-effect
  (let [dir (.mkdtempSync fs "/tmp/mithril-semantic-cli-")
        workspace (str dir "/workspace")
        artifacts (str dir "/artifacts")
        task-path (str dir "/task.json")
        state-path (str dir "/state.edn")
        tools-path (str dir "/tools.json")
        profile-path "examples/governed-coding-bot.mith"
        invoke (fn []
                 (.spawnSync cp "kbb"
                             #js ["--backend" "sci" "bin/mithril-hermes.cljk" "tick"
                                  profile-path task-path state-path "semantic-test"
                                  "workspace/read,git/status,agent/stop"
                                  "semantic-execute" tools-path]
                             #js {:cwd (.cwd js/process) :encoding "utf8"}))
        verify (fn []
                 (.spawnSync cp "kbb"
                             #js ["--backend" "sci" "bin/mithril-hermes.cljk"
                                  "semantic-verify" state-path]
                             #js {:cwd (.cwd js/process) :encoding "utf8"}))]
    (try
      (.mkdirSync fs workspace)
      (.mkdirSync fs artifacts)
      (.writeFileSync fs (str workspace "/app.mith") "value 1\n" "utf8")
      (exec! workspace "/usr/bin/git" "init" "-q")
      (exec! workspace "/usr/bin/git" "add" "app.mith")
      (exec! workspace "/usr/bin/git" "-c" "user.name=Mithril Test"
             "-c" "user.email=mithril@example.invalid" "commit" "-qm" "base")
      (let [profile {:format hermes/tool-profile-format :workspace workspace
                     :artifact-dir artifacts :allowed-paths ["app.mith"]
                     :max-patch-bytes 8192 :max-context-bytes 8192
                     :proposer {:program "/bin/echo" :profile "fixture" :timeout-ms 5000}
                     :tools {:amu/compile {:program "/usr/bin/git" :args ["diff" "--check"]
                                            :timeout-ms 5000}
                             :test/run {:program "/usr/bin/grep" :args ["-q" "value 1" "app.mith"]
                                        :timeout-ms 5000}}}
            task {:id "semantic-cli" :workspace workspace :goal "Inspect workspace"
                  :tool-profile-digest (hermes/tool-profile-digest profile)}]
        (.writeFileSync fs task-path (.stringify js/JSON (clj->js task)) "utf8")
        (.writeFileSync fs tools-path
                        (.stringify js/JSON
                                    (clj->js (assoc profile :tools
                                                    {"amu/compile" (get-in profile [:tools :amu/compile])
                                                     "test/run" (get-in profile [:tools :test/run])})))
                        "utf8")
        (let [result (invoke)]
          (is (= 0 (.-status result)) (str (.-stdout result) (.-stderr result)))
          (is (.existsSync fs (str state-path ".semantic-head")))
          (let [head (.trim (.readFileSync fs (str state-path ".semantic-head") "utf8"))
                block-file (str state-path ".semantic-blocks/" (subs head 7))
                block (reader/read-string (.readFileSync fs block-file "utf8"))
                checked (checkpoint/verify
                         (checkpoint/schema (.readFileSync fs checkpoint/ontology-path "utf8"))
                         {:digest head :block block})]
            (is (= head (:digest checked)))
            (is (= 1 (get-in block [:state :step])))
            (is (string? (get-in block [:source])))
            (is (string? (get-in block [:parent-digest])))
            (is (= "completed" (get (js->clj (js/JSON.parse (.-stdout result)))
                                     "status"))))
          (is (= 0 (.-status (verify))))
          (let [result2 (invoke)]
            (is (not= 0 (.-status result2)))
            (is (clojure.string/includes? (.-stdout result2) "Governor did not grant"))
            (is (.existsSync fs (str state-path ".semantic-head"))))
          (.writeFileSync fs state-path "{:tampered true}" "utf8")
          (let [rejected (invoke)]
            (is (not= 0 (.-status rejected)))
            (is (clojure.string/includes? (.-stdout rejected) "state-diverged")))
          (let [rejected (verify)]
            (is (not= 0 (.-status rejected)))
            (is (clojure.string/includes? (.-stdout rejected) "state-diverged")))
          (let [restored (.spawnSync cp "kbb"
                                     #js ["--backend" "sci" "bin/mithril-hermes.cljk"
                                          "semantic-restore" state-path]
                                     #js {:cwd (.cwd js/process) :encoding "utf8"})
                head (.trim (.readFileSync fs (str state-path ".semantic-head") "utf8"))
                block (reader/read-string
                       (.readFileSync fs (str state-path ".semantic-blocks/" (subs head 7))
                                        "utf8"))]
            (is (= 0 (.-status restored)) (str (.-stdout restored) (.-stderr restored)))
            (is (= (:state block) (reader/read-string (.readFileSync fs state-path "utf8"))))
            (is (= 0 (.-status (verify)))))))
      (finally (.rmSync fs dir #js {:recursive true :force true})))))

(deftest explicit-semantic-import-preserves-terminal-and-inflight-semantics
  (let [dir (.mkdtempSync fs "/tmp/mithril-semantic-import-")
        {:keys [task state]} (terminal-fixture dir)
        task-path (str dir "/task.json")
        state-path (str dir "/state.edn")
        tick (fn []
               (.spawnSync cp "kbb"
                           #js ["--backend" "sci" "bin/mithril-hermes.cljk" "tick"
                                "examples/governed-coding-bot.mith" task-path state-path
                                "cli-test" "workspace/read,git/status,agent/stop"
                                "semantic-execute"]
                           #js {:cwd (.cwd js/process) :encoding "utf8"}))]
    (try
      (.writeFileSync fs task-path (.stringify js/JSON (clj->js task)) "utf8")
      (.writeFileSync fs state-path (pr-str state) "utf8")
      (let [before (tick)]
        (is (not= 0 (.-status before)))
        (is (clojure.string/includes? (.-stdout before) "legacy-state")))
      (let [imported (invoke-semantic-import task-path state-path)]
        (is (= 0 (.-status imported)) (str (.-stdout imported) (.-stderr imported)))
        (is (.existsSync fs (str state-path ".semantic-head"))))
      (let [again (invoke-semantic-import task-path state-path)
            terminal (tick)]
        (is (not= 0 (.-status again)))
        (is (clojure.string/includes? (.-stdout again) "already-imported"))
        (is (= 0 (.-status terminal)) (str (.-stdout terminal) (.-stderr terminal)))
        (is (clojure.string/includes? (.-stdout terminal) "idempotent-terminal")))
      (let [workspace (str dir "/workspace")
            artifacts (str dir "/artifacts")
            tools-path (str dir "/tools.json")]
        (.mkdirSync fs workspace)
        (.mkdirSync fs artifacts)
        (.writeFileSync fs (str workspace "/app.mith") "value 1\n" "utf8")
        (exec! workspace "/usr/bin/git" "init" "-q")
        (exec! workspace "/usr/bin/git" "add" "app.mith")
        (exec! workspace "/usr/bin/git" "-c" "user.name=Mithril Test"
               "-c" "user.email=mithril@example.invalid" "commit" "-qm" "base")
        (let [profile {:format hermes/tool-profile-format :workspace workspace
                       :artifact-dir artifacts :allowed-paths ["app.mith"]
                       :max-patch-bytes 8192 :max-context-bytes 8192
                       :proposer {:program "/bin/echo" :profile "fixture" :timeout-ms 5000}
                       :tools {:amu/compile {:program "/usr/bin/git" :args ["diff" "--check"]
                                              :timeout-ms 5000}
                               :test/run {:program "/usr/bin/grep" :args ["-q" "value 1" "app.mith"]
                                          :timeout-ms 5000}}}
              next-task {:id "next-task" :workspace workspace :goal "Inspect next task"
                         :tool-profile-digest (hermes/tool-profile-digest profile)}
              old-head (.trim (.readFileSync fs (str state-path ".semantic-head") "utf8"))]
          (.writeFileSync fs task-path (.stringify js/JSON (clj->js next-task)) "utf8")
          (.writeFileSync fs tools-path
                          (.stringify js/JSON
                                      (clj->js (assoc profile :tools
                                                      {"amu/compile" (get-in profile [:tools :amu/compile])
                                                       "test/run" (get-in profile [:tools :test/run])})))
                          "utf8")
          (let [next-run (.spawnSync cp "kbb"
                                     #js ["--backend" "sci" "bin/mithril-hermes.cljk" "tick"
                                          "examples/governed-coding-bot.mith" task-path state-path
                                          "cli-test" "workspace/read" "semantic-execute" tools-path]
                                     #js {:cwd (.cwd js/process) :encoding "utf8"})
                new-head (.trim (.readFileSync fs (str state-path ".semantic-head") "utf8"))
                block (reader/read-string
                       (.readFileSync fs (str state-path ".semantic-blocks/" (subs new-head 7))
                                        "utf8"))]
            (is (= 0 (.-status next-run)) (str (.-stdout next-run) (.-stderr next-run)))
            (is (not= old-head new-head))
            (let [parent-id (:parent-digest block)
                  parent (reader/read-string
                          (.readFileSync fs
                                         (str state-path ".semantic-blocks/" (subs parent-id 7))
                                         "utf8"))]
              (is (= old-head (:parent-digest parent))))
            (is (= 1 (get-in block [:state :step]))))))
      (finally (.rmSync fs dir #js {:recursive true :force true})))))

(deftest imported-inflight-effect-cannot-be-reexecuted
  (let [dir (.mkdtempSync fs "/tmp/mithril-semantic-inflight-")
        task {:id "inflight" :workspace dir :goal "Inspect one workspace"}
        task-path (str dir "/task.json")
        state-path (str dir "/state.edn")
        artifact (bot/compile-text "examples/governed-coding-bot.mith"
                                   (.readFileSync fs "examples/governed-coding-bot.mith" "utf8"))
        initial (bot/start-run artifact task "cli-test" 1000)
        pending (:state (bot/request-effect
                         initial {:action (get bot/action-by-label "workspace-inspect")
                                  :confidence 10000}
                         #{:workspace/read} "cli-test" 1001))]
    (try
      (.writeFileSync fs task-path (.stringify js/JSON (clj->js task)) "utf8")
      (.writeFileSync fs state-path (pr-str pending) "utf8")
      (let [imported (invoke-semantic-import task-path state-path)]
        (is (= 0 (.-status imported)) (str (.-stdout imported) (.-stderr imported))))
      (let [head (.readFileSync fs (str state-path ".semantic-head") "utf8")
            tick (.spawnSync cp "kbb"
                             #js ["--backend" "sci" "bin/mithril-hermes.cljk" "tick"
                                  "examples/governed-coding-bot.mith" task-path state-path
                                  "cli-test" "workspace/read" "semantic-execute"]
                             #js {:cwd (.cwd js/process) :encoding "utf8"})]
        (is (not= 0 (.-status tick)))
        (is (clojure.string/includes? (.-stdout tick) "effect-in-flight"))
        (is (= head (.readFileSync fs (str state-path ".semantic-head") "utf8")))
        (is (= pending (reader/read-string (.readFileSync fs state-path "utf8")))))
      (finally (.rmSync fs dir #js {:recursive true :force true})))))

(deftest terminal-redelivery-crosses-the-real-cli-boundary
  (let [dir (.mkdtempSync fs "/tmp/mithril-cli-test-")
        {:keys [task state]} (terminal-fixture dir)
        task-path (str dir "/task.json")
        state-path (str dir "/state.edn")]
    (try
      (.writeFileSync fs task-path (.stringify js/JSON (clj->js task)) "utf8")
      (.writeFileSync fs state-path (pr-str state) "utf8")
      (let [before (.readFileSync fs state-path "utf8")
            output (invoke-terminal! task-path state-path)
            result (js->clj (js/JSON.parse output) :keywordize-keys true)
            audit-lines (-> (.readFileSync fs (str state-path ".audit.jsonl") "utf8")
                            (.trim)
                            (.split "\n"))]
        (is (= "idempotent-terminal" (:status result)))
        (is (= "completed" (:run-status result)))
        (is (= before (.readFileSync fs state-path "utf8"))
            "terminal delivery must not rewrite the durable checkpoint")
        (is (= 1 (alength audit-lines))
            "the CLI must record exactly one delivery receipt"))
      (finally
        (.rmSync fs dir #js {:recursive true :force true})))))

(deftest dead-owner-lock-is-recovered-and-audited
  (let [dir (.mkdtempSync fs "/tmp/mithril-cli-lock-test-")
        {:keys [task state]} (terminal-fixture dir)
        task-path (str dir "/task.json")
        state-path (str dir "/state.edn")
        lock-path (str state-path ".lock")]
    (try
      (.writeFileSync fs task-path (.stringify js/JSON (clj->js task)) "utf8")
      (.writeFileSync fs state-path (pr-str state) "utf8")
      (.writeFileSync fs lock-path "99999999" "utf8")
      (let [result (js->clj (js/JSON.parse (invoke-terminal! task-path state-path))
                            :keywordize-keys true)
            audits (->> (-> (.readFileSync fs (str state-path ".audit.jsonl") "utf8")
                            (.trim)
                            (.split "\n"))
                        (map #(js->clj (js/JSON.parse %) :keywordize-keys true)))]
        (is (= "idempotent-terminal" (:status result)))
        (is (= ["stale-lock-recovered" "idempotent-terminal"]
               (mapv :status audits)))
        (is (false? (.existsSync fs lock-path))
            "the recovered tick must release its replacement lock"))
      (finally
        (.rmSync fs dir #js {:recursive true :force true})))))

(deftest legacy-migration-crosses-the-real-cli-boundary-and-is-idempotent
  (let [dir (.mkdtempSync fs "/tmp/mithril-cli-migrate-test-")
        {:keys [task state]} (legacy-running-fixture dir)
        task-path (str dir "/task.json")
        state-path (str dir "/state.edn")]
    (try
      (.writeFileSync fs task-path (.stringify js/JSON (clj->js task)) "utf8")
      (.writeFileSync fs state-path (pr-str state) "utf8")
      (let [first-result (js->clj (js/JSON.parse (invoke-migrate! task-path state-path))
                                  :keywordize-keys true)
            migrated (reader/read-string (.readFileSync fs state-path "utf8"))
            persisted (.readFileSync fs state-path "utf8")
            second-result (js->clj (js/JSON.parse (invoke-migrate! task-path state-path))
                                   :keywordize-keys true)
            audits (->> (-> (.readFileSync fs (str state-path ".audit.jsonl") "utf8")
                            (.trim)
                            (.split "\n"))
                        (map #(js->clj (js/JSON.parse %) :keywordize-keys true)))]
        (is (= "checkpoint-migrated" (:status first-result)))
        (is (= "already-current" (:status second-result)))
        (is (= "https://mithril.fund/state/bot-run-v2" (:format migrated)))
        (is (= ["code-propose" "git-status" "stop"]
               (mapv :label (bot/available-actions migrated))))
        (is (= persisted (.readFileSync fs state-path "utf8"))
            "an already-current checkpoint is not rewritten")
        (is (= ["checkpoint-migrated"] (mapv :status audits))))
      (finally
        (.rmSync fs dir #js {:recursive true :force true})))))

(deftest applied-write-is-reconciled-from-an-inflight-checkpoint-without-reexecution
  (doseq [semantic? [false true]]
  (let [dir (.mkdtempSync fs "/tmp/mithril-cli-reconcile-")
        workspace (str dir "/workspace")
        artifacts (str dir "/artifacts")
        task-path (str dir "/task.json")
        state-path (str dir "/state.edn")
        tools-path (str dir "/tools.json")
        profile-path "examples/governed-coding-bot.mith"
        owner "reconcile-test"]
    (try
      (.mkdirSync fs workspace)
      (.mkdirSync fs artifacts)
      (.writeFileSync fs (str workspace "/app.mith") "value 1\n" "utf8")
      (exec! workspace "/usr/bin/git" "init" "-q")
      (exec! workspace "/usr/bin/git" "add" "app.mith")
      (exec! workspace "/usr/bin/git" "-c" "user.name=Mithril Test"
             "-c" "user.email=mithril@example.invalid" "commit" "-qm" "base")
      (let [profile {:format hermes/tool-profile-format :workspace workspace
                     :artifact-dir artifacts :allowed-paths ["app.mith"]
                     :max-patch-bytes 8192 :max-context-bytes 8192
                     :proposer {:program "/bin/echo" :profile "fixture" :timeout-ms 5000}
                     :tools {:amu/compile {:program "/usr/bin/git" :args ["diff" "--check"]
                                            :timeout-ms 5000}
                             :test/run {:program "/usr/bin/grep" :args ["-q" "value 2" "app.mith"]
                                        :timeout-ms 5000}}}
            task {:id "reconcile-task" :workspace workspace :goal "one bounded patch"
                  :tool-profile-digest (hermes/tool-profile-digest profile)}
            artifact (bot/compile-text profile-path (.readFileSync fs profile-path "utf8"))
            receipt (fn [effect]
                      {:format bot/receipt-format :effect-id (:id effect)
                       :status :completed :output-digest (execution/digest {:fixture true})})
            advance (fn [state label t]
                      (let [action (get bot/action-by-label label)
                            {:keys [state effect]} (bot/request-effect state
                                                                       {:action action :confidence 10000}
                                                                       #{(:effect action)} owner t)]
                        (bot/apply-receipt state (receipt effect) owner (inc t))))
            initial (bot/start-run artifact task owner 1000)
            after-inspect (advance initial "workspace-inspect" 1001)
            after-propose (advance after-inspect "code-propose" 1003)
            {:keys [state effect]} (bot/request-effect
                                    after-propose
                                    {:action (get bot/action-by-label "patch-apply")
                                     :confidence 10000}
                                    #{:workspace/apply-patch} owner 1005)
            patch (str "diff --git a/app.mith b/app.mith\n"
                       "index d00491f..0cfbf08 100644\n"
                       "--- a/app.mith\n+++ b/app.mith\n"
                       "@@ -1 +1 @@\n-value 1\n+value 2\n")
            stem (str artifacts "/" (clojure.string/replace (:run-id effect) ":" "_"))
            proposal {:format hermes/proposal-format :run-id (:run-id effect)
                      :base-head (clojure.string/trim (exec! workspace "/usr/bin/git" "rev-parse" "HEAD"))
                      :profile-digest (hermes/tool-profile-digest profile)
                      :patch-digest (execution/digest patch) :patch patch}]
        (.writeFileSync fs (str stem ".proposal.edn") (pr-str proposal) "utf8")
        (.writeFileSync fs (str stem ".proposal.edn.patch") patch "utf8")
        (.mkdirSync fs (str stem ".workspace"))
        (.writeFileSync fs (str stem ".workspace/app.mith") "value 2\n" "utf8")
        (exec! workspace "/usr/bin/git" "apply" "--" (str stem ".proposal.edn.patch"))
        (.writeFileSync fs task-path (.stringify js/JSON (clj->js task)) "utf8")
        (.writeFileSync fs tools-path
                        (.stringify js/JSON
                                    (clj->js (assoc profile :tools
                                                    {"amu/compile" (get-in profile [:tools :amu/compile])
                                                     "test/run" (get-in profile [:tools :test/run])})))
                        "utf8")
        (.writeFileSync fs state-path (pr-str state) "utf8")
        (when semantic?
          (let [imported (.spawnSync cp "kbb"
                                      #js ["--backend" "sci" "bin/mithril-hermes.cljk"
                                           "semantic-import" profile-path task-path state-path owner]
                                      #js {:cwd (.cwd js/process) :encoding "utf8"})]
            (is (= 0 (.-status imported)) (str (.-stdout imported) (.-stderr imported)))))
        (let [before (.readFileSync fs (str workspace "/app.mith") "utf8")
              pending (.readFileSync fs state-path "utf8")
              head-before (when semantic?
                            (.trim (.readFileSync fs (str state-path ".semantic-head") "utf8")))
              blocked (.spawnSync cp "kbb"
                                     #js ["--backend" "sci" "bin/mithril-hermes.cljk" "tick"
                                          profile-path task-path state-path owner
                                          "workspace/apply-patch"
                                          (if semantic? "semantic-execute" "execute") tools-path]
                                     #js {:cwd (.cwd js/process) :encoding "utf8"})
              _ (is (not= 0 (.-status blocked)))
              _ (is (clojure.string/includes? (.-stdout blocked) "effect-in-flight"))
              _ (is (= pending (.readFileSync fs state-path "utf8")))
              output (try
                       (.execFileSync cp "kbb"
                                      #js ["--backend" "sci" "bin/mithril-hermes.cljk" "reconcile"
                                           profile-path task-path state-path owner tools-path]
                                      #js {:cwd (.cwd js/process) :encoding "utf8"
                                           :stdio #js ["ignore" "pipe" "pipe"]})
                       (catch :default error
                         (throw (ex-info (str "reconcile refused: " (.-stdout error)) {}))))
              result (js->clj (js/JSON.parse output) :keywordize-keys true)
              saved (reader/read-string (.readFileSync fs state-path "utf8"))]
          (is (= "reconciled" (:status result)))
          (is (= (:id effect) (:effect-id result)))
          (is (= 3 (:step saved)))
          (is (nil? (:awaiting saved)))
          (is (= :completed (get-in saved [:receipts 2 :status])))
          (is (= before (.readFileSync fs (str workspace "/app.mith") "utf8")))
          (when semantic?
            (let [head-after (.trim (.readFileSync fs (str state-path ".semantic-head") "utf8"))
                  block (reader/read-string
                         (.readFileSync fs
                                        (str state-path ".semantic-blocks/" (subs head-after 7))
                                        "utf8"))]
              (is (not= head-before head-after))
              (is (= head-before (:parent-digest block)))
              (is (= 3 (get-in block [:state :step])))))
          (let [persisted (.readFileSync fs state-path "utf8")
                duplicate (.spawnSync cp "kbb"
                                      #js ["--backend" "sci" "bin/mithril-hermes.cljk" "reconcile"
                                           profile-path task-path state-path owner tools-path]
                                      #js {:cwd (.cwd js/process) :encoding "utf8"})]
            (is (not= 0 (.-status duplicate)))
            (is (clojure.string/includes? (.-stdout duplicate) "no-inflight-effect"))
            (is (= persisted (.readFileSync fs state-path "utf8"))))))
      (finally
        (.rmSync fs dir #js {:recursive true :force true}))))))
