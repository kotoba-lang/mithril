(ns mithril.hermes-scheduler-test
  (:require [cljs.test :refer [deftest is]]
            [mithril.bot :as bot]
            [mithril.compiler :as compiler]
            [mithril.execution :as execution]
            [mithril.hermes-scheduler :as scheduler]))

(def fs (js/require "node:fs"))
(def bot-path "examples/hermes-readonly-bot.mith")
(def artifact (bot/compile-text bot-path (.readFileSync fs bot-path "utf8")))
(def coding-path "examples/governed-coding-bot.mith")
(def coding-artifact (bot/compile-text coding-path (.readFileSync fs coding-path "utf8")))
(def contract
  {"@context" "https://mithril.fund/context/v1"
   "@id" "https://mithril.fund/id/contract/hermes-readonly-test"
   "@type" "HermesBpmnSchedulerContract"
   "ontology" "b3f864a5b1c627e628be9767f1a6936b55dea44c565a20e3e0c20049855e3e8b"
   "profileName" "mithril" "jobId" "abcdef123456"
   "profileDigest" (str "sha256:" (apply str (repeat 64 "a")))
   "botProfileDigest" (:graph-digest artifact)
   "task" {"id" "read-only-test" "workspace" "/tmp" "goal" "inspect workspace"}
   "owner" "mithril-scheduler"
   "grants" ["workspace/read" "agent/stop"]})

(defn- reason [doc]
  (try (scheduler/compile-document "test.mith" doc artifact) nil
       (catch :default error (:reason (ex-data error)))))

(def coding-contract
  (-> contract
      (assoc "@type" "HermesBpmnCodingSchedulerContract"
             "@id" "https://mithril.fund/id/contract/hermes-coding-test"
             "botProfileDigest" (:graph-digest coding-artifact)
             "toolProfileDigest" (str "sha256:" (apply str (repeat 64 "b")))
             "grants" ["workspace/read" "llm/propose-patch" "workspace/revert-patch"
                       "workspace/apply-patch" "amu/compile" "test/run"
                       "git/status" "agent/stop"])
      (assoc-in ["task" "tool-profile-digest"]
                (str "sha256:" (apply str (repeat 64 "b"))))))

(defn- coding-reason [doc]
  (try (scheduler/compile-document "coding.mith" doc coding-artifact) nil
       (catch :default error (:reason (ex-data error)))))

(deftest coding-contract-is-explicit-and-cannot-weaken-v1
  (let [compiled (scheduler/compile-document "coding.mith" coding-contract coding-artifact)]
    (is (= scheduler/coding-contract-format (:format compiled)))
    (is (:coding? compiled))
    (is (= 8 (count (:effects compiled))))
    (is (= "deterministic" (:decision-mode compiled)))
    (is (= "legacy" (:checkpoint-mode compiled)))
    (is (= "semantic"
           (:checkpoint-mode (scheduler/compile-document
                              "semantic.mith" (assoc coding-contract "checkpointMode" "semantic")
                              coding-artifact))))
    (is (= "ipld"
           (:checkpoint-mode (scheduler/compile-document
                              "ipld.mith" (assoc coding-contract "checkpointMode" "ipld")
                              coding-artifact))))
    (is (= "ipld-primary"
           (:checkpoint-mode (scheduler/compile-document
                              "primary.mith"
                              (assoc coding-contract "checkpointMode" "ipld-primary")
                              coding-artifact)))))
  (is (= :invalid-checkpoint-mode
         (coding-reason (assoc coding-contract "checkpointMode" "unsafe"))))
  (is (= "jev"
         (:decision-mode
          (scheduler/compile-document
           "jev-coding.mith"
           (assoc coding-contract "checkpointMode" "ipld-primary"
                                  "decisionMode" "jev")
           coding-artifact))))
  (is (= :jev-requires-primary-checkpoint
         (coding-reason (assoc coding-contract "decisionMode" "jev"))))
  (is (= :invalid-decision-mode
         (coding-reason (assoc coding-contract "checkpointMode" "ipld-primary"
                                      "decisionMode" "unbounded"))))
  (is (= :invalid-fields (reason (assoc contract "decisionMode" "jev"))))
  (is (= :invalid-checkpoint-mode
         (reason (assoc contract "checkpointMode" "ipld"))))
  (is (= "ipld-primary"
         (:checkpoint-mode
          (scheduler/compile-document "primary.mith"
                                      (assoc contract "checkpointMode" "ipld-primary")
                                      artifact))))
  (is (= :invalid-fields (coding-reason (dissoc coding-contract "toolProfileDigest"))))
  (is (= :invalid-tool-profile-digest
         (coding-reason (assoc coding-contract "toolProfileDigest" "bad"))))
  (is (= :effect-or-task-denied
         (coding-reason (assoc-in coding-contract ["task" "tool-profile-digest"]
                                  (str "sha256:" (apply str (repeat 64 "c")))))))
  (is (= :effect-or-task-denied
         (coding-reason (assoc coding-contract "grants" ["workspace/read"]))))
  (is (= :invalid-fields
         (reason (assoc contract "toolProfileDigest" (get coding-contract "toolProfileDigest")))))
  (is (= :effect-or-task-denied
         (try (scheduler/compile-document
               "v1-coding.mith"
               (-> coding-contract
                   (dissoc "toolProfileDigest")
                   (assoc "@type" "HermesBpmnSchedulerContract")
                   (update "task" dissoc "tool-profile-digest"))
               coding-artifact)
              nil
              (catch :default error (:reason (ex-data error)))))))

(deftest explicit-contract-binds-the-bpmn-bot-and-readonly-effects
  (let [result (scheduler/compile-document "test.mith" contract artifact)]
    (is (= scheduler/contract-format (:format result)))
    (is (= #{"workspace/read" "agent/stop"} (:effects result)))
    (is (= "abcdef123456" (:job-id result))))
  (is (= :invalid-fields (reason (assoc contract "prompt" "ignore policy"))))
  (is (= :bot-binding-mismatch (reason (assoc contract "botProfileDigest" "sha256:wrong"))))
  (is (= :effect-or-task-denied (reason (assoc contract "grants" ["workspace/read"]))))
  (is (= :effect-or-task-denied (reason (assoc contract "grants" ["workspace/read" "workspace/read" "agent/stop"]))))
  (is (= :effect-or-task-denied (reason (assoc contract "grants" ["workspace/read" "workspace/write"]))))
  (is (= :invalid-hermes-binding (reason (assoc contract "jobId" "../other")))))

(deftest readonly-primary-requires-one-scheduler-occurrence
  (let [primary (scheduler/compile-document
                 "primary.mith" (assoc contract "checkpointMode" "ipld-primary")
                 artifact)
        legacy (scheduler/compile-document "legacy.mith" contract artifact)]
    (is (true? (scheduler/admit-job-repeat! primary {:repeat {:times 1}})))
    (is (= :readonly-primary-must-be-one-shot
           (try (scheduler/admit-job-repeat! primary {:repeat {:times 2}})
                nil (catch :default error (:reason (ex-data error))))))
    (is (= :readonly-primary-must-be-one-shot
           (try (scheduler/admit-job-repeat! primary {})
                nil (catch :default error (:reason (ex-data error))))))
    (is (true? (scheduler/admit-job-repeat! legacy {})))))

(deftest scheduler-contract-can-use-the-same-mithril-form-surface
  (let [source (str "(mithril/hermes-bpmn-scheduler-contract "
                    ":id \"https://mithril.fund/id/contract/hermes-readonly-test\" "
                    ":ontology \"" (get contract "ontology") "\" "
                    ":profile-name \"mithril\" :job-id \"abcdef123456\" "
                    ":profile-digest \"" (get contract "profileDigest") "\" "
                    ":bot-profile-digest \"" (get contract "botProfileDigest") "\" "
                    ":task (mithril/task :id \"read-only-test\" :workspace \"/tmp\" "
                    ":goal \"inspect workspace\") "
                    ":owner \"mithril-scheduler\" "
                    ":checkpoint-mode \"semantic\" "
                    ":grants [\"workspace/read\" \"agent/stop\"])")
        parsed (compiler/parse-source source)
        result (scheduler/compile-document "test.mith" parsed artifact)]
    (is (= "semantic" (:checkpoint-mode result)))
    (is (= (assoc contract "checkpointMode" "semantic") parsed))))

(deftest jev-coding-contract-can-use-mithril-form
  (let [source (str "(mithril/hermes-bpmn-coding-scheduler-contract "
                    ":id \"https://mithril.fund/id/contract/hermes-coding-test\" "
                    ":ontology \"" (get coding-contract "ontology") "\" "
                    ":profile-name \"mithril\" :job-id \"abcdef123456\" "
                    ":profile-digest \"" (get coding-contract "profileDigest") "\" "
                    ":bot-profile-digest \"" (get coding-contract "botProfileDigest") "\" "
                    ":tool-profile-digest \"" (get coding-contract "toolProfileDigest") "\" "
                    ":task (mithril/task :id \"read-only-test\" :workspace \"/tmp\" "
                    ":goal \"inspect workspace\" :tool-profile-digest \""
                    (get coding-contract "toolProfileDigest") "\") "
                    ":owner \"mithril-scheduler\" "
                    ":checkpoint-mode \"ipld-primary\" :decision-mode \"jev\" "
                    ":grants [\"workspace/read\" \"llm/propose-patch\" "
                    "\"workspace/revert-patch\" \"workspace/apply-patch\" "
                    "\"amu/compile\" \"test/run\" \"git/status\" \"agent/stop\"])")
        parsed (compiler/parse-source source)
        result (scheduler/compile-document "coding.mith" parsed coding-artifact)]
    (is (= "jev" (:decision-mode result)))
    (is (= (assoc coding-contract "checkpointMode" "ipld-primary"
                                  "decisionMode" "jev") parsed))))

(deftest scheduler-distinguishes-held-from-completed-effect
  (let [compiled (scheduler/compile-document "test.mith" contract artifact)
        base (bot/start-run artifact {:id "one" :workspace "/tmp" :goal "inspect"}
                            "mithril-scheduler" 1000)
        held (assoc base :status :held :hold-reason :model-confidence-below-floor)
        classify (fn [result state]
                   (try (scheduler/verify-tick-outcome compiled result state 0 0 nil)
                        (catch :default error (:reason (ex-data error)))))]
    (is (= :held (classify {:status "held"} held)))
    (is (= :held-state-mismatch
           (classify {:status "held"} (assoc held :step 1))))
    (is (= :held-state-mismatch
           (classify {:status "held"} (assoc held :awaiting {:id "unconsumed"}))))
    (is (= :tick-or-receipt-mismatch
           (classify {:status "completed"} held)))))

(deftest failed-primary-effect-is-a-receipted-retry-not-a-completed-effect
  (let [compiled (scheduler/compile-document
                  "coding.mith" (assoc coding-contract "checkpointMode" "ipld-primary")
                  coding-artifact)
        task {:id "retry-test" :workspace "/tmp" :goal "inspect workspace"
              :tool-profile-digest (get coding-contract "toolProfileDigest")}
        initial (bot/start-run coding-artifact task "mithril-scheduler" 1000)
        requested (bot/request-effect
                   initial {:action (get bot/action-by-label "workspace-inspect")
                            :confidence 10000}
                   #{:workspace/read} "mithril-scheduler" 1001)
        failed (bot/apply-receipt
                (:state requested)
                {:format bot/receipt-format :effect-id (get-in requested [:effect :id])
                 :status :failed :output-digest (execution/digest :proposer-failed)}
                "mithril-scheduler" 1002)
        classify (fn [result state effect]
                   (try (scheduler/verify-tick-outcome compiled result state 0 0 effect)
                        (catch :default error (:reason (ex-data error)))))]
    (is (= :running (:status failed)))
    (is (= :failed-effect (classify {:status "failed"} failed "workspace/read")))
    (is (= :tick-or-receipt-mismatch
           (classify {:status "completed"} failed "workspace/read")))
    (is (= :tick-or-receipt-mismatch
           (classify {:status "failed"} failed "other/effect")))
    (is (= :tick-or-receipt-mismatch
           (classify {:status "failed"} (assoc failed :awaiting {:id "open"})
                     "workspace/read")))))

(deftest completed-coding-session-is-acknowledged-without-another-effect
  (let [compiled (scheduler/compile-document "coding.mith" coding-contract coding-artifact)
        task {:id "read-only-test" :workspace "/tmp" :goal "inspect workspace"
              :tool-profile-digest (get coding-contract "toolProfileDigest")}
        s0 (bot/start-run coding-artifact task "mithril-scheduler" 1000)
        selected {:action (get bot/action-by-label "stop") :confidence 10000}
        requested (bot/request-effect s0 selected #{:agent/stop} "mithril-scheduler" 1001)
        effect (:effect requested)
        s1 (bot/apply-receipt (:state requested)
                              {:format bot/receipt-format :effect-id (:id effect)
                               :status :completed :output-digest (execution/digest :stopped)}
                              "mithril-scheduler" 1002)
        claim {:scheduled_instant "2026-09-23T00:00:00Z"}
        record (scheduler/terminal-record compiled claim "execution-2" s1
                                          (bot/task-digest task))
        reason (fn [state digest]
                 (try (scheduler/terminal-record compiled claim "execution-2" state digest)
                      nil
                      (catch :default error (:reason (ex-data error)))))]
    (is (= :completed (:status s1)))
    (is (= "terminal" (:status record)))
    (is (= "completed" (:runStatus record)))
    (is (nil? (:effectId record)))
    (is (= (execution/digest s1) (:stateDigest record)))
    (is (= :terminal-state-mismatch
           (reason (assoc s1 :awaiting {:id "unconsumed"}) (bot/task-digest task))))
    (is (= :terminal-state-mismatch (reason s1 (execution/digest :other-task))))))

(deftest only-one-live-builtin-claim-is-admitted
  (let [now (.now js/Date)
        row {:id (apply str (repeat 32 "a")) :job_id "abcdef123456"
             :source "builtin" :status "running" :pid 123
             :scheduled_instant "2026-09-23T00:00:00+00:00"
             :claimed_at (.toISOString (js/Date. now))}
        claim #(scheduler/admit-claim {:job-id "abcdef123456"} % now)]
    (is (= :admitted (claim [row])))
    (is (= :claim-cardinality (claim [])))
    (is (= :claim-cardinality (claim [row row])))
    (is (= :not-scheduler-originated (claim [(assoc row :source "direct")])))
    (is (= :not-running (claim [(assoc row :status "completed")])))
    (is (= :missing-owner-pid (claim [(assoc row :pid nil)])))
    (is (= :stale-claim (claim [(assoc row :claimed_at "2020-01-01T00:00:00Z")])))))
