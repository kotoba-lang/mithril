(ns mithril.checkpoint-ipq-test
  (:require [cljs.test :refer [async deftest is]]
            [ipld.car :as car]
            [ipld.car.trustless :as trustless]
            [ipld.core :as ipld]
            [kotobase.protocols.ipq :as ipq]
            [mithril.bot :as bot]
            [mithril.checkpoint :as checkpoint]
            [mithril.checkpoint-ipq :as checkpoint-ipq]
            [mithril.checkpoint-ipld :as checkpoint-ipld]
            [mithril.checkpoint-ipld-fs :as local]))

(def fs (js/require "node:fs"))
(def path (js/require "node:path"))
(def os (js/require "node:os"))
(def http (js/require "node:http"))

(defn- schema []
  (checkpoint/schema (.readFileSync fs checkpoint/ontology-path "utf8")))

(defn- initial-state []
  (bot/start-run (bot/compile-text "examples/governed-coding-bot.mith"
                                   (.readFileSync fs "examples/governed-coding-bot.mith" "utf8"))
                 {:id "ipq-proof" :workspace "/tmp" :goal "transport checked facts"}
                 "ipq-proof" 1000))

(defn- reason [f]
  (try (f) nil
       (catch :default error
         (or (:reason (ex-data error)) (:type (ex-data error))))))

(deftest selector-reaches-the-published-block-boundary
  (let [chain (loop [remaining 32 parent nil blocks []]
                (if (zero? remaining)
                  blocks
                  (let [block (ipld/node->block
                               {"parents" (if parent [(ipld/link (:cid parent))] [])})]
                    (recur (dec remaining) block (conj blocks block)))))
        head (:cid (last chain))
        by-cid (into {} (map (juxt :cid :bytes)) chain)
        selected (trustless/selection-car #(get by-cid %) head
                                          checkpoint-ipq/history-selector
                                          checkpoint-ipq/limits)]
    (is (= 32 (count (:blocks selected))))))

(deftest checked-history-round-trips-through-trustless-car
  (let [directory (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-"))]
    (try
      (let [store (local/open! directory)
            checked-schema (schema)
            _ (local/import-state! store checked-schema "run" (initial-state))
            _ (local/advance-fact! store checked-schema "run" :review/approved)
            head (local/advance-fact! store checked-schema "run" :source/verified)
            exported (checkpoint-ipq/export-history! store checked-schema head)
            verified (checkpoint-ipq/verify-history-car!
                      checked-schema head (:bytes exported))
            decoded (car/decode (:bytes exported))
            blocks (mapv (fn [{:keys [cid]}]
                           {:cid cid :bytes (get (:blocks decoded) cid)})
                         (:entries decoded))
            truncated (:bytes (car/encode {:roots [head]
                                           :blocks (butlast blocks)}))
            altered (:bytes (car/encode {:roots [head]
                                         :blocks (cons (assoc (first blocks)
                                                              :bytes (:bytes (second blocks)))
                                                       (rest blocks))}))
            extra (:bytes (car/encode {:roots [head]
                                       :blocks (conj (vec blocks)
                                                     (ipld/node->block {"unreached" true}))}))]
        (is (= 3 (:blocks exported)))
        (is (= head (:root verified)))
        (is (= 3 (:blocks verified)))
        (is (contains? (get-in verified [:state :facts]) :source/verified))
        (is (= :ipld/car-root-mismatch
               (reason #(checkpoint-ipq/verify-history-car!
                         checked-schema (:cid (ipld/node->block {"other" true}))
                         (:bytes exported)))))
        (is (= :ipld/missing-block
               (reason #(checkpoint-ipq/verify-history-car!
                         checked-schema head truncated))))
        (is (= :ipld/cid-mismatch
               (reason #(checkpoint-ipq/verify-history-car!
                         checked-schema head altered))))
        (is (= :unused-car-blocks
               (reason #(checkpoint-ipq/verify-history-car!
                         checked-schema head extra))))
        (is (= :invalid-node
               (reason #(checkpoint-ipq/verify-history-car!
                         (assoc checked-schema :ontology-digest "sha256:changed")
                         head (:bytes exported)))))
        (is (= :history-over-ipq-limit
               (reason #(with-redefs [checkpoint-ipld/verify-history-nodes!
                                      (fn [& _] {:blocks 33})]
                          (checkpoint-ipq/export-history! store checked-schema head)))))
        (is (= :invalid-car-bytes
               (reason #(checkpoint-ipq/verify-history-car!
                         checked-schema head "not bytes"))))
        (is (= :car-over-limit
               (reason #(checkpoint-ipq/verify-history-car!
                         checked-schema head
                         (js/Uint8Array. (inc checkpoint-ipq/max-car-bytes)))))))
      (finally (.rmSync fs directory #js {:recursive true :force true})))))

(deftest imported-history-keeps-cids-and-supports-local-fork-and-merge
  (let [source-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-source-"))
        target-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-target-"))]
    (try
      (let [checked-schema (schema)
            source (local/open! source-dir)
            target (local/open! target-dir)
            _ (local/import-state! source checked-schema "source" (initial-state))
            source-head (local/advance-fact! source checked-schema "source"
                                             :source/verified)
            car-bytes (:bytes (checkpoint-ipq/export-history!
                               source checked-schema source-head))
            semantic-checks (atom 0)
            semantic-check checkpoint-ipld/verify-history-nodes!
            imported (with-redefs [checkpoint-ipld/verify-history-nodes!
                                   (fn [& args]
                                     (swap! semantic-checks inc)
                                     (apply semantic-check args))]
                       (checkpoint-ipq/import-history!
                        target checked-schema "received" source-head car-bytes))
            _ (local/fork-ref! target "received" "left")
            _ (local/fork-ref! target "received" "right")
            left (local/advance-fact! target checked-schema "left"
                                      :review/approved)
            right (local/advance-fact! target checked-schema "right"
                                       :source/independent)
            merged (local/merge-refs! target checked-schema
                                      "received" "left" "right" "merged")]
        (is (= source-head (:root imported)))
        (is (= 1 @semantic-checks))
        (is (= source-head (local/read-ref target "received")))
        (is (.equals (local/get-block source source-head)
                     (local/get-block target source-head)))
        (is (not= left right))
        (is (not= merged source-head))
        (is (= merged (:head (local/verify-ref! target checked-schema "merged"))))
        (is (= :ref-exists
               (reason #(checkpoint-ipq/import-history!
                         target checked-schema "received" source-head car-bytes))))
        (is (= :ipld/car-root-mismatch
               (reason #(checkpoint-ipq/import-history!
                         target checked-schema "invalid" left car-bytes))))
        (is (false? (local/ref-exists? target "invalid"))))
      (finally
        (.rmSync fs source-dir #js {:recursive true :force true})
        (.rmSync fs target-dir #js {:recursive true :force true})))))

(deftest import-refuses-disk-block-changed-after-car-verification
  (let [source-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-proof-source-"))
        target-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-proof-target-"))]
    (try
      (let [checked-schema (schema)
            source (local/open! source-dir)
            target (local/open! target-dir)
            head (local/import-state! source checked-schema "source" (initial-state))
            car-bytes (:bytes (checkpoint-ipq/export-history!
                               source checked-schema head))
            put-block! local/put-block!
            changed? (atom false)]
        (is (= :import-block-mismatch
               (reason #(with-redefs [local/put-block!
                                      (fn [store cid bytes]
                                        (let [result (put-block! store cid bytes)]
                                          (when (compare-and-set! changed? false true)
                                            (let [tampered (.from js/Buffer bytes)]
                                              (aset tampered 0 (bit-xor 1 (aget tampered 0)))
                                              (.writeFileSync fs
                                                              (.join path target-dir "blocks" cid)
                                                              tampered)))
                                          result))]
                          (checkpoint-ipq/import-history!
                           target checked-schema "invalid" head car-bytes)))))
        (is @changed?)
        (is (false? (local/ref-exists? target "invalid"))))
      (finally
        (.rmSync fs source-dir #js {:recursive true :force true})
        (.rmSync fs target-dir #js {:recursive true :force true})))))

(deftest exact-car-proof-cache-reuses-semantics-but-not-mutable-bytes
  (let [source-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-cache-source-"))
        first-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-cache-first-"))
        second-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-cache-second-"))
        rejected-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-cache-rejected-"))]
    (try
      (let [checked-schema (schema)
            source (local/open! source-dir)
            first-target (local/open! first-dir)
            second-target (local/open! second-dir)
            rejected-target (local/open! rejected-dir)
            head (local/import-state! source checked-schema "source" (initial-state))
            car-bytes (:bytes (checkpoint-ipq/export-history!
                               source checked-schema head))
            cache (checkpoint-ipq/verification-cache)
            semantic-checks (atom 0)
            semantic-check checkpoint-ipld/verify-history-nodes!]
        (with-redefs [checkpoint-ipld/verify-history-nodes!
                      (fn [& args]
                        (swap! semantic-checks inc)
                        (apply semantic-check args))]
          (let [first-proof (checkpoint-ipq/verify-history-car-cached!
                             cache checked-schema head car-bytes)
                original-byte (aget (get-in first-proof [:loaded 0 :bytes]) 0)]
            (aset (get-in first-proof [:loaded 0 :bytes]) 0
                  (bit-xor original-byte 1))
            (is (= original-byte
                   (aget (get-in (checkpoint-ipq/verify-history-car-cached!
                                  cache checked-schema head car-bytes)
                                 [:loaded 0 :bytes]) 0))))
          (is (= head (:root (checkpoint-ipq/import-history!
                             first-target checked-schema "received" head car-bytes cache))))
          (is (= head (:root (checkpoint-ipq/import-history!
                             second-target checked-schema "received" head car-bytes cache))))
          (is (= 1 @semantic-checks))
          (is (= head (local/read-ref second-target "received")))
          (let [altered (.from js/Buffer car-bytes)
                offset (dec (.-length altered))]
            (aset altered offset (bit-xor 1 (aget altered offset)))
            (is (= :ipld/cid-mismatch
                   (reason #(checkpoint-ipq/import-history!
                             rejected-target checked-schema "altered" head altered cache))))
            (is (false? (local/ref-exists? rejected-target "altered"))))
          (is (= :invalid-verification-cache
                 (reason #(checkpoint-ipq/verify-history-car-cached!
                           (js/Object.) checked-schema head car-bytes))))
          (let [put-block! local/put-block!
                changed? (atom false)]
            (is (= :import-block-mismatch
                   (reason #(with-redefs [local/put-block!
                                          (fn [store cid bytes]
                                            (let [result (put-block! store cid bytes)]
                                              (when (compare-and-set! changed? false true)
                                                (let [tampered (.from js/Buffer bytes)]
                                                  (aset tampered 0
                                                        (bit-xor 1 (aget tampered 0)))
                                                  (.writeFileSync fs
                                                                  (.join path rejected-dir
                                                                         "blocks" cid)
                                                                  tampered)))
                                              result))]
                              (checkpoint-ipq/import-history!
                               rejected-target checked-schema "disk-changed"
                               head car-bytes cache)))))
            (is @changed?)
            (is (false? (local/ref-exists? rejected-target "disk-changed"))))
          (is (= :invalid-node
                 (reason #(checkpoint-ipq/verify-history-car-cached!
                           cache (assoc checked-schema :ontology-digest "sha256:changed")
                           head car-bytes))))))
      (finally
        (.rmSync fs source-dir #js {:recursive true :force true})
        (.rmSync fs first-dir #js {:recursive true :force true})
        (.rmSync fs second-dir #js {:recursive true :force true})
        (.rmSync fs rejected-dir #js {:recursive true :force true})))))

(deftest import-refuses-ontology-contract-change-before-publication
  (let [source-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-ontology-source-"))
        target-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-ontology-target-"))]
    (try
      (let [checked-schema (schema)
            source (local/open! source-dir)
            target (local/open! target-dir)
            head (local/import-state! source checked-schema "source" (initial-state))
            car-bytes (:bytes (checkpoint-ipq/export-history!
                               source checked-schema head))
            source-contract checkpoint-ipld/ontology-source-contract
            calls (atom 0)]
        (is (= :ontology-contract-changed
               (reason #(with-redefs [checkpoint-ipld/ontology-source-contract
                                      (fn []
                                        (let [snapshot (source-contract)]
                                          (if (= 1 (swap! calls inc))
                                            snapshot
                                            (assoc snapshot :state "changed"))))]
                          (checkpoint-ipq/import-history!
                           target checked-schema "invalid" head car-bytes)))))
        (is (= 2 @calls))
        (is (false? (local/ref-exists? target "invalid"))))
      (finally
        (.rmSync fs source-dir #js {:recursive true :force true})
        (.rmSync fs target-dir #js {:recursive true :force true})))))

(deftest ipq-http-fetch-imports-only-the-expected-verified-history
  (async done
    (let [source-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-http-source-"))
          target-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-http-target-"))
          cached-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-http-cached-"))
          source (local/open! source-dir)
          target (local/open! target-dir)
          cached-target (local/open! cached-dir)
          checked-schema (schema)
          cache (checkpoint-ipq/verification-cache)
          _ (local/import-state! source checked-schema "source" (initial-state))
          head (local/advance-fact! source checked-schema "source" :source/verified)
          mode (atom :normal)
          server (.createServer http
                                (fn [request response]
                                  (let [url (js/URL. (.-url request) "http://127.0.0.1")
                                        request-data {:method :get
                                                      :path (.-pathname url)
                                                      :query {"selector" (.get (.-searchParams url)
                                                                                "selector")}
                                                      :headers {"accept" (.. request -headers -accept)}}]
                                    (if (= :redirect @mode)
                                      (do (.writeHead response 302
                                                      #js {"location" "http://127.0.0.1/other"})
                                          (.end response))
                                    (if (= :status @mode)
                                      (do (.writeHead response 503) (.end response "unavailable"))
                                      (if (= :oversize @mode)
                                        (do (.writeHead response 200
                                                        #js {"content-type" "application/vnd.ipld.car"
                                                             "x-ipq-profile" "1"})
                                            (.end response
                                                  (.alloc js/Buffer
                                                          (inc checkpoint-ipq/max-car-bytes))))
                                      (let [served (ipq/handle
                                                    {:blocks {:get (fn [cid]
                                                                     (when-let [bytes (local/get-block source cid)]
                                                                       {:bytes bytes
                                                                        :content-type "application/vnd.ipld.dag-cbor"}))}}
                                                    request-data)
                                            bytes (.from js/Buffer (:body served) "base64")
                                            headers (assoc (:headers served)
                                                           "content-type"
                                                           (if (= :type @mode)
                                                             "text/html"
                                                             (get-in served [:headers "content-type"]))
                                                           "x-ipq-profile"
                                                           (if (= :profile @mode) "2" "1"))]
                                        (.writeHead response (:status served) (clj->js headers))
                                        (.end response
                                              (if (= :tamper @mode)
                                                (let [decoded (car/decode bytes)
                                                      blocks (mapv (fn [{:keys [cid]}]
                                                                     {:cid cid
                                                                      :bytes (get (:blocks decoded) cid)})
                                                                   (:entries decoded))
                                                      changed (assoc (first blocks)
                                                                     :bytes (:bytes (second blocks)))]
                                                  (:bytes (car/encode
                                                           {:roots [head]
                                                            :blocks (cons changed (rest blocks))})))
                                                bytes)))))))))
          refused (fn [origin name expected]
                    (-> (checkpoint-ipq/fetch-import-history!
                         target checked-schema name origin expected)
                        (.then (fn [_] :unexpected-success)
                               (fn [error]
                                 (let [data (ex-data error)
                                       cause (ex-cause error)]
                                   (or (:reason data)
                                       (some-> cause ex-data :reason)
                                       (some-> cause ex-data :type)
                                       (:type data)
                                       :network-error))))))]
      (.listen server 0 "127.0.0.1"
               (fn []
                 (let [origin (str "http://127.0.0.1:"
                                   (.-port (.address server)))]
                   (-> (checkpoint-ipq/fetch-import-history!
                        js/fetch target checked-schema "received" origin head cache)
                       (.then
                        (fn [result]
                          (is (= head (:root result)))
                          (is (= head (local/read-ref target "received")))
                          (checkpoint-ipq/fetch-import-history!
                           js/fetch cached-target checked-schema
                           "received" origin head cache))
                        (fn [error] (throw error)))
                       (.then (fn [cached]
                                (is (= head (:root cached)))
                                (is (= head (:head (local/verify-ref!
                                                    cached-target checked-schema
                                                    "received"))))
                          (is (= :invalid-ipq-origin
                                 (reason #(checkpoint-ipq/selection-url
                                           "http://example.com" head))))
                          (is (= :invalid-cid
                                 (reason #(checkpoint-ipq/selection-url origin "BAD"))))
                          (reset! mode :status)
                          (refused origin "bad-status" head)))
                       (.then (fn [outcome]
                                (is (= :ipq-http-status outcome))
                                (is (false? (local/ref-exists? target "bad-status")))
                                (reset! mode :type)
                                (refused origin "bad-type" head)))
                       (.then (fn [outcome]
                                (is (= :ipq-content-type outcome))
                                (is (false? (local/ref-exists? target "bad-type")))
                                (reset! mode :profile)
                                (refused origin "bad-profile" head)))
                       (.then (fn [outcome]
                                (is (= :ipq-profile-mismatch outcome))
                                (is (false? (local/ref-exists? target "bad-profile")))
                                (reset! mode :tamper)
                                (refused origin "tampered" head)))
                       (.then (fn [outcome]
                                (is (= :ipld/cid-mismatch outcome))
                                (is (false? (local/ref-exists? target "tampered")))
                                (reset! mode :oversize)
                                (refused origin "oversize" head)))
                       (.then (fn [outcome]
                                (is (= :car-over-limit outcome))
                                (is (false? (local/ref-exists? target "oversize")))
                                (reset! mode :redirect)
                                (refused origin "redirect" head)))
                       (.then (fn [outcome]
                                (is (= :ipq-fetch-failed outcome))
                                (is (false? (local/ref-exists? target "redirect")))))
                       (.catch (fn [error]
                                 (is false (str "unexpected IPQ test error: " error))))
                       (.finally (fn []
                                   (.close server)
                                   (.rmSync fs source-dir #js {:recursive true :force true})
                                   (.rmSync fs target-dir #js {:recursive true :force true})
                                   (.rmSync fs cached-dir #js {:recursive true :force true})
                                   (done))))))))))
