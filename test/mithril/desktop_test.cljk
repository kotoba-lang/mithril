(ns mithril.desktop-test
  (:require [cljs.test :refer [deftest is testing]]
            [clojure.string :as str]
            [mithril.desktop :as desktop]))

(def source
  "(mithril/desktop-application
     :id \"https://mithril.fund/id/app/desktop\"
     :goal \"https://mithril.fund/id/goal/hermes-agent-loop\"
     :page (mithril/page :name \"Mithril\" :description \"Desktop app\" :headline \"Build with Mithril\" :summary \"A bounded semantic coding loop.\" :path \"/mithril\" :nav-label \"Mithril\" :codicon \"symbol-structure\")
     :actor (mithril/actor :protocol \"https://mithril.fund/id/protocol/hermes-coding-agent-v1\" :governor \"https://mithril.fund/id/governor/user-commit-v1\" :receipt-policy \"https://mithril.fund/id/receipt/append-only-v1\" :workspace-policy \"https://mithril.fund/id/workspace/user-selected-local-v1\" :max-goal-chars 4096)
     :activity (mithril/activity :scheduler-policy \"https://mithril.fund/id/scheduler/hermes-profile-cron-v1\" :board-policy \"https://mithril.fund/id/board/hermes-kanban-v1\" :max-active-jobs 32 :max-dispatch-tasks 8)
     :loop (mithril/agent-loop :max-steps 17 :max-polls 60 :poll-interval-ms 1000 :session-title \"Mithril agent\" :actions [\"https://mithril.fund/id/action/profiles-list\" \"https://mithril.fund/id/action/session-list\" \"https://mithril.fund/id/action/session-create\" \"https://mithril.fund/id/action/session-resume\" \"https://mithril.fund/id/action/prompt-submit\" \"https://mithril.fund/id/action/session-status\" \"https://mithril.fund/id/action/session-history\" \"https://mithril.fund/id/action/session-interrupt\" \"https://mithril.fund/id/action/cron-list\" \"https://mithril.fund/id/action/cron-add\" \"https://mithril.fund/id/action/cron-pause\" \"https://mithril.fund/id/action/cron-resume\" \"https://mithril.fund/id/action/cron-remove\" \"https://mithril.fund/id/action/kanban-board-read\" \"https://mithril.fund/id/action/kanban-task-create\" \"https://mithril.fund/id/action/kanban-dispatch\" \"https://mithril.fund/id/action/stop\"]))")

(defn error-code [f] (try (f) nil (catch :default e (:mithril/error (ex-data e)))))

(deftest desktop-source-compiles-and-emits-hermes-plugin
  (let [artifact (desktop/compile-text "app.mith" source)
        plugin (desktop/emit-plugin artifact)]
    (is (= desktop/artifact-format (:format artifact)))
    (is (= [:profiles/list :session/list :session/create :session/resume
            :prompt/submit :session/status :session/history :session/interrupt
            :cron/list :cron/add :cron/pause :cron/resume :cron/remove
            :kanban/board-read :kanban/task-create :kanban/dispatch :stop]
           (get-in artifact [:desktop-ir :loop :actions])))
    (is (= "https://mithril.fund/id/governor/user-commit-v1"
           (get-in artifact [:desktop-ir :actor :governor])))
    (is (str/includes? plugin "from '@hermes/plugin-sdk'"))
    (is (str/includes? plugin "host.request('profiles.list'"))
    (is (str/includes? plugin "host.request('session.resume'"))
    (is (str/includes? plugin "host.request('prompt.submit'"))
    (is (str/includes? plugin "host.request('session.interrupt'"))
    (is (str/includes? plugin "host.request('cron.manage'"))
    (is (str/includes? plugin "ctx.rest('/kanban/tasks'"))
    (is (str/includes? plugin "ctx.rest('/kanban/dispatch?max='"))
    (is (str/includes? plugin "attempt<20"))
    (is (str/includes? plugin "cwd:input.workspace"))
    (is (str/includes? plugin "receipts-v1"))
    (is (str/includes? plugin "\"navLabel\":\"Mithril\""))
    (is (str/includes? plugin "\"maxPolls\":60"))
    (is (str/includes? plugin "area:ROUTES_AREA"))
    (is (not (str/includes? plugin "eval(")))))

(deftest desktop-source-refuses-open-host-programs
  (let [artifact (desktop/compile-text "app.mith" source)]
    (testing "arbitrary action"
      (is (= :mithril.desktop/invalid-actions
             (error-code #(desktop/compile-text "app.mith" (str/replace source "session-history\"" "shell-exec\""))))))
    (testing "unbounded polling"
      (is (= :mithril.desktop/invalid-budget
             (error-code #(desktop/compile-text "app.mith" (str/replace source ":max-polls 60" ":max-polls 999"))))))
    (testing "open actor protocol"
      (is (= :mithril.desktop/invalid-actor
             (error-code #(desktop/compile-text "app.mith" (str/replace source "hermes-coding-agent-v1" "arbitrary-agent"))))))
    (testing "open scheduler policy"
      (is (= :mithril.desktop/invalid-activity
             (error-code #(desktop/compile-text "app.mith" (str/replace source "hermes-profile-cron-v1" "arbitrary-scheduler"))))))
    (testing "only compiled artifacts emit"
      (is (= :mithril.desktop/invalid-artifact
             (error-code #(desktop/emit-plugin (assoc artifact :format "other"))))))))
