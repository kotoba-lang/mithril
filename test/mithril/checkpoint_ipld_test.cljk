(ns mithril.checkpoint-ipld-test
  (:require [cljs.test :refer [deftest is]]
            [ipld.core :as ipld]
            [mithril.bot :as bot]
            [mithril.checkpoint :as checkpoint]
            [mithril.checkpoint-ipld :as store]
            [mithril.execution :as execution]
            [mithril.form :as form]
            [mithril.state-node :as state-node]))

(def fs (js/require "node:fs"))
(def schema (checkpoint/schema (.readFileSync fs checkpoint/ontology-path "utf8")))
(def artifact (bot/compile-text "examples/governed-coding-bot.mith"
                                (.readFileSync fs "examples/governed-coding-bot.mith" "utf8")))
(defn state [] (bot/start-run artifact {:id "ipld-test" :workspace "/tmp"
                                       :goal "merge semantic facts"}
                               "ipld-test" 1000))
(defn fixture []
  (let [blocks (atom {})
        put-fn (fn [cid bytes] (swap! blocks assoc cid bytes))
        get-fn (fn [cid] (get @blocks cid))]
    {:blocks blocks :put-fn put-fn :get-fn get-fn}))
(defn reason [f]
  (try (f) nil (catch :default e (or (:reason (ex-data e)) (:type (ex-data e))))))
(defn code [f]
  (try (f) nil (catch :default e (:mithril/error (ex-data e)))))

(deftest dag-cbor-checkpoints-use-real-verified-links-and-canonical-state
  (let [{:keys [blocks put-fn get-fn]} (fixture)
        s0 (state)
        base (store/put! put-fn get-fn schema s0 [])
        same (store/put! put-fn get-fn schema (into {} (reverse (seq s0))) [])
        left (store/put! put-fn get-fn schema
                         (update s0 :facts conj :review/approved) [base])
        node (ipld/get-node get-fn left)
        saved (store/read! get-fn schema left)]
    (is (= base same) "map insertion order cannot change semantic block identity")
    (is (= [base] (:parents saved)))
    (is (= [base] (ipld/links node)) "parents are IPLD tag-42 links")
    (is (contains? (get-in saved [:state :facts]) :review/approved))
    (is (= left (:cid saved)))
    (is (= :ipld/cid-mismatch
           (reason #(store/read! (fn [id] (if (= id left) (get @blocks base)
                                               (get @blocks id))) schema left))))
    (is (= :missing-block
           (reason #(store/read! (constantly nil) schema left))))))

(deftest disjoint-facts-merge-but-execution-and-removal-do-not
  (let [{:keys [put-fn get-fn]} (fixture)
        s0 (state)
        base (store/put! put-fn get-fn schema s0 [])
        left (store/put! put-fn get-fn schema
                         (update s0 :facts conj :review/approved) [base])
        right (store/put! put-fn get-fn schema
                          (update s0 :facts conj :source/verified) [base])
        merged (store/merge-facts! put-fn get-fn schema base left right)
        result (store/read! get-fn schema merged)
        changed-step (store/put! put-fn get-fn schema
                                 (assoc s0 :step 1) [base])
        removed (store/put! put-fn get-fn schema
                            (update s0 :facts disj :semantic/prefix-valid) [base])]
    (is (= (vec (sort [left right])) (:parents result)))
    (is (= (conj (:facts s0) :review/approved :source/verified)
           (get-in result [:state :facts])))
    (is (= merged (store/merge-facts! put-fn get-fn schema base right left))
        "branch order must not alter a merge CID")
    (is (= :non-additive-or-effect-conflict
           (reason #(store/merge-facts! put-fn get-fn schema base left changed-step))))
    (is (= :non-additive-or-effect-conflict
           (reason #(store/merge-facts! put-fn get-fn schema base left removed))))
    (is (= :not-common-ancestor
           (reason #(store/merge-facts! put-fn get-fn schema left base right))))))

(deftest domain-graph-identity-is-distinct-from-execution-state-cid
  (let [{:keys [put-fn get-fn]} (fixture)
        initial (state)
        first-id (store/put! put-fn get-fn schema initial [])
        second-id (store/put! put-fn get-fn schema
                              (update-in initial [:lease :expires-at] inc) [])
        first-block (store/read! get-fn schema first-id)
        second-block (store/read! get-fn schema second-id)]
    (is (not= first-id second-id))
    (is (not= (get (ipld/get-node get-fn first-id) "stateDigest")
              (get (ipld/get-node get-fn second-id) "stateDigest")))
    (is (= (:domain-graph-digest first-block)
           (:domain-graph-digest second-block)))))

(deftest readdressed-tampering-is-rejected-by-semantic-validation
  (let [{:keys [blocks put-fn get-fn]} (fixture)
        id (store/put! put-fn get-fn schema (state) [])
        node (ipld/get-node get-fn id)
        changed (ipld/node->block (assoc node "source" "(mithril/bot-checkpoint)"))]
    (put-fn (:cid changed) (:bytes changed))
    (is (= :noncanonical-checkpoint
           (reason #(store/read! get-fn schema (:cid changed)))))
    (is (= :invalid-parents
           (reason #(store/block schema (state) [id id]))))
    (is (= :mithril.checkpoint/shacl-violation
           (try (store/block schema (assoc (state) :step "wrong") []) nil
                (catch :default e (:mithril/error (ex-data e))))))
    (is (contains? @blocks id))))

(deftest state-and-domain-ontologies-are-fixed-and-digest-bound
  (let [{:keys [put-fn get-fn]} (fixture)
        id (store/put! put-fn get-fn schema (state) [])
        node (ipld/get-node get-fn id)
        bad-source (ipld/node->block
                    (update node "stateOntologySource"
                            #(.replace % ":sh/min-count 1" ":sh/min-count 0")))
        bad-digest (ipld/node->block
                    (assoc node "stateOntologyDigest" "sha256:wrong"))
        bad-domain-source (ipld/node->block
                           (update node "domainOntologySource"
                                   #(.replace % ":sh/min-count 1"
                                              ":sh/min-count 0")))
        bad-domain-digest (ipld/node->block
                           (assoc node "domainGraphDigest" "sha256:wrong"))]
    (put-fn (:cid bad-source) (:bytes bad-source))
    (put-fn (:cid bad-digest) (:bytes bad-digest))
    (put-fn (:cid bad-domain-source) (:bytes bad-domain-source))
    (put-fn (:cid bad-domain-digest) (:bytes bad-domain-digest))
    (is (= :invalid-node
           (reason #(store/read! get-fn schema (:cid bad-source)))))
    (is (= :noncanonical-checkpoint
           (reason #(store/read! get-fn schema (:cid bad-digest)))))
    (is (= :invalid-node
           (reason #(store/read! get-fn schema (:cid bad-domain-source)))))
    (is (= :domain-graph-digest-mismatch
           (reason #(store/read! get-fn schema (:cid bad-domain-digest)))))))

(deftest a-valid-readdressed-block-cannot-point-to-another-run
  (let [{:keys [put-fn get-fn]} (fixture)
        first-run (state)
        other-run (bot/start-run artifact {:id "other-task" :workspace "/tmp"
                                           :goal "another run"}
                                 "ipld-test" 1000)
        base (store/put! put-fn get-fn schema first-run [])
        child (store/put! put-fn get-fn schema
                          (update first-run :facts conj :review/approved) [base])
        foreign (store/put! put-fn get-fn schema other-run [])
        changed (ipld/node->block
                 (assoc (ipld/get-node get-fn child) "parents" [(ipld/link foreign)]))]
    (put-fn (:cid changed) (:bytes changed))
    (is (= [foreign] (:parents (store/read! get-fn schema (:cid changed)))))
    (is (= :invalid-ancestry
           (reason #(store/verify-history! get-fn schema (:cid changed)))))))

(deftest history-verifies-each-shared-block-once-and-still-checks-ancestors
  (let [{:keys [blocks put-fn get-fn]} (fixture)
        initial (state)
        base (store/put! put-fn get-fn schema initial [])
        left (store/put! put-fn get-fn schema
                         (update initial :facts conj :review/approved) [base])
        right (store/put! put-fn get-fn schema
                          (update initial :facts conj :source/verified) [base])
        merged (store/merge-facts! put-fn get-fn schema base left right)
        reads (atom {})
        counted-get (fn [cid]
                      (swap! reads update cid (fnil inc 0))
                      (get-fn cid))]
    (is (= 4 (:blocks (store/verify-history! counted-get schema merged))))
    (is (= {base 1 left 1 right 1 merged 1} @reads))
    (swap! blocks assoc base (get @blocks left))
    (is (= :ipld/cid-mismatch
           (reason #(store/verify-history! get-fn schema merged))))))

(deftest history-limit-rejects-the-first-block-beyond-256
  (let [ids (mapv #(str "synthetic-cid-" %) (range 257))
        initial (state)
        rows (into {}
                   (map-indexed (fn [index id]
                                  [id {:state initial
                                       :parents (if (zero? index)
                                                  [] [(nth ids (dec index))])}])
                                ids))]
    (with-redefs [store/read! (fn [_ _ id] (get rows id))]
      (is (= 256 (:blocks (store/verify-history! nil schema (nth ids 255)))))
      (is (= :ancestry-limit
             (reason #(store/verify-history! nil schema (nth ids 256))))))))

(deftest legacy-run-task-is-derived-without-rewriting-the-saved-state
  (let [{:keys [put-fn get-fn]} (fixture)
        legacy (-> (state)
                   (assoc :format checkpoint/legacy-run-format)
                   (dissoc :task-digest :bpmn))
        base (store/put! put-fn get-fn schema legacy [])
        child (store/put! put-fn get-fn schema
                          (update legacy :facts conj :review/approved) [base])
        saved (store/read! get-fn schema child)]
    (is (nil? (get-in saved [:state :task-digest])))
    (is (= (bot/task-digest (:task legacy))
           (:task-digest (checkpoint/projection legacy nil))))
    (is (= 2 (:blocks (store/verify-history! get-fn schema child))))
    (is (= :mithril.checkpoint/task-binding-mismatch
           (code #(store/block schema
                               (assoc legacy :task-digest "sha256:wrong") []))))
    (is (= :mithril.checkpoint/task-binding-mismatch
           (code #(store/block schema
                               (-> legacy
                                   (assoc :format "https://mithril.fund/state/bot-run-v2"))
                               []))))))

(deftest semantic-v6-binds-domain-rdf-and-reads-v1-through-v5
  (let [{:keys [put-fn get-fn]} (fixture)
        s (state)
        current (store/put! put-fn get-fn schema s [])
        v6 (store/read! get-fn schema current)
        v6-node (ipld/get-node get-fn current)
        shipped (js->clj (js/JSON.parse
                          (.readFileSync fs "resources/context-bot-checkpoint-v1.jsonld"
                                         "utf8")))
        {:keys [digest block]} (checkpoint/build schema s nil)
        old-node {"format" store/format-v1
                  "ontologyDigest" (:ontology-digest schema)
                  "checkpointDigest" digest
                  "graphDigest" (:graph-digest block)
                  "stateDigest" (:state-digest block)
                  "stateEdn" (execution/canonical-edn-text s)
                  "source" (:source block)
                  "parents" []}
        old (ipld/node->block old-node)
        v5-node (-> v6-node
                    (dissoc "domainOntologySource" "domainOntologyDigest"
                            "domainDataset" "domainGraphDigest")
                    (assoc "format" store/format-v5))
        v5 (ipld/node->block v5-node)
        v4-node (-> v5-node
                    (dissoc "stateOntologySource" "stateOntologyDigest")
                    (assoc "format" store/format-v4))
        v4 (ipld/node->block v4-node)
        v3-node (-> v4-node
                    (dissoc "stateDataset")
                    (assoc "format" store/format-v3
                           "stateNode" (state-node/encode-value s)))
        v3 (ipld/node->block v3-node)
        v2-node (-> v3-node
                    (dissoc "stateNode")
                    (assoc "format" store/format-v2
                           "stateEdn" (execution/canonical-edn-text s)))
        v2 (ipld/node->block v2-node)]
    (put-fn (:cid old) (:bytes old))
    (put-fn (:cid v5) (:bytes v5))
    (put-fn (:cid v4) (:bytes v4))
    (put-fn (:cid v3) (:bytes v3))
    (put-fn (:cid v2) (:bytes v2))
    (is (= checkpoint/semantic-context-document shipped))
    (is (= store/format-id (:format v6)))
    (is (not (contains? v6-node "stateEdn")))
    (is (not (contains? v6-node "stateNode")))
    (is (map? (get v6-node "stateDataset")))
    (is (map? (get v6-node "domainDataset")))
    (is (string? (get v6-node "stateOntologySource")))
    (is (string? (get v6-node "domainOntologySource")))
    (is (re-matches #"sha256:[0-9a-f]{64}" (get v6-node "stateOntologyDigest")))
    (is (re-matches #"sha256:[0-9a-f]{64}" (:domain-graph-digest v6)))
    (is (= s (:state v6)))
    (is (= checkpoint/semantic-context-uri
           (get (form/parse (:semantic-source v6)) "@context")))
    (is (re-matches #"sha256:[0-9a-f]{64}" (:semantic-graph-digest v6)))
    (is (= store/format-v5 (:format (store/read! get-fn schema (:cid v5)))))
    (is (= s (:state (store/read! get-fn schema (:cid v5)))))
    (is (= store/format-v4 (:format (store/read! get-fn schema (:cid v4)))))
    (is (= s (:state (store/read! get-fn schema (:cid v4)))))
    (is (= store/format-v3 (:format (store/read! get-fn schema (:cid v3)))))
    (is (= s (:state (store/read! get-fn schema (:cid v3)))))
    (is (= store/format-v2 (:format (store/read! get-fn schema (:cid v2)))))
    (is (= s (:state (store/read! get-fn schema (:cid v2)))))
    (is (= store/format-v1 (:format (store/read! get-fn schema (:cid old)))))
    (is (nil? (:semantic-graph-digest
               (store/read! get-fn schema (:cid old)))))))

(deftest missing-rdf-mapping-cannot-be-saved-as-semantic-v2
  (is (= :mithril.checkpoint/rdf-field-loss
         (code #(with-redefs [checkpoint/semantic-context-document
                             (update checkpoint/semantic-context-document
                                     "@context" dissoc "taskDigest")]
                  (store/block schema (state) []))))))
