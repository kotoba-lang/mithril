(ns mithril.synthesis-test
  (:require [cljs.test :refer [deftest is testing]]
            [mithril.compiler :as compiler]
            [mithril.synthesis :as synthesis]
            [mithril.web :as web]))

(def static-label "return the authored static response")
(def not-found-label "return a not found response")
(def exact-router-label "match only the exact request method and path")
(def head-router-label "match HEAD to the corresponding GET path")
(def text-label "render the body as plain text")
(def json-label "render the body as JSON")
(def http-label "emit the complete typed HTTP response")
(def no-content-label "emit a no content response")
(def revision (apply str (repeat 40 "a")))

(defn read-text [path]
  (.readFileSync (js/require "fs") path "utf8"))

(defn fixture []
  (let [library (compiler/compile-library-text
                 "lib/web/v1.mith" (read-text "lib/web/v1.mith"))
        app (compiler/parse-json (read-text "examples/hello-web-synthesis.mith"))]
    {:library library :app app}))

(defn multiroute-fixture []
  (let [library (compiler/compile-library-text
                 "lib/web/v1.mith" (read-text "lib/web/v1.mith"))
        app (compiler/parse-json (read-text "examples/multiroute-web-synthesis.mith"))]
    {:library library :app app}))

(defn pipeline-fixture []
  (let [library (compiler/compile-library-text
                 "lib/web/pipeline-v1.mith" (read-text "lib/web/pipeline-v1.mith"))
        app (compiler/parse-json
             (read-text "examples/typed-call-dag-web-synthesis.mith"))]
    {:library library :app app}))

(defn choice [selected other confidence]
  {:choice selected
   :probabilities {selected confidence other (- 1 confidence)}
   :confidence confidence})

(defn pipeline-result []
  {:kind "typed-decisions/open-jev-v1"
   :generated_text false
   :model {:base_model "test-fixture" :pool "mean" :temperature 1.0}
   :decisions [(choice exact-router-label head-router-label 0.91)
               (choice static-label not-found-label 0.92)
               (choice json-label text-label 0.93)
               (choice http-label no-content-label 0.94)

               (choice head-router-label exact-router-label 0.91)
               (choice static-label not-found-label 0.92)
               (choice text-label json-label 0.93)
               (choice no-content-label http-label 0.94)

               (choice exact-router-label head-router-label 0.91)
               (choice not-found-label static-label 0.92)
               (choice text-label json-label 0.93)
               (choice http-label no-content-label 0.94)]
   :artifact {:repo_or_dir "com-kotobalabs/open-jev-deberta-v3-large"
              :revision revision}})

(defn result
  ([choice confidence]
   (result choice confidence {static-label confidence
                              not-found-label (- 1 confidence)}))
  ([choice confidence probabilities]
   {:kind "typed-decisions/open-jev-v1"
    :generated_text false
    :model {:base_model "test-fixture" :pool "mean" :temperature 1.0}
    :decisions [{:choice choice
                 :probabilities probabilities
                 :confidence confidence}]
    :artifact {:repo_or_dir "com-kotobalabs/open-jev-deberta-v3-large"
               :revision revision}}))

(defn multiroute-result []
  (assoc (result static-label 0.9)
         :decisions
         [{:choice static-label
           :probabilities {static-label 0.9 not-found-label 0.1}
           :confidence 0.9}
          {:choice static-label
           :probabilities {static-label 0.8 not-found-label 0.2}
           :confidence 0.8}
          {:choice not-found-label
           :probabilities {static-label 0.15 not-found-label 0.85}
           :confidence 0.85}]))

(defn error-code [f]
  (try (f) nil
       (catch :default e (:mithril/error (ex-data e)))))

(deftest owl-sparql-discovery-prepares-a-closed-jev-request
  (let [{:keys [library app]} (fixture)
        prepared (synthesis/prepare-request
                  "examples/hello-web-synthesis.mith" app [library])
        candidates (:candidates prepared)
        question (get-in prepared [:request :questions 0])]
    (is (= 2 (count candidates))
        "both handlers are discovered through OaK's OWL/SPARQL boundary")
    (is (= #{"https://mithril.fund/lib/web/v1/handler/static-response"
             "https://mithril.fund/lib/web/v1/handler/not-found"}
           (set (map :symbol candidates))))
    (is (= "choice" (:type question)))
    (is (= [not-found-label static-label] (:options question)))
    (is (re-find #"no generated text" (get-in prepared [:request :state])))))

(deftest admitted-openjev-choice-is-sealed-and-executed
  (let [{:keys [library app]} (fixture)
        artifact (synthesis/compile-with-model
                  "examples/hello-web-synthesis.mith" app [library]
                  (result static-label 0.9))
        route (get-in artifact [:web-ir :routes 0])]
    (is (= false (get-in artifact [:synthesis :generated_text])))
    (is (= revision (get-in artifact [:synthesis :artifact :revision])))
    (is (= "https://mithril.fund/lib/web/v1/handler/static-response"
           (:operation route)))
    (is (= 9000 (get-in route [:decision :confidence])))
    (is (= {:status 200
            :headers {"content-type" "text/plain; charset=utf-8"}
            :body "Hello from an OpenJev-selected .mith application."}
           (web/dispatch artifact {:method "GET" :path "/hello"})))
    (is (not= (:graph-digest artifact) (:source-graph-digest artifact)))))

(deftest one-model-forward-composes-and-executes-multiple-routes
  (let [{:keys [library app]} (multiroute-fixture)
        prepared (synthesis/prepare-request
                  "examples/multiroute-web-synthesis.mith" app [library])
        artifact (synthesis/compile-with-model
                  "examples/multiroute-web-synthesis.mith" app [library]
                  (multiroute-result))
        routes (get-in artifact [:web-ir :routes])]
    (is (= 3 (count (get-in prepared [:request :questions])))
        "one OpenJev request carries every route question")
    (is (= 3 (count routes)))
    (is (= ["https://mithril.fund/lib/web/v1/handler/static-response"
            "https://mithril.fund/lib/web/v1/handler/static-response"
            "https://mithril.fund/lib/web/v1/handler/not-found"]
           (mapv :operation routes)))
    (is (= [9000 8000 8500]
           (mapv #(get-in % [:decision :confidence]) routes)))
    (is (= {:status 200
            :headers {"content-type" "text/plain; charset=utf-8"}
            :body "Hello from a multi-route OpenJev-selected .mith application."}
           (web/dispatch artifact {:method "GET" :path "/hello"})))
    (is (= {:status 204
            :headers {"content-type" "text/plain; charset=utf-8"}
            :body ""}
           (web/dispatch artifact {:method "HEAD" :path "/health"})))
    (is (= {:status 404
            :headers {"content-type" "text/plain; charset=utf-8"}
            :body "Not Found"}
           (web/dispatch artifact {:method "GET" :path "/retired"})))))

(deftest one-model-forward-builds-and-executes-a-typed-call-dag
  (let [{:keys [library app]} (pipeline-fixture)
        prepared (synthesis/prepare-request
                  "examples/typed-call-dag-web-synthesis.mith" app [library])
        artifact (synthesis/compile-with-model
                  "examples/typed-call-dag-web-synthesis.mith" app [library]
                  (pipeline-result))
        routes (get-in artifact [:web-ir :routes])]
    (is (= 12 (count (get-in prepared [:request :questions])))
        "one OpenJev request carries four typed choices for each route")
    (is (= (repeat 3 [:router :handler :view :effect])
           (mapv vec (partition 4 (map :role (:question-plans prepared))))))
    (doseq [route routes]
      (is (= [:router :handler :view :effect]
             (mapv :id (get-in route [:call-dag :nodes]))))
      (is (= [[] [:router] [:handler] [:view]]
             (mapv :depends-on (get-in route [:call-dag :nodes])))))
    (is (= {:status 200
            :headers {"content-type" "application/json; charset=utf-8"}
            :body "{\"value\":\"ontology\"}"}
           (web/dispatch artifact {:method "GET" :path "/data"})))
    (is (= {:status 204 :headers {} :body ""}
           (web/dispatch artifact {:method "HEAD" :path "/health"})))
    (is (= {:status 404
            :headers {"content-type" "text/plain; charset=utf-8"}
            :body "Not Found"}
           (web/dispatch artifact {:method "GET" :path "/retired"})))
    (testing "a malformed DAG is refused before dispatch"
      (is (= :mithril.web/invalid-call-dag
             (error-code #(web/dispatch
                           (assoc-in artifact
                                     [:web-ir :routes 0 :call-dag :nodes 1 :depends-on]
                                     [])
                           {:method "GET" :path "/data"})))))
    (testing "an unimplemented component identifier is refused"
      (is (= :mithril.web/unknown-view
             (error-code #(web/dispatch
                           (assoc-in artifact
                                     [:web-ir :routes 0 :call-dag :nodes 2 :operation]
                                     "https://mithril.fund/lib/web/pipeline-v1/view/unknown")
                           {:method "GET" :path "/data"})))))))

(deftest synthesis-fails-closed-before-and-after-model-forward
  (let [{:keys [library app]} (fixture)]
    (testing "invalid route is rejected while preparing the model request"
      (is (= :mithril/invalid-path
             (error-code #(synthesis/prepare-request
                           "x.mith" (assoc-in app ["routes" 0 "path"] "relative")
                           [library])))))
    (testing "generated text claims are forbidden"
      (is (= :mithril/generated-text-forbidden
             (error-code #(synthesis/compile-with-model
                           "x.mith" app [library]
                           (assoc (result static-label 0.9) :generated_text true))))))
    (testing "confidence below the ontology-authored handler floor is refused"
      (is (= :mithril/model-confidence-below-floor
             (error-code #(synthesis/compile-with-model
                           "x.mith" app [library] (result static-label 0.59))))))
    (testing "choice must be the distribution winner"
      (is (= :mithril/invalid-model-confidence
             (error-code #(synthesis/compile-with-model
                           "x.mith" app [library]
                           (result static-label 0.8
                                   {static-label 0.2 not-found-label 0.8}))))))
    (testing "the model artifact must be pinned to an immutable revision"
      (is (= :mithril/unpinned-model
             (error-code #(synthesis/compile-with-model
                           "x.mith" app [library]
                           (assoc-in (result static-label 0.9)
                                     [:artifact :revision] "main"))))))))
