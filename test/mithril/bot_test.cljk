(ns mithril.bot-test
  (:require [cljs.test :refer [deftest is testing]]
            [mithril.bot :as bot]
            [mithril.compiler :as compiler]
            [mithril.execution :as execution]))

(defn read-text [path] (.readFileSync (js/require "fs") path "utf8"))
(defn profile [] (bot/compile-text "examples/governed-coding-bot.mith"
                                  (read-text "examples/governed-coding-bot.mith")))
(defn legacy-profile []
  (let [doc (compiler/parse-source (read-text "examples/governed-coding-bot.mith"))]
    (bot/compile-document "legacy.mith" (dissoc doc "process" "legacyProfiles"))))
(defn task [] {:id "task-1" :workspace "/tmp/work" :goal "Implement one checked change"})
(defn error-code [f] (try (f) nil (catch :default e (:mithril/error (ex-data e)))))

(defn model-result
  ([state choice confidence] (model-result state choice confidence confidence))
  ([state choice probability confidence]
  (let [candidates (:candidates (bot/prepare-request state "worker-1" 1001))
        labels (mapv :label candidates)
        rest-labels (remove #{choice} labels)
        other (/ (- 1 probability) (count rest-labels))]
    {:kind bot/model-kind :generated_text false :model "typesafe/jev-1.13-20260917"
     :artifact {:provider bot/jev-provider :endpoint bot/jev-endpoint
                :requested_model bot/jev-model
                :resolved_model "typesafe/jev-1.13-20260917"}
     :decisions [{:choice choice :confidence confidence
                  :probabilities (into {choice probability}
                                       (map (fn [label] [label other]) rest-labels))}]})))

(defn complete [state admitted now]
  (let [{:keys [state effect]} (bot/request-effect state admitted
                                                    (get-in state [:policy :effects])
                                                    "worker-1" now)]
    (bot/apply-receipt state
                       {:format bot/receipt-format :effect-id (:id effect)
                        :status :completed :output-digest (execution/digest effect)}
                       "worker-1" (inc now))))

(deftest profile-compiles-and-discovers-actions
  (let [artifact (profile) actions (bot/discover-actions artifact)
        state (bot/start-run artifact (task) "worker-1" 1000)
        ontology (compiler/parse-source (read-text "ontology/bpmn-agent-v1.mith"))]
    (is (= bot/artifact-format (:format artifact)))
    (is (= 8 (count actions)))
    (is (= [:infer/owl2-rl :query/sparql :validate/shacl :execute/bpmn-token]
           (mapv :operation (:semantic-receipts state))))
    (is (= 0 (get-in state [:semantic-receipts 2 :metrics :violations])))
    (is (= (subs (compiler/graph-digest ontology) 7)
           (get-in artifact [:bot-ir :ontology])))
    (is (= :mithril.bot/v2 (get-in artifact [:bot-ir :version])))
    (is (= "https://mithril.fund/state/bot-run-v2" (:format state)))
    (is (= #{"workspace-inspect" "git-status" "stop"}
           (set (map :label (bot/available-actions state)))))))

(deftest jev-choice-is-closed-and-governed
  (let [state (bot/start-run (profile) (task) "worker-1" 1000)
        admitted (bot/admit-decision state (model-result state "workspace-inspect" 0.8 0.7)
                                     "worker-1" 1001)]
    (is (= :workspace/read (get-in admitted [:action :effect])))
    (is (= :mithril.bot/capability-denied
           (error-code #(bot/request-effect state admitted #{:git/status} "worker-1" 1002))))
    (is (= :mithril.bot/outside-candidate-set
           (error-code #(bot/admit-decision
                         state
                         (assoc-in (model-result state "workspace-inspect" 0.8)
                                   [:decisions 0 :choice] "shell-exec")
                         "worker-1" 1001))))
    (is (= 7000 (:confidence admitted))
        "TypeSafe confidence is independent from the winning probability")))

(deftest completed-receipts-advance-prerequisites
  (let [s0 (bot/start-run (profile) (task) "worker-1" 1000)
        s1 (complete s0 (bot/admit-decision s0 (model-result s0 "workspace-inspect" 0.8)
                                            "worker-1" 1001) 1002)
        s2 (complete s1 (bot/admit-decision s1 (model-result s1 "code-propose" 0.8)
                                            "worker-1" 1004) 1005)]
    (is (contains? (:facts s1) :workspace/inspected))
    (is (contains? (:facts s2) :proposal/ready))
    (is (not-any? #(= "workspace-inspect" (:label %)) (bot/available-actions s1)))
    (is (some #(= "patch-apply" (:label %)) (bot/available-actions s2)))
    (is (= 2 (:step s2)))
    (is (= 2 (count (:receipts s2))))))

(deftest idempotency-lease-and-retry-fail-closed
  (let [s0 (bot/start-run (profile) (task) "worker-1" 1000)
        admitted (bot/admit-decision s0 (model-result s0 "workspace-inspect" 0.8)
                                     "worker-1" 1001)
        r1 (bot/request-effect s0 admitted (get-in s0 [:policy :effects]) "worker-1" 1002)
        r2 (bot/request-effect s0 admitted (get-in s0 [:policy :effects]) "worker-1" 1002)
        effect (:effect r1)
        failed {:format bot/receipt-format :effect-id (:id effect) :status :failed
                :output-digest (execution/digest :failed)}
        s1 (bot/apply-receipt (:state r1) failed "worker-1" 1003)]
    (is (= (get-in r1 [:effect :id]) (get-in r2 [:effect :id])))
    (is (= 1 (get-in s1 [:retries "https://mithril.fund/id/action/workspace-inspect"])))
    (is (= :mithril.bot/lease-not-held
           (error-code #(bot/prepare-request s1 "other-worker" 1004))))
    (is (= :mithril.bot/duplicate-receipt
           (error-code #(bot/apply-receipt s1 failed "worker-1" 1004))))))

(deftest failed-build-enters-a-bounded-governed-repair-edge
  (let [s0 (bot/start-run (profile) (task) "worker-1" 1000)
        s1 (complete s0 (bot/admit-decision s0 (model-result s0 "workspace-inspect" 0.8)
                                            "worker-1" 1001) 1002)
        s2 (complete s1 (bot/admit-decision s1 (model-result s1 "code-propose" 0.8)
                                            "worker-1" 1004) 1005)
        s3 (complete s2 (bot/admit-decision s2 (model-result s2 "patch-apply" 0.9)
                                            "worker-1" 1007) 1008)
        base (complete s3 (bot/admit-decision s3 (model-result s3 "amu-compile" 0.8)
                                              "worker-1" 1010) 1011)
        test-action {:action (get bot/action-by-label "test-run")}
        requested (bot/request-effect base test-action (get-in base [:policy :effects])
                                      "worker-1" 2000)
        failed {:format bot/receipt-format :effect-id (get-in requested [:effect :id])
                :status :failed :output-digest (execution/digest :test-failed)}
        repair-state (bot/apply-receipt (:state requested) failed "worker-1" 2001)
        reset-action {:action (get bot/action-by-label "patch-reset")}
        reset-request (bot/request-effect repair-state reset-action
                                          (get-in repair-state [:policy :effects])
                                          "worker-1" 2002)
        reset-receipt {:format bot/receipt-format
                       :effect-id (get-in reset-request [:effect :id])
                       :status :completed :output-digest (execution/digest :reset)}
        reset-state (bot/apply-receipt (:state reset-request) reset-receipt
                                       "worker-1" 2003)]
    (is (contains? (:facts repair-state) :repair/needed))
    (is (= 1 (get-in repair-state [:retries "https://mithril.fund/id/action/test-run"])))
    (is (some #(= "patch-reset" (:label %)) (bot/available-actions repair-state)))
    (is (contains? (:facts reset-state) :workspace/reset))
    (is (not-any? (:facts reset-state)
                  [:proposal/ready :workspace/changed :artifact/compiled
                   :tests/passed :repair/needed]))
    (is (some #(= "code-propose" (:label %)) (bot/available-actions reset-state)))
    (is (not-any? #(= "test-run" (:label %)) (bot/available-actions reset-state)))))

(deftest durable-lease-can-be-renewed-but-not-stolen
  (let [state (bot/start-run (profile) (task) "worker-1" 1000)
        renewed (bot/acquire-lease state "worker-1" 1100)
        expired (bot/acquire-lease state "worker-2" 901001)]
    (is (> (get-in renewed [:lease :expires-at]) (get-in state [:lease :expires-at])))
    (is (= "worker-2" (get-in expired [:lease :owner])))
    (is (= :mithril.bot/lease-held
           (error-code #(bot/acquire-lease state "worker-2" 1100))))))

(deftest durable-checkpoint-is-task-bound-and-terminal-redelivery-is-idempotent
  (let [artifact (profile)
        task-a (task)
        task-b (assoc task-a :id "task-2" :goal "Implement the next checked change")
        running (bot/start-run artifact task-a "worker-1" 1000)
        resumed (bot/resume-or-start artifact task-a running "worker-1" 1100)
        terminal-state (assoc running :status :completed)
        terminal (bot/resume-or-start artifact task-a terminal-state "worker-1" 1200)
        next-run (bot/resume-or-start artifact task-b terminal-state "worker-1" 1300)]
    (is (= (bot/task-digest task-a) (:task-digest running)))
    (is (= :resumed (:disposition resumed)))
    (is (= :terminal (:disposition terminal)))
    (is (= (:run-id running) (get-in terminal [:state :run-id])))
    (is (= :started (:disposition next-run)))
    (is (= task-b (get-in next-run [:state :task])))
    (is (not= (:run-id running) (get-in next-run [:state :run-id])))
    (is (= :mithril.bot/state-binding-mismatch
           (error-code #(bot/resume-or-start artifact task-b running "worker-1" 1400))))))

(deftest legacy-checkpoints-migrate-by-replaying-semantic-facts
  (let [artifact (profile)
        old-artifact (legacy-profile)
        base (-> (bot/start-run old-artifact (task) "worker-1" 1000)
                 (assoc :profile-digest
                        "sha256:c53e7a4cddfee776084a68bd926924f1554d60cb0888f2000a5672ba2de5136d")
                 (update-in [:policy :actions]
                            #(vec (remove #{"https://mithril.fund/id/action/patch-reset"} %)))
                 (update-in [:policy :effects]
                            #(vec (remove #{:workspace/revert-patch} %))))
        stages [{:facts #{:semantic/prefix-valid}
                 :actions ["workspace-inspect" "git-status" "stop"]}
                {:facts #{:semantic/prefix-valid :workspace/inspected}
                 :actions ["code-propose" "git-status" "stop"]}
                {:facts #{:semantic/prefix-valid :workspace/inspected :proposal/ready}
                 :actions ["patch-apply" "git-status" "stop"]}
                {:facts #{:semantic/prefix-valid :workspace/inspected :proposal/ready
                          :workspace/changed :repair/needed}
                 :actions ["patch-reset" "amu-compile" "git-status" "stop"]}
                {:facts #{:semantic/prefix-valid :workspace/inspected :proposal/ready
                          :workspace/changed :artifact/compiled :repair/needed}
                 :actions ["patch-reset" "test-run" "git-status" "stop"]}
                {:facts #{:semantic/prefix-valid :workspace/inspected :proposal/ready
                          :workspace/changed :artifact/compiled :tests/passed}
                 :actions ["git-status" "stop"]}
                {:facts #{:semantic/prefix-valid :workspace/inspected :proposal/ready
                          :workspace/changed :artifact/compiled :tests/passed :git/observed}
                 :actions ["git-status" "stop"]}
                {:facts #{:semantic/prefix-valid :workspace/inspected :workspace/reset}
                 :actions ["code-propose" "git-status" "stop"]}]]
    (is (= ["sha256:c53e7a4cddfee776084a68bd926924f1554d60cb0888f2000a5672ba2de5136d"]
           (:legacy-profile-digests artifact)))
    (doseq [[index {:keys [facts actions]}] (map-indexed vector stages)]
      (let [legacy (assoc base :facts facts :step index
                          :receipts [{:legacy index}]
                          :retries {"legacy" index})
            result (bot/resume-or-start artifact (task) legacy "worker-1" 2000)
            migrated (:state result)]
        (is (= :migrated (:disposition result)))
        (is (= "https://mithril.fund/state/bot-run-v2" (:format migrated)))
        (is (= actions (mapv :label (bot/available-actions migrated))))
        (is (= index (:step migrated)))
        (is (= [{:legacy index}] (:receipts migrated)))
        (is (= {"legacy" index} (:retries migrated)))
        (is (= :migrate/bot-run-v1-to-bpmn-v2
               (-> migrated :semantic-receipts last :operation)))))))

(deftest unsafe-or-unbound-legacy-checkpoints-refuse-migration
  (let [artifact (profile)
        base (-> (bot/start-run (legacy-profile) (task) "worker-1" 1000)
                 (assoc :profile-digest
                        "sha256:c53e7a4cddfee776084a68bd926924f1554d60cb0888f2000a5672ba2de5136d")
                 (update-in [:policy :actions]
                            #(vec (remove #{"https://mithril.fund/id/action/patch-reset"} %)))
                 (update-in [:policy :effects]
                            #(vec (remove #{:workspace/revert-patch} %))))
        mismatch (assoc base :profile-digest (str "sha256:" (apply str (repeat 64 "f"))))
        in-flight (assoc base :awaiting {:id "effect"})
        unknown-fact (update base :facts conj :untrusted/fact)
        inconsistent (update base :facts conj :tests/passed)]
    (doseq [state [mismatch in-flight unknown-fact inconsistent]]
      (is (= :mithril.bot/state-binding-mismatch
             (error-code #(bot/resume-or-start artifact (task) state "worker-1" 2000)))))))

(deftest generated-text-and-low-confidence-are-refused
  (let [state (bot/start-run (profile) (task) "worker-1" 1000)]
    (is (= :mithril.bot/generated-text-forbidden
           (error-code #(bot/admit-decision state
                                             (assoc (model-result state "stop" 0.8)
                                                    :generated_text true)
                                             "worker-1" 1001))))
    (is (= :mithril.bot/model-confidence-below-floor
           (error-code #(bot/admit-decision state (model-result state "stop" 0.8 0.2)
                                             "worker-1" 1001))))))

(deftest low-confidence-decision-becomes-an-effect-free-terminal-hold
  (let [state (bot/start-run (profile) (task) "worker-1" 1000)
        result (bot/resolve-decision state (model-result state "stop" 0.8 0.2)
                                     "worker-1" 1001)
        held (:held result)]
    (is (= :mithril.bot/model-confidence-below-floor (:reason result)))
    (is (= :held (:status held)))
    (is (= :model-confidence-below-floor (:hold-reason held)))
    (is (= (:step state) (:step held)))
    (is (nil? (:awaiting held)))
    (is (= :refused (get-in held [:semantic-receipts 4 :status])))
    (is (= :terminal (:disposition
                     (bot/resume-or-start (profile) (task) held "worker-1" 1002))))
    (is (= :mithril.bot/not-running
           (error-code #(bot/resolve-decision held
                                              (model-result state "stop" 0.8 0.2)
                                              "worker-1" 1003))))))

(deftest bpmn-token-is-the-process-authority-through-terminal-stop
  (let [advance (fn [state label now]
                  (complete state
                            (bot/admit-decision state (model-result state label 0.9)
                                                "worker-1" now)
                            (inc now)))
        s0 (bot/start-run (profile) (task) "worker-1" 1000)
        s1 (advance s0 "workspace-inspect" 1010)
        s2 (advance s1 "code-propose" 1020)
        s3 (advance s2 "patch-apply" 1030)
        s4 (advance s3 "amu-compile" 1040)
        s5 (advance s4 "test-run" 1050)
        s6 (advance s5 "git-status" 1060)
        s7 (advance s6 "stop" 1070)]
    (is (= ["workspace-inspect" "git-status" "stop"]
           (mapv :label (bot/available-actions s0))))
    (is (= ["code-propose" "git-status" "stop"]
           (mapv :label (bot/available-actions s1))))
    (is (= ["patch-apply" "git-status" "stop"]
           (mapv :label (bot/available-actions s2))))
    (is (= ["amu-compile" "git-status" "stop"]
           (mapv :label (bot/available-actions s3))))
    (is (= ["test-run" "git-status" "stop"]
           (mapv :label (bot/available-actions s4))))
    (is (= ["git-status" "stop"]
           (mapv :label (bot/available-actions s5))))
    (is (= ["git-status" "stop"]
           (mapv :label (bot/available-actions s6))))
    (is (= :completed (:status s7)))
    (is (true? (get-in s7 [:bpmn :token-state :bpmn/done?])))
    (is (empty? (get-in s7 [:bpmn :token-state :bpmn/tokens])))
    (is (= 7 (count (:receipts s7))))))

(deftest bpmn-ontology-and-decision-edges-fail-closed
  (let [doc (compiler/parse-source (read-text "examples/governed-coding-bot.mith"))]
    (is (= :mithril.bpmn/ontology-mismatch
           (error-code #(bot/compile-document
                         "x.mith"
                         (assoc-in doc ["process" "ontology"]
                                   (apply str (repeat 64 "0")))))))
    (is (= :mithril.bpmn/invalid-decision-flow
           (error-code #(bot/compile-document
                         "x.mith"
                         (assoc-in doc ["process" "flows" 1 "condition"]
                                   "https://mithril.fund/id/action/stop")))))))
