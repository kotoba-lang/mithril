(ns mithril.hermes-fleet-test
  (:require [cljs.test :refer [deftest is testing]]
            [mithril.hermes-fleet :as fleet]))

(def base
  {"@context" "https://mithril.fund/context/v1"
   "@id" "https://mithril.fund/id/hermes-profile/itonami"
   "@type" "HermesProfile"
   "ontology" fleet/ontology-digest
   "profileName" "itonami"
   "profileRoot" "/tmp/profiles/itonami"
   "configDigest" nil "soulDigest" nil "jobsDigest" nil
   "jobs" []})

(defn error-code [f]
  (try (f) nil (catch :default error (:mithril/error (ex-data error)))))

(deftest profile-manifest-is-typed-and-closed
  (let [artifact (fleet/compile-document "itonami.mith" base)]
    (is (= fleet/artifact-format (:format artifact)))
    (is (= :mithril.hermes-profile/v1 (get-in artifact [:profile-ir :version])))
    (is (= [] (get-in artifact [:profile-ir :jobs]))))
  (testing "profile roots bind identity"
    (is (= :mithril.fleet/invalid-profile-root
           (error-code #(fleet/compile-document "x.mith" (assoc base "profileRoot" "/tmp/profiles/other")))))))

(deftest effects-are-derived-not-declared-by-prompts
  (let [job {"jobId" "job-1" "name" "compile" "enabled" true "noAgent" false
             "promptDigest" "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
             "scriptDigest" "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
             "scriptPresent" true
             "scheduleDigest" "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
             "workdir" "/tmp/work" "effects" ["scheduler/tick" "host/script-run" "agent/workspace-turn"]}
        artifact (fleet/compile-document "itonami.mith" (assoc base "jobs" [job]))]
    (is (= [:scheduler/tick :host/script-run :agent/workspace-turn]
           (get-in artifact [:profile-ir :jobs 0 :effects])))
    (is (= :mithril.fleet/effect-mismatch
           (error-code #(fleet/compile-document
                          "itonami.mith"
                          (assoc base "jobs" [(assoc job "effects" ["llm/agent-turn"])])))))))

(deftest profile-identity-excludes-scheduler-telemetry-but-binds-declaration
  (let [job {"jobId" "job-1" "name" "inspect" "enabled" true "noAgent" true
             "promptDigest" "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
             "scriptDigest" "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
             "scriptPresent" true
             "scheduleDigest" "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
             "workdir" "/tmp/work" "effects" ["scheduler/tick" "host/script-run"]}
        source (assoc base "jobsDigest" (str "sha256:" (apply str (repeat 64 "d")))
                           "jobs" [job])
        digest #(:graph-digest (fleet/compile-document "itonami.mith" %))]
    (is (= (digest source)
           (digest (-> source
                       (assoc "jobsDigest" (str "sha256:" (apply str (repeat 64 "e"))))
                       (assoc-in ["jobs" 0 "enabled"] false)))))
    (is (not= (digest source)
              (digest (assoc-in source ["jobs" 0 "scriptDigest"]
                                (str "sha256:" (apply str (repeat 64 "f")))))))
    (is (not= (digest source)
              (digest (assoc-in source ["jobs" 0 "scheduleDigest"]
                                (str "sha256:" (apply str (repeat 64 "f")))))))))

(deftest coding-admission-fails-closed
  (let [job {:effects [:scheduler/tick :agent/workspace-turn] :workdir "/tmp/work"}]
    (is (= :missing-workspace
           (fleet/coding-readiness job #{} {:exists? false :git? false :clean? false})))
    (is (= :not-git
           (fleet/coding-readiness job #{} {:exists? true :git? false :clean? false})))
    (is (= :dirty-workspace
           (fleet/coding-readiness job #{} {:exists? true :git? true :clean? false})))
    (is (= :unregistered-workspace
           (fleet/coding-readiness job #{} {:exists? true :git? true :clean? true})))
    (is (= :ready
           (fleet/coding-readiness job #{"/tmp/work"}
                                   {:exists? true :git? true :clean? true})))))

(deftest bpmn-migration-admission-is-operational-and-fail-closed
  (let [base-job {:enabled true :no-agent true :effects [:scheduler/tick :host/script-run]
                  :workdir "/tmp/work" :last-status "ok" :failure-streak 0}
        ready-facts {:script-present? true :workdir-present? true :active-execution? false}]
    (is (= :shadow-ready (fleet/bpmn-job-readiness base-job ready-facts)))
    (is (= :disabled (fleet/bpmn-job-readiness (assoc base-job :enabled false) ready-facts)))
    (is (= :active-execution
           (fleet/bpmn-job-readiness base-job (assoc ready-facts :active-execution? true))))
    (is (= :missing-script
           (fleet/bpmn-job-readiness base-job (assoc ready-facts :script-present? false))))
    (is (= :missing-workdir
           (fleet/bpmn-job-readiness base-job (assoc ready-facts :workdir-present? false))))
    (is (= :unobserved
           (fleet/bpmn-job-readiness (assoc base-job :last-status nil) ready-facts)))
    (is (= :unhealthy
           (fleet/bpmn-job-readiness (assoc base-job :last-status "error") ready-facts)))
    (is (= :unhealthy
           (fleet/bpmn-job-readiness (assoc base-job :failure-streak 1) ready-facts)))
    (is (= :bpmn-contract-required
           (fleet/bpmn-job-readiness (assoc base-job :no-agent false) ready-facts)))))

(deftest shadow-replay-needs-a-complete-builtin-terminal-receipt
  (let [receipt {:id "execution-1" :job_id "job-1" :source "builtin"
                 :status "completed" :claimed_at "2026-09-23T00:00:00Z"
                 :finished_at "2026-09-23T00:00:01Z"
                 :scheduled_instant "2026-09-23T00:00:00Z" :error nil}
        admit #(fleet/shadow-receipt-admission %1 "job-1" %2)]
    (is (= :admitted (admit :shadow-ready receipt)))
    (is (= :job-not-ready (admit :unhealthy receipt)))
    (is (= :missing-receipt (admit :shadow-ready nil)))
    (is (= :job-mismatch (admit :shadow-ready (assoc receipt :job_id "job-2"))))
    (is (= :not-scheduler-originated (admit :shadow-ready (assoc receipt :source "direct"))))
    (is (= :not-completed (admit :shadow-ready (assoc receipt :status "unknown"))))
    (is (= :not-completed (admit :shadow-ready (assoc receipt :status "running"))))
    (is (= :incomplete-receipt (admit :shadow-ready (assoc receipt :finished_at nil))))
    (is (= :incomplete-receipt (admit :shadow-ready (assoc receipt :id "../escape"))))
    (is (= :incomplete-receipt (admit :shadow-ready (assoc receipt :error "failure"))))))
