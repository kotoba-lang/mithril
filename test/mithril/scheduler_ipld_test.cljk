(ns mithril.scheduler-ipld-test
  (:require [cljs.test :refer [deftest is]]
            [mithril.bot :as bot]
            [mithril.checkpoint :as checkpoint]
            [mithril.checkpoint-ipld :as ipld]
            [mithril.checkpoint-ipld-fs :as local]
            [mithril.execution :as execution]
            [mithril.ipld-session :as primary]
            [mithril.scheduler-ipld :as scheduler-ipld]))

(def fs (js/require "node:fs"))
(def path (js/require "node:path"))
(def os (js/require "node:os"))
(def schema (checkpoint/schema (.readFileSync fs checkpoint/ontology-path "utf8")))
(def artifact (bot/compile-text
               "examples/governed-coding-bot.mith"
               (.readFileSync fs "examples/governed-coding-bot.mith" "utf8")))

(defn- state []
  (bot/start-run artifact {:id "scheduler-ipld-test" :workspace "/tmp"
                           :goal "verify causal coding checkpoints"}
                 "scheduler-ipld-test" 1000))
(defn- after-read [prior]
  (let [requested (bot/request-effect
                   prior {:action (get bot/action-by-label "workspace-inspect")
                          :confidence 10000}
                   #{:workspace/read} "scheduler-ipld-test" 1001)]
    (bot/apply-receipt
     (:state requested)
     {:format bot/receipt-format
      :effect-id (get-in requested [:effect :id])
      :status :completed :output-digest (execution/digest :inspected)}
     "scheduler-ipld-test" 1002)))
(defn- reason [f]
  (try (f) nil (catch :default error (:reason (ex-data error)))))

(deftest scheduler-states-form-a-verified-cid-chain-and-refuse-drift
  (let [directory (.mkdtempSync fs (.join path (.tmpdir os) "mithril-scheduler-ipld-"))]
    (try
      (let [store (local/open! directory)
            s0 (state)
            first (scheduler-ipld/record! store schema nil s0)
            s1 (after-read s0)
            second (scheduler-ipld/record! store schema s0 s1)
            saved (ipld/read! #(local/get-block store %) schema (:stateCid second))]
        (is (= 1 (:blocks first)))
        (is (= 2 (:blocks second)))
        (is (= [(:stateCid first)] (:parents saved)))
        (is (= s1 (:state saved)))
        (is (= (scheduler-ipld/witness store schema s1) second))
        (is (= :state-diverged
               (reason #(scheduler-ipld/witness store schema
                                                (assoc s1 :step 99)))))
        (is (= :state-diverged
               (reason #(scheduler-ipld/record! store schema
                                                (assoc s1 :step 99) s1))))
        (is (= :ref-conflict
               (reason #(scheduler-ipld/record! store schema nil s1)))))
      (finally (.rmSync fs directory #js {:recursive true :force true})))))

(deftest scheduler-receipts-must-match-causal-effects-and-terminal-head
  (let [directory (.mkdtempSync fs (.join path (.tmpdir os) "mithril-scheduler-receipts-"))]
    (try
      (let [store (local/open! directory)
            requested (bot/request-effect
                       (state) {:action (get bot/action-by-label "stop")
                                :confidence 10000}
                       #{:agent/stop} "scheduler-ipld-test" 1001)
            finished (bot/apply-receipt
                      (:state requested)
                      {:format bot/receipt-format
                       :effect-id (get-in requested [:effect :id])
                       :status :completed :output-digest (execution/digest :stopped)}
                      "scheduler-ipld-test" 1002)
            witness (scheduler-ipld/record! store schema nil finished)
            effect (last (:receipts finished))
            completed {:status "completed" :source "builtin"
                       :executionId "execution-1"
                       :scheduledInstant "2026-09-23T00:00:00Z"
                       :runStatus "completed" :step 1
                       :action "https://mithril.fund/id/action/stop"
                       :stateCid (:stateCid witness)
                       :semanticGraphDigest (:semanticGraphDigest witness)
                       :effectId (:effect-id effect)
                       :outputDigest (:output-digest effect)}
            terminal {:status "terminal" :source "builtin"
                      :executionId "execution-2"
                      :scheduledInstant "2026-09-23T01:00:00Z"
                      :runStatus "completed" :step 1
                      :stateCid (:stateCid witness)
                      :semanticGraphDigest (:semanticGraphDigest witness)
                      :effectId nil}
            rows [{:execution {:id "execution-1" :source "builtin"
                               :status "completed"
                               :scheduled_instant "2026-09-23T00:00:00Z"}
                   :receipt completed}
                  {:execution {:id "execution-2" :source "builtin"
                               :status "completed"
                               :scheduled_instant "2026-09-23T01:00:00Z"}
                   :receipt terminal}]
            verify #(scheduler-ipld/verify-occurrences! store schema finished %)]
        (is (= "verified" (:status (verify rows))))
        (is (= 1 (:completedEffects (verify rows))))
        (is (= finished (:state (scheduler-ipld/verify-from-receipts!
                                 store schema rows))))
        (is (= finished
               (:state (scheduler-ipld/recovery-state!
                        store schema rows (:profile-digest finished)
                        (:task-digest finished) (:run-id finished)
                        (execution/digest finished)))))
        (is (= :recovery-binding-mismatch
               (reason #(scheduler-ipld/recovery-state!
                         store schema rows (:profile-digest finished)
                         (:task-digest finished) (:run-id finished)
                         (execution/digest :different)))))
        (is (= :effect-or-cid-mismatch
               (reason #(scheduler-ipld/verify-from-receipts!
                         store schema
                         (assoc-in rows [0 :receipt :outputDigest] "sha256:wrong")))))
        (is (= :effect-or-cid-mismatch
               (reason #(verify (assoc-in rows [0 :receipt :effectId]
                                          "sha256:wrong")))))
        (is (= :terminal-or-head-mismatch
               (reason #(verify (assoc-in rows [1 :receipt :stateCid]
                                          "bafyreifake")))))
        (is (= :scheduler-series-mismatch
               (reason #(verify (assoc-in rows [0 :execution :source]
                                          "direct"))))))
      (finally (.rmSync fs directory #js {:recursive true :force true})))))

(deftest primary-scheduler-receipt-requires-request-and-result-cid-phases
  (let [directory (.mkdtempSync fs (.join path (.tmpdir os) "mithril-primary-receipts-"))]
    (try
      (let [store (local/open! (.join path directory "blocks"))
            state-path (.join path directory "run.edn")
            requested (bot/request-effect
                       (state) {:action (get bot/action-by-label "stop")
                                :confidence 10000}
                       #{:agent/stop} "scheduler-ipld-test" 1001)
            pending (:state requested)
            c1 (primary/save! store schema state-path nil pending)
            finished (bot/apply-receipt
                      pending {:format bot/receipt-format
                               :effect-id (get-in requested [:effect :id])
                               :status :completed
                               :output-digest (execution/digest :stopped)}
                      "scheduler-ipld-test" 1002)
            c2 (primary/save! store schema state-path c1 finished)
            effect (last (:receipts finished))
            receipt {:status "completed" :source "builtin"
                     :executionId "execution-1"
                     :scheduledInstant "2026-09-23T00:00:00Z"
                     :runStatus "completed" :step 1
                     :action "https://mithril.fund/id/action/stop"
                     :stateCid (:stateCid c2)
                     :semanticGraphDigest (:semanticGraphDigest c2)
                     :effectId (:effect-id effect)
                     :outputDigest (:output-digest effect)}
            rows [{:execution {:id "execution-1" :source "builtin"
                               :status "completed"
                               :scheduled_instant "2026-09-23T00:00:00Z"}
                   :receipt receipt}]
            verify #(scheduler-ipld/verify-primary-occurrences!
                     store schema state-path %)]
        (is (= 2 (:semanticBlocks (verify rows))))
        (is (= finished (:state (verify rows))))
        (is (= :primary-effect-or-cid-mismatch
               (reason #(verify (assoc-in rows [0 :receipt :effectId]
                                          "sha256:wrong")))))
        (is (= :primary-scheduler-series-mismatch
               (reason #(verify (assoc-in rows [0 :execution :source]
                                          "direct"))))))
      (finally (.rmSync fs directory #js {:recursive true :force true})))))
