(ns mithril.checkpoint-ipld-fs-test
  (:require [cljs.test :refer [deftest is]]
            [mithril.bot :as bot]
            [mithril.checkpoint :as checkpoint]
            [mithril.checkpoint-ipld :as ipld-checkpoint]
            [mithril.checkpoint-ipld-fs :as local]))

(def fs (js/require "node:fs"))
(def path (js/require "node:path"))
(def os (js/require "node:os"))
(defn read-text [file] (.readFileSync fs file "utf8"))
(defn schema [] (checkpoint/schema (read-text checkpoint/ontology-path)))
(defn state []
  (bot/start-run (bot/compile-text "examples/governed-coding-bot.mith"
                                   (read-text "examples/governed-coding-bot.mith"))
                 {:id "local-ipld" :workspace "/tmp" :goal "merge two facts"}
                 "local-ipld" 1000))
(defn reason [f]
  (try (f) nil (catch :default error
                 (or (:reason (ex-data error)) (:type (ex-data error))))))

(deftest private-blocks-and-branch-refs-survive-reopen-and-reject-stale-cas
  (let [dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipld-fs-"))]
    (try
      (let [schema (schema)
            store (local/open! dir)
            base (local/import-state! store schema "base" (state))
            _ (local/fork-ref! store "base" "left")
            _ (local/fork-ref! store "base" "right")
            left (local/advance-fact! store schema "left" :review/approved)
            right (local/advance-fact! store schema "right" :source/verified)
            merged (local/merge-refs! store schema "base" "left" "right" "merged")
            reopened (local/open! dir)
            value (ipld-checkpoint/read!
                   #(local/get-block reopened %) schema (local/read-ref reopened "merged"))]
        (is (= base (local/read-ref reopened "base")))
        (is (= merged (local/read-ref reopened "merged")))
        (is (= 4 (:blocks (local/verify-ref! reopened schema "merged"))))
        (is (set? (get-in value [:state :facts])))
        (is (contains? (get-in value [:state :facts]) :review/approved))
        (is (contains? (get-in value [:state :facts]) :source/verified))
        (is (= :ref-conflict
               (reason #(local/advance-ref! reopened schema "left" base right))))
        (is (= :noncausal-ref-advance
               (reason #(local/advance-ref! reopened schema "left" left base))))
        (is (= :ref-exists
               (reason #(local/fork-ref! reopened "base" "left"))))
        (is (= :block-cid-mismatch
               (reason #(local/put-block! reopened left
                                          (local/get-block reopened base)))))
        (is (= left (local/advance-fact!
                     reopened schema "left" :review/approved))
            "reasserting one fact is idempotent")
        (is (= left (local/read-ref reopened "left")))
        (is (= right (local/read-ref reopened "right"))))
      (finally (.rmSync fs dir #js {:recursive true :force true})))))

(deftest cid-proof-cache-reuses-unchanged-ancestors-but-rechecks-stored-bytes
  (let [dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipld-proof-cache-"))]
    (try
      (let [checked-schema (schema)
            store (local/open! dir)
            cache (ipld-checkpoint/history-verification-cache)
            base (local/import-state! store checked-schema "main" (state))
            semantic-reads (atom 0)
            original-read ipld-checkpoint/read!]
        (with-redefs [ipld-checkpoint/read!
                      (fn [& args]
                        (swap! semantic-reads inc)
                        (apply original-read args))]
          (is (= 1 (:blocks (local/verify-ref-cached!
                             store checked-schema "main" cache))))
          (is (= 1 @semantic-reads))
          (is (= 1 (:blocks (local/verify-ref-cached!
                             store checked-schema "main" cache))))
          (is (= 1 @semantic-reads)
              "an exact stored-byte match does not repeat OWL/SHACL parsing")
          (let [child (local/advance-fact! store checked-schema "main"
                                           :review/approved)
                before @semantic-reads]
            (is (= 2 (:blocks (local/verify-ref-cached!
                               store checked-schema "main" cache))))
            (is (= (inc before) @semantic-reads)
                "only the new child needs semantic validation")
            (is (= 2 (:blocks (local/verify-ref!
                               store checked-schema "main"))))
            (is (= :invalid-verification-cache
                   (reason #(local/verify-ref-cached!
                             store checked-schema "main" (js/Object.)))))
            (is (= :invalid-node
                   (reason #(local/verify-ref-cached!
                             store (assoc checked-schema
                                          :ontology-digest "sha256:changed")
                             "main" cache))))
            (.writeFileSync fs (.join path dir "blocks" base)
                            (local/get-block store child))
            (is (= :ipld/cid-mismatch
                   (reason #(local/verify-ref-cached!
                             store checked-schema "main" cache))))
            (is (= :ipld/cid-mismatch
                   (reason #(local/verify-ref! store checked-schema "main")))))))
      (finally (.rmSync fs dir #js {:recursive true :force true})))))

(deftest upgrade-ref-refuses-a-source-head-that-advanced-during-reencoding
  (let [dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipld-upgrade-"))]
    (try
      (let [schema (schema)
            store (local/open! dir)
            base (local/import-state! store schema "source" (state))
            original-put ipld-checkpoint/put!
            moved? (atom false)]
        (is (= :ref-conflict
               (reason #(with-redefs
                          [ipld-checkpoint/put!
                           (fn [& args]
                             (let [id (apply original-put args)]
                               (when (compare-and-set! moved? false true)
                                 (local/advance-fact! store schema "source"
                                                      :source/advanced))
                               id))]
                          (local/upgrade-ref-v7! store schema "source" "new")))))
        (is @moved?)
        (is (not= base (local/read-ref store "source")))
        (is (false? (local/ref-exists? store "new"))))
      (finally (.rmSync fs dir #js {:recursive true :force true})))))
