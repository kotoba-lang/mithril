(ns mithril.cli
  (:require [mithril.compiler :as compiler]
            [mithril.bot :as bot]
            [mithril.web :as web]))

(defn- usage! []
  (println "usage:")
  (println "  mithril compile <program.mith|program.mithril>")
  (println "  mithril compile-ontology <ontology.mith|ontology.mithril>")
  (println "  mithril compile-library <library.mith|library.mithril>")
  (println "  mithril compile-bot <profile.mith|profile.mithril>")
  (println "  mithril compile-web <app.mith|app.mithril> <library.mith>...")
  (println "  mithril request <app.mith|app.mithril> <library.mith> <METHOD> <PATH>")
  (js/process.exit 2))

(defn- keyword-string [x]
  (if-let [ns (namespace x)] (str ns "/" (name x)) (name x)))

(defn- json-safe [x]
  (cond
    (keyword? x) (keyword-string x)
    (map? x) (into {} (map (fn [[k v]] [(if (keyword? k) (keyword-string k) k)
                                         (json-safe v)]) x))
    (vector? x) (mapv json-safe x)
    (set? x) (mapv json-safe (sort-by pr-str x))
    :else x))

(defn- read-text [path]
  (.readFileSync (js/require "fs") path "utf8"))

(defn- compile-library [path]
  (compiler/compile-library-text path (read-text path)))

(defn- compile-web [path library-paths]
  (compiler/compile-web-text path
                             (read-text path)
                             (mapv compile-library library-paths)))

(defn- print-json [value]
  (println (.stringify js/JSON (clj->js (json-safe value)) nil 2)))

(let [[command path & args] *command-line-args*]
  (try
    (case command
      "compile"
      (if (and path (empty? args))
        (print-json (compiler/compile-text path (read-text path)))
        (usage!))

      "compile-ontology"
      (if (and path (empty? args))
        (print-json (compiler/compile-ontology-text path (read-text path)))
        (usage!))

      "compile-library"
      (if (and path (empty? args))
        (print-json (compile-library path))
        (usage!))

      "compile-bot"
      (if (and path (empty? args))
        (print-json (bot/compile-text path (read-text path)))
        (usage!))

      "compile-web"
      (if (and path (seq args))
        (print-json (compile-web path args))
        (usage!))

      "request"
      (let [[library-path method request-path & extra] args]
        (if (and path library-path method request-path (empty? extra))
          (print-json (web/dispatch (compile-web path [library-path])
                                    {:method method :path request-path}))
          (usage!)))

      (usage!))
    (catch :default e
      (println (str "REFUSE\t" (or (some-> e ex-data :mithril/error name) "compile-error")
                    "\t" (.-message e)))
      (js/process.exit 1))))
