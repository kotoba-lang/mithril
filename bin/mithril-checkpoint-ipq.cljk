#!/usr/bin/env kbb
(ns mithril.checkpoint-ipq-cli
  (:require [mithril.checkpoint :as checkpoint]
            [mithril.checkpoint-ipq :as checkpoint-ipq]
            [mithril.checkpoint-ipld-fs :as local]))

(def fs (js/require "node:fs"))
(def path (js/require "node:path"))

(defn- refuse! [reason]
  (throw (ex-info "Mithril checkpoint IPQ CLI refused" {:reason reason})))

(defn- absolute! [value]
  (when-not (and (string? value) (.isAbsolute path value))
    (refuse! :invalid-path))
  value)

(defn- schema []
  (checkpoint/schema (.readFileSync fs checkpoint/ontology-path "utf8")))

(let [[command & args] *command-line-args*]
  (try
    (case command
      "export"
      (let [[directory ref output & extra] args]
        (when (or (seq extra) (not directory) (not ref) (not output))
          (refuse! :invalid-arguments))
        (absolute! directory)
        (absolute! output)
        (when-not (.existsSync fs directory) (refuse! :missing-store))
        (let [store (local/open! directory)
              head (local/read-ref store ref)
              result (checkpoint-ipq/export-history! store (schema) head)]
          (.writeFileSync fs output (:bytes result) #js {:flag "wx" :mode 384})
          (println (.stringify js/JSON
                             (clj->js {:status "exported" :root head
                                       :blocks (:blocks result)})))))
      "verify"
      (let [[archive root & extra] args]
        (when (or (seq extra) (not archive) (not root))
          (refuse! :invalid-arguments))
        (absolute! archive)
        (when-not (.existsSync fs archive) (refuse! :missing-car))
        (when (> (.-size (.statSync fs archive)) checkpoint-ipq/max-car-bytes)
          (refuse! :car-over-limit))
        (let [result (checkpoint-ipq/verify-history-car!
                      (schema) root (.readFileSync fs archive))]
          (println (.stringify js/JSON
                             (clj->js {:status "verified"
                                       :root (:root result)
                                       :blocks (:blocks result)
                                       :semanticGraphDigest
                                       (:semantic-graph-digest result)})))))
      "import"
      (let [[directory ref archive root & extra] args]
        (when (or (seq extra) (not directory) (not ref)
                  (not archive) (not root))
          (refuse! :invalid-arguments))
        (absolute! directory)
        (absolute! archive)
        (when-not (.existsSync fs archive) (refuse! :missing-car))
        (when (> (.-size (.statSync fs archive)) checkpoint-ipq/max-car-bytes)
          (refuse! :car-over-limit))
        (let [store (local/open! directory)
              result (checkpoint-ipq/import-history!
                      store (schema) ref root (.readFileSync fs archive))]
          (println (.stringify js/JSON
                             (clj->js {:status "imported"
                                       :root (:root result)
                                       :blocks (:blocks result)
                                       :semanticGraphDigest
                                       (:semantic-graph-digest result)})))))
      (refuse! :invalid-command))
    (catch :default error
      (println (str "REFUSE\t" (or (some-> error ex-data :reason name)
                                   (some-> error ex-data :type name)
                                   "checkpoint-ipq-error")))
      (set! (.-exitCode js/process) 1))))
