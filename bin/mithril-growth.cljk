#!/usr/bin/env kbb
(ns mithril.growth-cli
  (:require [clojure.string :as str]
            [mithril.growth :as growth]
            [mithril.openrouter-jev :as jev]))

(def fs (js/require "node:fs"))
(def path (js/require "node:path"))
(def cp (js/require "node:child_process"))

(defn- usage! []
  (println "usage: mithril-growth decide <profile.mith> <observation.json> <receipt.jsonl>")
  (js/process.exit 2))

(defn- read-text [p] (.readFileSync fs p "utf8"))

(defn- read-key []
  (or (let [value (.-OPENROUTER_API_KEY js/process.env)]
        (when-not (str/blank? (str value)) value))
      (try
        (str/trim (.execFileSync cp "security"
                                 #js ["find-generic-password" "-s" "gftd.openrouter"
                                      "-a" "OPENROUTER_API_KEY" "-w"]
                                 #js {:encoding "utf8" :stdio #js ["ignore" "pipe" "ignore"]}))
        (catch :default _ nil))))

(defn- keyword-string [value]
  (if-let [ns (namespace value)] (str ns "/" (name value)) (name value)))

(defn- json-safe [value]
  (cond
    (keyword? value) (keyword-string value)
    (map? value) (into {} (map (fn [[k v]] [(if (keyword? k) (keyword-string k) k)
                                             (json-safe v)]) value))
    (vector? value) (mapv json-safe value)
    (set? value) (mapv json-safe (sort-by pr-str value))
    :else value))

(defn- encode [value]
  (.stringify js/JSON (clj->js (json-safe value))))

(defn- refuse! [error]
  (println (str "REFUSE\t" (or (some-> error ex-data :mithril/error name) "growth-error")
                "\t" (.-message error)))
  (js/process.exit 1))

(let [[command profile-path observation-path receipt-path & extra] *command-line-args*]
  (if-not (and (= "decide" command) profile-path observation-path receipt-path (empty? extra))
    (usage!)
    (try
      (let [artifact (growth/compile-text profile-path (read-text profile-path))
            observation (js->clj (js/JSON.parse (read-text observation-path)) :keywordize-keys true)
            plan (growth/prepare-request artifact observation)
            started (.now js/Date)]
        (-> (jev/decide! plan (read-key))
            (.then (fn [{:keys [model-result audit]}]
                     (let [receipt (assoc (growth/admit-decision artifact observation model-result)
                                          :decision-ms (- (.now js/Date) started)
                                          :audit audit)
                           line (encode receipt)]
                       (.mkdirSync fs (.dirname path receipt-path) #js {:recursive true})
                       (.appendFileSync fs receipt-path (str line "\n") "utf8")
                       (println line))))
            (.catch refuse!)))
      (catch :default error (refuse! error)))))
