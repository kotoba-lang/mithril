#!/usr/bin/env kbb
(ns mithril.checkpoint-ipq-cache-bench
  "Compare cold and warm imports of one already verified Mithril history CAR.
  Each import targets a fresh local store; both are independently reverified."
  (:require [mithril.bot :as bot]
            [mithril.checkpoint :as checkpoint]
            [mithril.checkpoint-ipq :as checkpoint-ipq]
            [mithril.checkpoint-ipld :as checkpoint-ipld]
            [mithril.checkpoint-ipld-fs :as local]))

(def fs (js/require "node:fs"))
(def os (js/require "node:os"))
(def path (js/require "node:path"))

(let [[source-dir source-ref & extra] *command-line-args*]
  (when (or (seq extra)
            (and (some? source-dir)
                 (not (and (string? source-dir) (.isAbsolute path source-dir)
                           (string? source-ref)))))
    (throw (ex-info "expected no arguments or absolute source-dir and source-ref"
                    {:reason :invalid-arguments})))
  (let [fixture? (nil? source-dir)
        source-dir (or source-dir
                       (.mkdtempSync fs (.join path (.tmpdir os)
                                                "mithril-ipq-cache-source-")))
        source-ref (or source-ref "source")
        cold-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-cache-cold-"))
        warm-dir (.mkdtempSync fs (.join path (.tmpdir os) "mithril-ipq-cache-warm-"))]
    (try
      (when fixture?
        (let [program (bot/compile-text
                       "examples/governed-coding-bot.mith"
                       (.readFileSync fs "examples/governed-coding-bot.mith" "utf8"))
              state (bot/start-run program
                                   {:id "ipq-cache-bench" :workspace "/tmp"
                                    :goal "verify exact-CAR proof reuse"}
                                   "ipq-cache-bench" 1000)
              schema (checkpoint/schema
                      (.readFileSync fs checkpoint/ontology-path "utf8"))]
          (local/import-state! (local/open! source-dir) schema source-ref state)))
      (let [source (local/open! source-dir)
            head (local/read-ref source source-ref)
            schema (checkpoint/schema (.readFileSync fs checkpoint/ontology-path "utf8"))
            car-bytes (:bytes (checkpoint-ipq/export-history! source schema head))
            cache (checkpoint-ipq/verification-cache)
            checks (atom 0)
            verify-nodes checkpoint-ipld/verify-history-nodes!
            [cold cold-ms warm warm-ms]
            (with-redefs [checkpoint-ipld/verify-history-nodes!
                          (fn [& args]
                            (swap! checks inc)
                            (apply verify-nodes args))]
              (let [start (.now js/Date)
                    cold (checkpoint-ipq/import-history!
                          (local/open! cold-dir) schema "imported" head car-bytes cache)
                    cold-ms (- (.now js/Date) start)
                    start (.now js/Date)
                    warm (checkpoint-ipq/import-history!
                          (local/open! warm-dir) schema "imported" head car-bytes cache)
                    warm-ms (- (.now js/Date) start)]
                [cold cold-ms warm warm-ms]))
            cold-verified (local/verify-ref! (local/open! cold-dir) schema "imported")
            warm-verified (local/verify-ref! (local/open! warm-dir) schema "imported")]
        (when-not (and (= 1 @checks)
                       (= head (:root cold) (:root warm)
                          (:head cold-verified) (:head warm-verified))
                       (= (:semantic-graph-digest cold)
                          (:semantic-graph-digest warm)))
          (throw (ex-info "cache benchmark proof mismatch"
                          {:reason :cache-proof-mismatch})))
        (println (.stringify
                  js/JSON
                  (clj->js {:status "verified"
                            :root head
                            :blocks (:blocks cold)
                            :carBytes (.-length car-bytes)
                            :semanticChecksDuringImports @checks
                            :coldImportMs cold-ms
                            :warmImportMs warm-ms
                            :independentReverify true}))))
      (finally
        (.rmSync fs cold-dir #js {:recursive true :force true})
        (.rmSync fs warm-dir #js {:recursive true :force true})
        (when fixture?
          (.rmSync fs source-dir #js {:recursive true :force true}))))))
