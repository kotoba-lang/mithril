#!/usr/bin/env kbb
(ns mithril.hermes-cli
  (:require [cljs.reader :as reader]
            [clojure.string :as str]
            [mithril.bot :as bot]
            [mithril.checkpoint :as checkpoint]
            [mithril.checkpoint-ipld-fs :as ipld-store]
            [mithril.decision-proof :as decision-proof]
            [mithril.execution :as execution]
            [mithril.hermes :as hermes]
            [mithril.ipld-session :as ipld-session]
            [mithril.openrouter-jev :as jev]))

(def fs (js/require "node:fs"))
(def path (js/require "node:path"))
(def cp (js/require "node:child_process"))
(def os (js/require "node:os"))

(defn- usage! []
  (println "usage: mithril-hermes tick <profile.mith> <task.json> <state.edn> <owner> <grants.csv> <shadow|execute|semantic-execute|ipld-execute> [coding-tools.json] [jev]")
  (println "       mithril-hermes migrate <profile.mith> <task.json> <state.edn> <owner>")
  (println "       mithril-hermes semantic-import <profile.mith> <task.json> <state.edn> <owner>")
  (println "       mithril-hermes semantic-restore <state.edn>")
  (println "       mithril-hermes semantic-verify <state.edn>")
  (println "       mithril-hermes reconcile <profile.mith> <task.json> <state.edn> <owner> <coding-tools.json>")
  (println "       mithril-hermes profile-digest <coding-tools.json>")
  (js/process.exit 2))

(defn- read-text [file] (.readFileSync fs file "utf8"))

(defn- read-key []
  (or (let [value (.-OPENROUTER_API_KEY js/process.env)]
        (when-not (str/blank? (str value)) value))
      (try
        (let [login-keychain (.join path (.-homedir (.userInfo os))
                                    "Library" "Keychains" "login.keychain-db")]
          (str/trim
           (.execFileSync cp "security"
                          #js ["find-generic-password" "-s" "gftd.openrouter"
                               "-a" "OPENROUTER_API_KEY" "-w" login-keychain]
                          #js {:encoding "utf8" :stdio #js ["ignore" "pipe" "ignore"]})))
        (catch :default _ nil))))

(defn- keyword-string [value]
  (if-let [ns (namespace value)] (str ns "/" (name value)) (name value)))

(defn- json-safe [value]
  (cond
    (keyword? value) (keyword-string value)
    (map? value) (into {} (map (fn [[k v]] [(if (keyword? k) (keyword-string k) k)
                                             (json-safe v)]) value))
    (vector? value) (mapv json-safe value)
    (set? value) (mapv json-safe (sort-by pr-str value))
    :else value))

(defn- json-line [value]
  (.stringify js/JSON (clj->js (json-safe value))))

(defn- write-state! [file state]
  (let [parent (.dirname path file)
        temporary (str file ".tmp-" (.-pid js/process))]
    (.mkdirSync fs parent #js {:recursive true})
    (.writeFileSync fs temporary (pr-str state)
                    #js {:encoding "utf8" :mode 384})
    (.renameSync fs temporary file)))

(defn- semantic-head-path [state-path] (str state-path ".semantic-head"))
(defn- semantic-block-dir [state-path] (str state-path ".semantic-blocks"))

(defn- semantic-load
  ([state-path schema] (semantic-load state-path schema true))
  ([state-path schema require-projection?]
  (let [head-path (semantic-head-path state-path)]
    (cond
      (.existsSync fs head-path)
      (let [digest (str/trim (read-text head-path))
            load-block (fn [id]
                         (when-not (re-matches #"sha256:[0-9a-f]{64}" (str id))
                           (throw (ex-info "invalid semantic block identity"
                                           {:mithril/error :mithril.checkpoint/invalid-head})))
                         (let [file (.join path (semantic-block-dir state-path) (subs id 7))]
                           (when-not (.existsSync fs file)
                             (throw (ex-info "semantic block does not resolve"
                                             {:mithril/error :mithril.checkpoint/missing-block})))
                           (let [block (reader/read-string (read-text file))]
                             (checkpoint/verify schema {:digest id :block block})
                             block)))
            block (load-block digest)]
        (loop [current block depth 0]
          (when (> depth 256)
            (throw (ex-info "semantic ancestry exceeds bounded bot history"
                            {:mithril/error :mithril.checkpoint/ancestry-limit})))
          (when-let [parent-id (:parent-digest current)]
            (let [parent (load-block parent-id)]
              (when-not (or (and (= (get-in parent [:state :run-id])
                                     (get-in current [:state :run-id]))
                                 (= (get-in parent [:state :profile-digest])
                                    (get-in current [:state :profile-digest]))
                                 (= (get-in parent [:state :task-digest])
                                    (get-in current [:state :task-digest]))
                                 (<= (get-in parent [:state :step])
                                     (get-in current [:state :step])))
                            (and (contains? #{:completed :held}
                                            (get-in parent [:state :status]))
                                 (not= (get-in parent [:state :run-id])
                                       (get-in current [:state :run-id]))
                                 (= 0 (get-in current [:state :step]))))
                (throw (ex-info "semantic ancestry changed run binding or step"
                                {:mithril/error :mithril.checkpoint/invalid-ancestry})))
              (recur parent (inc depth)))))
        (let [verified (checkpoint/verify schema {:digest digest :block block})]
          (when (and require-projection?
                     (.existsSync fs state-path)
                     (not= (:state block) (reader/read-string (read-text state-path))))
            (throw (ex-info "legacy state projection differs from semantic head"
                            {:mithril/error :mithril.checkpoint/state-diverged})))
          {:digest digest :state (:state (:block verified))}))

      (.existsSync fs state-path)
      (throw (ex-info "legacy checkpoint requires explicit migration before semantic execution"
                      {:mithril/error :mithril.checkpoint/legacy-state}))

      :else nil))))

(defn- semantic-save! [state-path schema previous state]
  (let [{:keys [digest block]} (checkpoint/build schema state (:digest previous))
        head-path (semantic-head-path state-path)
        observed (when (.existsSync fs head-path) (str/trim (read-text head-path)))
        dir (semantic-block-dir state-path)
        file (.join path dir (subs digest 7))
        temp-head (str head-path ".tmp-" (.-pid js/process))]
    (when-not (= observed (:digest previous))
      (throw (ex-info "semantic head changed before checkpoint commit"
                      {:mithril/error :mithril.checkpoint/head-conflict})))
    (.mkdirSync fs dir #js {:recursive true :mode 448})
    (if (.existsSync fs file)
      (when-not (= block (reader/read-string (read-text file)))
        (throw (ex-info "existing checkpoint block differs"
                        {:mithril/error :mithril.checkpoint/block-conflict})))
      (.writeFileSync fs file (pr-str block) #js {:encoding "utf8" :flag "wx" :mode 384}))
    (.writeFileSync fs temp-head digest #js {:encoding "utf8" :mode 384})
    (.renameSync fs temp-head head-path)
    (write-state! state-path state)
    {:digest digest :state state}))

(defn- append-audit! [state-path audit]
  (let [file (str state-path ".audit.jsonl")]
    (.appendFileSync fs file (str (json-line audit) "\n") "utf8")))

(defn- process-alive? [pid]
  (try
    (.kill js/process pid 0)
    true
    (catch :default error
      ;; EPERM proves a process owns the PID even when we cannot signal it.
      ;; Only ESRCH is evidence that the lock owner is gone.
      (not= "ESRCH" (.-code error)))))

(defn- lock-owner-pid [lock-path]
  (try
    (let [value (str/trim (read-text lock-path))]
      (when (boolean (re-matches #"[1-9][0-9]*" value))
        (js/Number value)))
    (catch :default _ nil)))

(defn- create-lock! [lock-path]
  (let [fd (.openSync fs lock-path "wx" 384)]
    (.writeFileSync fs fd (str (.-pid js/process)) "utf8")
    {:fd fd :path lock-path}))

(defn- acquire-lock! [state-path]
  (let [lock-path (str state-path ".lock")]
    (.mkdirSync fs (.dirname path state-path) #js {:recursive true})
    (try
      (create-lock! lock-path)
      (catch :default first-error
        (let [owner-pid (lock-owner-pid lock-path)]
          (when (or (nil? owner-pid) (process-alive? owner-pid))
            (throw (ex-info "another Mithril tick holds the state lock"
                            {:mithril/error :mithril.hermes/state-locked
                             :owner-pid owner-pid}
                            first-error)))
          ;; rename is the claim: with concurrent recovery only one process can
          ;; move the observed stale inode. The others fail closed and retry on
          ;; their next outer-loop tick.
          (let [stale-path (str lock-path ".stale-" owner-pid "-" (.-pid js/process))]
            (try
              (.renameSync fs lock-path stale-path)
              (let [lock (create-lock! lock-path)]
                (try (.unlinkSync fs stale-path) (catch :default _ nil))
                (assoc lock :recovered-pid owner-pid))
              (catch :default recovery-error
                (throw (ex-info "another Mithril tick won stale-lock recovery"
                                {:mithril/error :mithril.hermes/state-locked
                                 :owner-pid owner-pid}
                                recovery-error))))))))))

(defn- release-lock! [{:keys [fd path]}]
  (try (.closeSync fs fd) (catch :default _ nil))
  (try (.unlinkSync fs path) (catch :default _ nil)))

(defn- load-or-start [artifact task state-path owner now]
  (bot/resume-or-start artifact task
                       (when (.existsSync fs state-path)
                         (reader/read-string (read-text state-path)))
                       owner now))

(defn- deterministic-singleton [state]
  (let [actions (bot/available-actions state)]
    (when-not (= 1 (count actions))
      (throw (ex-info "deterministic singleton requires exactly one admitted action"
                      {:mithril/error :mithril.hermes/invalid-singleton})))
    {:admitted {:action (first actions) :confidence 10000
                :probabilities {(:label (first actions)) 1.0}
                :model {:kind :deterministic/singleton}}
     :audit {:source "deterministic-singleton"}}))

(defn- deterministic-coding [state]
  (let [action (bot/deterministic-coding-action state)]
    {:admitted {:action action :confidence 10000
                :probabilities {(:label action) 1.0}
                :model {:kind :deterministic/ontology-workflow}}
     :audit {:source "deterministic-ontology-workflow"}}))

(defn- decide! [state owner now coding? decision-mode observe-model!]
  (let [actions (bot/available-actions state)]
    (cond
      (>= (:step state) (get-in state [:policy :max-steps]))
      (js/Promise.resolve
       {:held (bot/hold-step-budget state owner now)
        :reason :mithril.bot/step-budget})

      (empty? actions)
      (js/Promise.reject
       (ex-info "no action is available" {:mithril/error :mithril.hermes/no-action}))

      (and coding? (not= "jev" decision-mode))
      (js/Promise.resolve (deterministic-coding state))

      (= 1 (count actions))
      (js/Promise.resolve (if coding? (deterministic-coding state)
                              (deterministic-singleton state)))

      :else
      (let [plan (bot/prepare-request state owner (inc now))]
        (-> (jev/decide! plan (read-key))
            (.then (fn [{:keys [model-result audit]}]
                     (observe-model! audit)
                     (assoc (bot/resolve-decision state model-result owner (+ now 2))
                            :audit audit :model-result model-result))))))))

(defn- refuse! [error]
  (let [data (loop [current error depth 0]
               (when (and current (< depth 4))
                 (let [value (or (ex-data current) (.-data current))]
                   (if (and (map? value) (:mithril/error value))
                     value
                     (recur (.-cause current) (inc depth))))))]
    (println (str "REFUSE\t" (or (some-> data :mithril/error name) "hermes-error")
                  "\t" (.-message error)
                  (when-let [reason (:reason data)]
                    (str "\treason=" (name reason)))))
    (set! (.-exitCode js/process) 1)))

(defn- migrate-checkpoint! [profile-path task-path state-path owner]
  (let [lock (try (acquire-lock! state-path) (catch :default error (refuse! error) nil))]
    (when lock
      (try
        (when-not (.existsSync fs state-path)
          (throw (ex-info "checkpoint migration requires an existing state"
                          {:mithril/error :mithril.hermes/missing-checkpoint})))
        (let [artifact (bot/compile-text profile-path (read-text profile-path))
              task (js->clj (js/JSON.parse (read-text task-path)) :keywordize-keys true)
              state (reader/read-string (read-text state-path))
              now (.now js/Date)
              run (bot/resume-or-start artifact task state owner now)]
          (case (:disposition run)
            :migrated
            (let [migrated (:state run)]
              (write-state! state-path migrated)
              (append-audit! state-path
                             {:at (.toISOString (js/Date.))
                              :status :checkpoint-migrated
                              :run-id (:run-id migrated)
                              :step (:step migrated)
                              :bpmn-definition (get-in migrated [:bpmn :definition])
                              :bpmn-token-at
                              (get-in migrated [:bpmn :token-state :bpmn/tokens 0 :bpmn/at])})
              (println (json-line {:status :checkpoint-migrated
                                   :run-id (:run-id migrated)
                                   :step (:step migrated)
                                   :run-status (:status migrated)})))

            :resumed
            (println (json-line {:status :already-current
                                 :run-id (get-in run [:state :run-id])
                                 :step (get-in run [:state :step])
                                 :run-status (get-in run [:state :status])}))

            (throw (ex-info "checkpoint is not a running migratable state"
                            {:mithril/error :mithril.hermes/migration-not-required
                             :disposition (:disposition run)}))))
        (catch :default error (refuse! error))
        (finally (release-lock! lock))))))

(defn- semantic-import! [profile-path task-path state-path owner]
  (let [lock (try (acquire-lock! state-path) (catch :default error (refuse! error) nil))]
    (when lock
      (try
        (when-not (.existsSync fs state-path)
          (throw (ex-info "semantic import requires an existing checkpoint"
                          {:mithril/error :mithril.checkpoint/missing-state})))
        (when (.existsSync fs (semantic-head-path state-path))
          (throw (ex-info "semantic import refuses an existing semantic head"
                          {:mithril/error :mithril.checkpoint/already-imported})))
        (let [schema (checkpoint/schema (read-text checkpoint/ontology-path))
              artifact (bot/compile-text profile-path (read-text profile-path))
              task (js->clj (js/JSON.parse (read-text task-path)) :keywordize-keys true)
              saved (reader/read-string (read-text state-path))
              run (bot/resume-or-start artifact task saved owner (.now js/Date))]
          (when-not (contains? #{:resumed :terminal} (:disposition run))
            (throw (ex-info "legacy state must be migrated before semantic import"
                            {:mithril/error :mithril.checkpoint/not-current
                             :disposition (:disposition run)})))
          (when-not (= (dissoc saved :lease) (dissoc (:state run) :lease))
            (throw (ex-info "import cannot change legacy checkpoint semantics"
                            {:mithril/error :mithril.checkpoint/state-changed})))
          (let [committed (semantic-save! state-path schema nil saved)]
            (append-audit! state-path
                           {:at (.toISOString (js/Date.)) :status :semantic-imported
                            :run-id (:run-id saved) :step (:step saved)
                            :checkpoint-digest (:digest committed)})
            (println (json-line {:status :semantic-imported
                                 :run-id (:run-id saved)
                                 :step (:step saved)
                                 :checkpoint-digest (:digest committed)}))))
        (catch :default error (refuse! error))
        (finally (release-lock! lock))))))

(defn- semantic-restore! [state-path]
  (let [lock (try (acquire-lock! state-path) (catch :default error (refuse! error) nil))]
    (when lock
      (try
        (when-not (.existsSync fs (semantic-head-path state-path))
          (throw (ex-info "semantic restore requires an existing head"
                          {:mithril/error :mithril.checkpoint/missing-head})))
        (let [schema (checkpoint/schema (read-text checkpoint/ontology-path))
              previous (semantic-load state-path schema false)]
          (write-state! state-path (:state previous))
          (append-audit! state-path
                         {:at (.toISOString (js/Date.)) :status :semantic-projection-restored
                          :checkpoint-digest (:digest previous)
                          :run-id (get-in previous [:state :run-id])})
          (println (json-line {:status :semantic-projection-restored
                               :checkpoint-digest (:digest previous)})))
        (catch :default error (refuse! error))
        (finally (release-lock! lock))))))

(defn- semantic-verify! [state-path]
  (let [lock (try (acquire-lock! state-path) (catch :default error (refuse! error) nil))]
    (when lock
      (try
        (when-not (.existsSync fs (semantic-head-path state-path))
          (throw (ex-info "semantic verification requires an existing head"
                          {:mithril/error :mithril.checkpoint/missing-head})))
        (let [schema (checkpoint/schema (read-text checkpoint/ontology-path))
              previous (semantic-load state-path schema)]
          (println (json-line {:status :verified
                               :checkpoint-digest (:digest previous)
                               :state-digest (execution/digest (:state previous))
                               :run-id (get-in previous [:state :run-id])
                               :run-status (get-in previous [:state :status])})))
        (catch :default error (refuse! error))
        (finally (release-lock! lock))))))

(defn- reconcile-checkpoint! [profile-path task-path state-path owner tool-profile-path]
  (let [lock (try (acquire-lock! state-path) (catch :default error (refuse! error) nil))]
    (when lock
      (try
        (let [artifact (bot/compile-text profile-path (read-text profile-path))
              task (js->clj (js/JSON.parse (read-text task-path)) :keywordize-keys true)
              profile (js->clj (js/JSON.parse (read-text tool-profile-path))
                               :keywordize-keys true)
              _ (when-not (= (:tool-profile-digest task)
                             (hermes/tool-profile-digest profile))
                  (throw (ex-info "task does not bind coding tools"
                                  {:mithril/error :mithril.hermes/tool-profile-mismatch})))
              semantic? (.existsSync fs (semantic-head-path state-path))
              store-dir (.join path (.dirname path state-path) "ipld-checkpoints")
              primary? (.existsSync fs (.join path store-dir "refs"
                                              (ipld-session/ref-name state-path)))
              store (when primary? (ipld-store/open! store-dir))
              schema (when (or semantic? primary?)
                       (checkpoint/schema (read-text checkpoint/ontology-path)))
              previous (cond primary? (ipld-session/load! store schema state-path)
                             semantic? (semantic-load state-path schema))
              saved (if (or semantic? primary?) (:state previous)
                        (reader/read-string (read-text state-path)))
              _ (when-not (and (= :running (:status saved))
                               (= owner (get-in saved [:lease :owner]))
                               (:awaiting saved))
                  (throw (ex-info "no owner-bound in-flight effect"
                                  {:mithril/error :mithril.hermes/no-inflight-effect})))
              state (:state (bot/resume-or-start artifact task saved owner (.now js/Date)))
              effect (:awaiting state)
              {:keys [receipt audit]} (hermes/reconcile-effect effect {:profile profile})
              next-state (bot/apply-receipt state receipt owner (.now js/Date))]
          (let [committed (cond primary?
                                (ipld-session/save! store schema state-path previous next-state)
                                semantic? (semantic-save! state-path schema previous next-state)
                                :else (do (write-state! state-path next-state) nil))]
          (append-audit! state-path
                         (cond-> {:at (.toISOString (js/Date.))
                                  :status :reconciled :effect-id (:id effect)
                                  :action (:action effect) :host audit
                                  :output-digest (:output-digest receipt)}
                           primary? (assoc :state-cid (:stateCid committed))))
          (println (json-line (cond-> {:status :reconciled :effect-id (:id effect)
                                      :step (:step next-state)
                                      :run-status (:status next-state)}
                               primary? (assoc :state-cid (:stateCid committed)))))))
        (catch :default error (refuse! error))
        (finally (release-lock! lock))))))

(let [[command profile-path task-path state-path owner grants-csv mode option-1
       option-2 & extra]
      *command-line-args*
      ;; A read-only Jev run has no coding tool profile. The single optional
      ;; `jev` argument denotes the decision mode, not a JSON file path.
      [tool-profile-path decision-mode]
      (if (and (= "jev" option-1) (nil? option-2))
        [nil "jev"]
        [option-1 option-2])]
  (cond
    (= "profile-digest" command)
    (if (and profile-path (nil? task-path))
      (try
        (println (hermes/tool-profile-digest
                  (js->clj (js/JSON.parse (read-text profile-path)) :keywordize-keys true)))
        (catch :default error (refuse! error)))
      (usage!))

    (= "semantic-restore" command)
    (if (and profile-path (nil? task-path))
      (semantic-restore! profile-path)
      (usage!))

    (= "semantic-verify" command)
    (if (and profile-path (nil? task-path))
      (semantic-verify! profile-path)
      (usage!))

    (= "migrate" command)
    (if (and profile-path task-path state-path owner (nil? grants-csv))
      (migrate-checkpoint! profile-path task-path state-path owner)
      (usage!))

    (= "semantic-import" command)
    (if (and profile-path task-path state-path owner (nil? grants-csv))
      (semantic-import! profile-path task-path state-path owner)
      (usage!))

    (= "reconcile" command)
    (if (and profile-path task-path state-path owner grants-csv
             (nil? mode) (empty? extra))
      (reconcile-checkpoint! profile-path task-path state-path owner grants-csv)
      (usage!))

    :else
    (if-not (and (= "tick" command) profile-path task-path state-path owner grants-csv
                 (contains? #{"shadow" "execute" "semantic-execute" "ipld-execute"} mode)
                 (empty? extra)
                 (or (nil? decision-mode)
                     (and (= "jev" decision-mode)
                          (= "ipld-execute" mode))))
    (usage!)
    (let [lock (try (acquire-lock! state-path) (catch :default error (refuse! error) nil))]
      (when lock
        (when-let [recovered-pid (:recovered-pid lock)]
          (append-audit! state-path {:at (.toISOString (js/Date.))
                                     :status :stale-lock-recovered
                                     :owner-pid recovered-pid}))
        (try
          (let [semantic? (= "semantic-execute" mode)
                primary? (= "ipld-execute" mode)
                schema (when (or semantic? primary?)
                         (checkpoint/schema (read-text checkpoint/ontology-path)))
                store (when primary?
                        (ipld-store/open! (.join path (.dirname path state-path)
                                                  "ipld-checkpoints")))
                previous (cond semantic? (semantic-load state-path schema)
                               primary? (ipld-session/load! store schema state-path))
                artifact (bot/compile-text profile-path (read-text profile-path))
                task (js->clj (js/JSON.parse (read-text task-path)) :keywordize-keys true)
                tool-profile (when tool-profile-path
                               (js->clj (js/JSON.parse (read-text tool-profile-path))
                                        :keywordize-keys true))
                _ (when (and tool-profile
                             (not= (:tool-profile-digest task)
                                   (hermes/tool-profile-digest tool-profile)))
                    (throw (ex-info "task does not bind the supplied coding tool profile"
                                    {:mithril/error :mithril.hermes/tool-profile-mismatch})))
                now (.now js/Date)
                run (if (or semantic? primary?)
                      (bot/resume-or-start artifact task (:state previous) owner now)
                      (load-or-start artifact task state-path owner now))
                state (:state run)
                grants (set (map keyword (remove str/blank? (str/split grants-csv #","))))
                _ (when (and (not= :terminal (:disposition run)) (:awaiting state))
                    (throw (ex-info "in-flight effect requires explicit reconciliation"
                                    {:mithril/error :mithril.bot/effect-in-flight
                                     :effect-id (get-in state [:awaiting :id])})))
                save! (fn [prior state]
                        (cond semantic? (semantic-save! state-path schema prior state)
                              primary? (ipld-session/save! store schema state-path prior state)
                              :else (do (write-state! state-path state) nil)))
                decision-baseline
                (when (and primary?
                           (or (nil? tool-profile) (= "jev" decision-mode))
                           (> (count (bot/available-actions state)) 1))
                  (ipld-session/decision-parent! store schema state-path
                                                 previous state))]
            (if (= :terminal (:disposition run))
              (do
                (append-audit! state-path {:at (.toISOString (js/Date.))
                                           :status :idempotent-terminal
                                           :run-id (:run-id state)
                                           :task-digest (or (:task-digest state)
                                                            (bot/task-digest (:task state)))
                                           :run-status (:status state)})
                (println (json-line
                          (cond-> {:status :idempotent-terminal
                                   :run-id (:run-id state)
                                   :run-status (:status state)}
                            primary? (assoc :state-cid (:stateCid previous)))))
                (release-lock! lock))
              (-> (decide! state owner now (boolean tool-profile) decision-mode
                           (fn [audit]
                             (append-audit! state-path
                                            {:at (.toISOString (js/Date.))
                                             :mode mode :status :model-observed
                                             :run-id (:run-id state) :step (:step state)
                                             :model (select-keys audit
                                                                 [:request-id :model :usage
                                                                  :decision-state-digest
                                                                  :domain-graph-digest
                                                                  :domain-ontology-digest])})))
                (.then
                 (fn [{:keys [admitted held reason audit model-result]}]
                   (if held
                     (let [shadow? (= "shadow" mode)
                           committed (when-not shadow?
                                       (save! (or decision-baseline previous) held))]
                       (append-audit! state-path
                                      {:at (.toISOString (js/Date.))
                                       :mode mode :status (if shadow? :shadow-refused :held)
                                       :run-id (:run-id held) :step (:step held)
                                       :reason reason :model audit})
                       (println (json-line
                                 (cond-> {:status (if shadow? :shadow-refused :held)
                                          :reason reason
                                          :run-id (:run-id held)
                                          :step (:step held)}
                                   (and primary? committed)
                                   (assoc :state-cid (:stateCid committed))))))
                   (let [action (:action admitted)
                         base-audit {:at (.toISOString (js/Date.))
                                     :mode mode :run-id (:run-id state) :step (:step state)
                                     :action (:id action) :confidence (:confidence admitted)
                                     :bpmn-definition (get-in state [:bpmn :definition])
                                     :bpmn-token-at (get-in state [:bpmn :token-state :bpmn/tokens 0 :bpmn/at])
                                     :bpmn-candidates (mapv :id (bot/available-actions state))
                                     :model audit}]
                     (if (= "shadow" mode)
                       (do
                         (append-audit! state-path (assoc base-audit :status :shadowed))
                         (println (json-line {:status :shadowed :action (:label action)
                                             :step (:step state) :run-status (:status state)})))
                       (let [{requested-state :state effect :effect}
                             (if model-result
                               (decision-proof/request-effect
                                state admitted model-result audit grants owner
                                (+ now 2) (+ now 3))
                               (bot/request-effect state admitted grants owner (+ now 3)))
                             requested-checkpoint
                             (save! (or decision-baseline previous) requested-state)
                             _ (append-audit! state-path
                                              (assoc base-audit :status :effect-requested
                                                     :effect-id (:id effect)))
                             {:keys [receipt audit]}
                             (hermes/execute-effect effect (cond-> {}
                                                            tool-profile (assoc :profile tool-profile)))
                             next-state (bot/apply-receipt requested-state receipt owner (+ now 4))]
                         (let [committed (save! requested-checkpoint next-state)]
                           (append-audit! state-path
                                          (cond-> (assoc base-audit :status (:status receipt)
                                                          :effect-id (:id effect) :host audit
                                                          :output-digest (:output-digest receipt))
                                            primary? (assoc :state-cid (:stateCid committed))))
                           (println (json-line
                                     (cond-> {:status (:status receipt)
                                              :action (:label action)
                                              :step (:step next-state)
                                              :run-status (:status next-state)}
                                       primary? (assoc :state-cid (:stateCid committed))))))))))))
                (.catch refuse!)
                (.finally #(release-lock! lock)))))
          (catch :default error
            (release-lock! lock)
            (refuse! error))))))))
