(ns mithril.run-cli
  "Execute one already-compiled Mithril Web IR artifact.

  This runner never loads OpenJev. Model inference belongs to synthesis time;
  request dispatch consumes only the admitted, provenance-bearing artifact."
  (:require [mithril.web :as web]
            ["node:fs" :as fs]))

(defn- refuse! [code detail exit-code]
  (println (str "REFUSE\t" (name code) "\t" detail))
  (.exit js/process exit-code))

(defn- read-artifact [file]
  (try
    (js->clj (.parse js/JSON (.readFileSync fs file "utf8"))
             :keywordize-keys true)
    (catch :default e
      (refuse! :mithril/invalid-artifact-json (.-message e) 1))))

(defn- keyword-string [x]
  (if-let [ns (namespace x)] (str ns "/" (name x)) (name x)))

(defn- json-safe [x]
  (cond
    (keyword? x) (keyword-string x)
    (map? x) (into {} (map (fn [[k v]] [(if (keyword? k) (keyword-string k) k)
                                         (json-safe v)]) x))
    (vector? x) (mapv json-safe x)
    :else x))

(let [[artifact-path method request-path & extra] *command-line-args*]
  (when-not (and artifact-path method request-path (empty? extra))
    (println "usage: mithril-run <artifact.json> <METHOD> <PATH>")
    (.exit js/process 2))
  (try
    (println (.stringify js/JSON
                         (clj->js (json-safe
                                  (web/dispatch (read-artifact artifact-path)
                                                {:method method :path request-path})))
                         nil 2))
    (catch :default e
      (refuse! (or (some-> e ex-data :mithril/error) :mithril/runtime-error)
               (.-message e) 1))))
