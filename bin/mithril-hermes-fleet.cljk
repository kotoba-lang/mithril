#!/usr/bin/env kbb
(ns mithril.hermes-fleet-cli
  (:require [clojure.string :as str]
            [mithril.bpmn :as bpmn]
            [mithril.execution :as execution]
            [mithril.hermes :as hermes]
            [mithril.hermes-fleet :as fleet]
            [mithril.kanban-worker :as worker]))

(def fs (js/require "node:fs"))
(def path (js/require "node:path"))
(def crypto (js/require "node:crypto"))
(def cp (js/require "node:child_process"))

(defn- usage! []
  (println "usage: mithril-hermes-fleet <sync|verify|plan-bpmn> <Hermes profiles root> <output directory>")
  (println "       mithril-hermes-fleet admit-coding <Hermes profiles root> <output directory> <coding registry>")
  (println "       mithril-hermes-fleet shadow-bpmn <Hermes profiles root> <output directory> <process.mith> <receipt directory> <profile> <job-id>")
  (js/process.exit 2))

(defn- read-text [file] (.readFileSync fs file "utf8"))
(defn- exists? [file] (.existsSync fs file))
(defn- sha256-text [text]
  (str "sha256:" (.digest (.update (.createHash crypto "sha256") text "utf8") "hex")))
(defn- file-digest [file] (when (exists? file) (sha256-text (read-text file))))
(defn- json [value] (.stringify js/JSON (clj->js value) nil 2))
(defn- parse-json [text] (js->clj (js/JSON.parse text) :keywordize-keys true))

(defn- profile-names [root]
  (->> (.readdirSync fs root #js {:withFileTypes true})
       array-seq
       (filter #(.isDirectory %))
       (map #(.-name %))
       (remove #(str/starts-with? % "."))
       sort
       vec))

(defn- resolve-script [profiles-root profile-root job]
  (when-let [script (:script job)]
    (let [candidates (remove nil?
                             [(when (.isAbsolute path script) script)
                              (.join path profile-root "scripts" script)
                              (.join path profiles-root ".." "scripts" script)
                              (when-let [workdir (:workdir job)] (.join path workdir script))])]
      (some #(when (exists? %) %) candidates))))

(defn- job-document [profiles-root profile-root job]
  (let [script-ref (:script job)
        script-path (resolve-script profiles-root profile-root job)
        workdir (when-not (str/blank? (str (:workdir job))) (:workdir job))
        base {"jobId" (str (:id job))
              "name" (str (:name job))
              "enabled" (true? (:enabled job))
              "noAgent" (true? (:no_agent job))
              "promptDigest" (sha256-text (str (:prompt job)))
              "scriptDigest" (when script-ref
                               (if script-path
                                 (file-digest script-path)
                                 (sha256-text (str "missing-script:" script-ref))))
              "scriptPresent" (boolean script-path)
              "scheduleDigest" (execution/digest (:schedule job))
              "workdir" workdir}
        with-effects (assoc base "effects" (fleet/expected-effects base))]
    with-effects))

(defn- source-form [doc]
  (let [job-form (fn [job]
                   (list 'mithril/hermes-job
                         :job-id (get job "jobId") :name (get job "name")
                         :enabled (get job "enabled") :no-agent (get job "noAgent")
                         :prompt-digest (get job "promptDigest")
                         :script-digest (get job "scriptDigest")
                         :script-present (get job "scriptPresent")
                         :schedule-digest (get job "scheduleDigest")
                         :workdir (get job "workdir") :effects (get job "effects")))]
    (str (pr-str
          (list 'mithril/hermes-profile
                :id (get doc "@id") :ontology (get doc "ontology")
                :profile-name (get doc "profileName") :profile-root (get doc "profileRoot")
                :config-digest (get doc "configDigest") :soul-digest (get doc "soulDigest")
                :jobs-digest (get doc "jobsDigest")
                :jobs (mapv job-form (get doc "jobs"))))
         "\n")))

(defn- profile-source [profiles-root profile-name]
  (let [root (.join path profiles-root profile-name)
        jobs-file (.join path root "cron" "jobs.json")
        jobs-doc (when (exists? jobs-file) (parse-json (read-text jobs-file)))
        jobs (mapv #(job-document profiles-root root %) (or (:jobs jobs-doc) []))]
    (source-form
     {"@id" (str "https://mithril.fund/id/hermes-profile/" profile-name)
      "ontology" fleet/ontology-digest
      "profileName" profile-name "profileRoot" root
      "configDigest" (file-digest (.join path root "config.yaml"))
      "soulDigest" (file-digest (.join path root "SOUL.md"))
      ;; The scheduler rewrites operational fields such as last_run_at and
      ;; failure_streak after every tick.  Identity is the executable
      ;; declaration, not that mutable telemetry projection.
      "jobsDigest" (when jobs-doc (execution/digest jobs))
      "jobs" jobs})))

(defn- build-fleet [profiles-root]
  (let [entries
        (mapv (fn [name]
                (let [source (profile-source profiles-root name)
                      filename (str name ".mith")
                      artifact (fleet/compile-text filename source)]
                  {:profile name :file filename :source source :artifact artifact
                   :graph-digest (:graph-digest artifact)
                   :jobs (count (get-in artifact [:profile-ir :jobs]))
                   :enabled-jobs (count (filter :enabled (get-in artifact [:profile-ir :jobs])))
                   :missing-scripts (count (filter #(and (some #{:host/script-run} (:effects %))
                                                         (not (:script-present %)))
                                                   (get-in artifact [:profile-ir :jobs])))}))
              (profile-names profiles-root))
        index {:format "https://mithril.fund/registry/hermes-profile-fleet-v1"
               :ontology fleet/ontology-digest
               :profiles (mapv #(dissoc % :source :artifact) entries)}]
    {:entries entries :index index :index-text (str (json index) "\n")}))

(defn- write-fleet! [output {:keys [entries index-text]}]
  (.mkdirSync fs output #js {:recursive true})
  (doseq [{:keys [file source]} entries]
    (.writeFileSync fs (.join path output file) source "utf8"))
  (.writeFileSync fs (.join path output "index.json") index-text "utf8"))

(defn- verify-fleet! [output {:keys [entries index-text]}]
  (let [expected-files (set (conj (mapv :file entries) "index.json"))
        actual-files (if (exists? output)
                       (set (filter #(or (= % "index.json") (str/ends-with? % ".mith"))
                                    (js->clj (.readdirSync fs output))))
                       #{})
        mismatches (concat
                    (when-not (= expected-files actual-files)
                      [{:kind :file-set :expected (count expected-files) :actual (count actual-files)}])
                    (for [{:keys [profile file source]} entries
                          :let [target (.join path output file)]
                          :when (or (not (exists? target)) (not= source (read-text target)))]
                      {:kind :profile-drift :profile profile})
                    (let [target (.join path output "index.json")]
                      (when (or (not (exists? target)) (not= index-text (read-text target)))
                        [{:kind :index-drift}])))]
    (if (seq mismatches)
      (throw (ex-info "Hermes profile fleet differs from compiled Mith manifests"
                      {:mithril/error :mithril.fleet/drift :mismatches (vec mismatches)}))
      true)))

(defn- summary [{:keys [entries index]}]
  {:status "ok"
   :profiles (count entries)
   :jobs (reduce + (map :jobs entries))
   :enabledJobs (reduce + (map :enabled-jobs entries))
   :missingScripts (reduce + (map :missing-scripts entries))
   :indexDigest (sha256-text (json index))})

(defn- git-output [workspace & args]
  (try
    (.execFileSync cp "/usr/bin/git" (clj->js (into ["-C" workspace] args))
                   #js {:encoding "utf8" :stdio #js ["ignore" "pipe" "ignore"]
                        :timeout 30000})
    (catch :default _ nil)))

(defn- workspace-facts [workspace]
  (let [exists (and (string? workspace) (exists? workspace))
        inside (when exists (git-output workspace "rev-parse" "--is-inside-work-tree"))
        status (when inside (git-output workspace "status" "--porcelain=v1" "--untracked-files=all"))]
    {:exists? (boolean exists)
     :git? (= "true" (some-> inside str/trim))
     :clean? (and (some? status) (str/blank? status))}))

(defn- admitted-tool-profiles [registry]
  (let [registry (worker/validate-coding-tool-registry registry)]
    (into {}
          (map (fn [{:keys [workspace tool-profile]}]
                 (let [profile (parse-json (read-text tool-profile))]
                   (hermes/validate-tool-profile profile)
                   (when-not (= workspace (:workspace profile))
                     (throw (ex-info "coding registry workspace differs from tool profile"
                                     {:mithril/error :mithril.fleet/profile-workspace-mismatch
                                      :workspace workspace})))
                   [workspace {:path tool-profile
                               :digest (hermes/tool-profile-digest profile)}])))
          (:profiles registry))))

(defn- coding-admission [fleet registry-path]
  (let [registered (admitted-tool-profiles (parse-json (read-text registry-path)))
        coding-jobs (for [{:keys [artifact]} (:entries fleet)
                          job (get-in artifact [:profile-ir :jobs])
                          :when (and (:enabled job) (fleet/coding-candidate? job))]
                      job)
        facts-by-workspace (into {}
                                 (map (fn [workspace]
                                        [workspace (workspace-facts workspace)]))
                                 (distinct (map :workdir coding-jobs)))
        rows (->> (:entries fleet)
                  (mapcat (fn [{:keys [profile graph-digest artifact]}]
                            (for [job (get-in artifact [:profile-ir :jobs])
                                  :when (fleet/coding-candidate? job)
                                  :when (:enabled job)
                                  :let [facts (get facts-by-workspace (:workdir job))
                                        admission (fleet/coding-readiness
                                                   job (set (keys registered)) facts)]]
                              {:profile profile :profileDigest graph-digest
                               :jobId (:id job) :job (:name job)
                               :workspace (:workdir job) :admission (name admission)
                               :toolProfile (get-in registered [(:workdir job) :path])})))
                  vec)
        counts (->> rows (group-by :admission)
                    (map (fn [[key values]] [key (count values)]))
                    (into (sorted-map)))]
    {:format "https://mithril.fund/report/hermes-coding-admission-v1"
     :profiles (count (:entries fleet)) :codingJobs (count rows)
     :counts counts :jobs rows}))

(defn- active-job-ids [profile-root]
  (let [db (.join path profile-root "cron" "executions.db")]
    (if-not (exists? db)
      #{}
      (try
        (->> (.execFileSync cp "/usr/bin/sqlite3"
                            ;; `unknown` is an immutable terminal audit result in
                            ;; Hermes.  Only claimed/running are in flight.
                            #js [db "SELECT DISTINCT job_id FROM executions WHERE status IN ('claimed','running')"]
                            #js {:encoding "utf8" :stdio #js ["ignore" "pipe" "ignore"] :timeout 30000})
             str/split-lines (remove str/blank?) set)
        (catch :default error
          (throw (ex-info "execution state could not be measured"
                          {:mithril/error :mithril.fleet/execution-state-unreadable
                           :profile-root profile-root})))))))

(defn- operational-jobs [profile-root]
  (let [jobs-file (.join path profile-root "cron" "jobs.json")]
    (if-not (exists? jobs-file)
      []
      (let [doc (parse-json (read-text jobs-file))]
        (or (:jobs doc) [])))))

(defn- bpmn-plan [fleet]
  (let [rows
        (->> (:entries fleet)
             (mapcat
              (fn [{:keys [profile graph-digest artifact]}]
                (let [profile-root (get-in artifact [:profile-ir :root])
                      active (active-job-ids profile-root)
                      live-by-id (into {} (map (juxt (comp str :id) identity))
                                       (operational-jobs profile-root))]
                  (for [job (get-in artifact [:profile-ir :jobs])
                        :let [live (get live-by-id (:id job))
                              facts {:script-present? (:script-present job)
                                     :workdir-present? (or (nil? (:workdir job))
                                                           (exists? (:workdir job)))
                                     :active-execution? (contains? active (:id job))}
                              observed (assoc job
                                              :last-status (:last_status live)
                                              :failure-streak (:failure_streak live))
                              readiness (fleet/bpmn-job-readiness observed facts)]]
                    {:profile profile :profileDigest graph-digest
                     :jobId (:id job) :job (:name job)
                     :enabled (:enabled job)
                     :effects (mapv #(str (namespace %) "/" (name %)) (:effects job))
                     :lastStatus (:last-status observed)
                     :failureStreak (or (:failure-streak observed) 0)
                     :admission (name readiness)}))))
             vec)
        enabled (filter :enabled rows)
        counts (->> enabled (group-by :admission)
                    (map (fn [[key values]] [key (count values)]))
                    (into (sorted-map)))]
    {:format "https://mithril.fund/report/hermes-bpmn-migration-v1"
     :policy {:phase0 "quarantine unhealthy or structurally unknown jobs"
              :phase1 "shadow healthy script-only jobs"
              :phase2 "author explicit ontology-bound BPMN contracts for LLM jobs"
              :phase3 "execute only after scheduler receipts reconcile"}
     :profiles (count (:entries fleet))
     :jobs (count rows) :enabledJobs (count enabled)
     :counts counts :jobsDetail rows}))

(defn- latest-execution [profile-root job-id]
  (when-not (re-matches #"[A-Za-z0-9_-]+" job-id)
    (throw (ex-info "invalid job ID" {:mithril/error :mithril.fleet/invalid-job-id})))
  (let [db (.join path profile-root "cron" "executions.db")]
    (when-not (exists? db)
      (throw (ex-info "execution database missing" {:mithril/error :mithril.fleet/missing-execution-db})))
    (let [sql (str "SELECT id,job_id,source,status,claimed_at,finished_at,error,scheduled_instant "
                   "FROM executions WHERE job_id='" job-id "' ORDER BY claimed_at DESC,id DESC LIMIT 1")
          output (.execFileSync cp "/usr/bin/sqlite3" #js ["-json" db sql]
                                #js {:encoding "utf8" :stdio #js ["ignore" "pipe" "ignore"] :timeout 30000})]
      (first (parse-json output)))))

(defn- shadow-bpmn! [fleet output process-file receipt-dir profile job-id]
  (verify-fleet! output fleet)
  (when-not (str/ends-with? process-file ".mith")
    (throw (ex-info "shadow BPMN source must be .mith"
                    {:mithril/error :mithril.fleet/invalid-process-source})))
  (when-not (and (re-matches #"[A-Za-z0-9_-]+" profile)
                 (re-matches #"[A-Za-z0-9_-]+" job-id))
    (throw (ex-info "invalid profile or job ID" {:mithril/error :mithril.fleet/invalid-target})))
  (let [entry (first (filter #(= profile (:profile %)) (:entries fleet)))
        job (first (filter #(= job-id (:id %)) (get-in entry [:artifact :profile-ir :jobs])))]
    (when-not job
      (throw (ex-info "job is not in compiled profile" {:mithril/error :mithril.fleet/unknown-job})))
    (let [profile-root (get-in entry [:artifact :profile-ir :root])
          live (first (filter #(= job-id (str (:id %))) (operational-jobs profile-root)))
          facts {:script-present? (:script-present job)
                 :workdir-present? (or (nil? (:workdir job)) (exists? (:workdir job)))
                 :active-execution? (contains? (active-job-ids profile-root) job-id)}
          readiness (fleet/bpmn-job-readiness
                     (assoc job :last-status (:last_status live)
                                :failure-streak (:failure_streak live)) facts)
          receipt (latest-execution profile-root job-id)
          admission (fleet/shadow-receipt-admission readiness job-id receipt)]
      (when-not (= :admitted admission)
        (throw (ex-info "shadow receipt not admitted"
                        {:mithril/error :mithril.fleet/shadow-not-admitted
                         :reason admission :profile profile :job-id job-id})))
      (let [source-doc (js->clj (js/JSON.parse (read-text process-file)))
            _ (when-not (= "https://mithril.fund/context/v1" (get source-doc "@context"))
                (throw (ex-info "shadow process context is not pinned"
                                {:mithril/error :mithril.fleet/unpinned-context})))
            doc (dissoc source-doc "@context")
            ;; BPMN source is a .mith JSON-LD-compatible graph; only the
            ;; governed, ontology-bound action catalog is executable here.
            compiled (bpmn/compile-process doc {"shadow/accept" {} "shadow/hold" {}}
                                           #{"shadow/accept" "shadow/hold"})
            _ (when-not (= fleet/ontology-digest (:ontology compiled))
                (throw (ex-info "shadow process ontology mismatch"
                                {:mithril/error :mithril.fleet/ontology-mismatch})))
            runtime (-> (bpmn/start-state compiled)
                        (bpmn/select-action "shadow/accept")
                        (bpmn/apply-outcome "shadow/accept" true))
            _ (when-not (bpmn/completed? runtime)
                (throw (ex-info "BPMN shadow token did not terminate"
                                {:mithril/error :mithril.fleet/nonterminal-shadow})))
            record {:format "https://mithril.fund/receipt/hermes-bpmn-shadow-v1"
                    :mode "observation-only" :profile profile :profileDigest (:graph-digest entry)
                    :jobId job-id :executionId (:id receipt)
                    :source (:source receipt) :scheduledInstant (:scheduled_instant receipt)
                    :claimedAt (:claimed_at receipt) :finishedAt (:finished_at receipt)
                    :processDigest (:digest compiled) :action "shadow/accept"
                    :terminal true :hostEffects []}
            bytes (str (json record) "\n")
            target (.join path receipt-dir (str profile "-" job-id "-" (:id receipt) ".json"))]
        (.mkdirSync fs receipt-dir #js {:recursive true})
        (let [duplicate? (exists? target)]
          (if duplicate?
          (when-not (= bytes (read-text target))
            (throw (ex-info "immutable shadow receipt conflicts"
                            {:mithril/error :mithril.fleet/receipt-conflict})))
            (.writeFileSync fs target bytes #js {:encoding "utf8" :flag "wx"}))
          {:status (if duplicate? "duplicate" "shadow-recorded")
           :receipt target :executionId (:id receipt) :processDigest (:digest compiled)})))))

(let [[command profiles-root output registry-path & extra] *command-line-args*]
  (if-not (and (contains? #{"sync" "verify" "admit-coding" "plan-bpmn" "shadow-bpmn"} command)
               profiles-root output
               (case command
                 "admit-coding" (and registry-path (empty? extra))
                 "shadow-bpmn" (and registry-path (= 3 (count extra)))
                 (and (nil? registry-path) (empty? extra)))
               (.isAbsolute path profiles-root)
               (.isAbsolute path output)
               (if (= "shadow-bpmn" command)
                 (and (.isAbsolute path registry-path) (.isAbsolute path (first extra))) true))
    (usage!)
    (try
      (let [fleet (build-fleet profiles-root)]
        (case command
          "sync" (write-fleet! output fleet)
          "verify" (verify-fleet! output fleet)
          "plan-bpmn"
          (do (verify-fleet! output fleet)
              (println (json (bpmn-plan fleet))))
          "admit-coding"
          (let [_ (verify-fleet! output fleet)
                report (coding-admission fleet registry-path)]
            (println (json report))
            (when-not (= (get-in report [:counts "ready"] 0) (:codingJobs report))
              (js/process.exit 1)))
          "shadow-bpmn"
          (println (json (apply shadow-bpmn! fleet output registry-path extra))))
        (when (contains? #{"sync" "verify"} command)
          (println (json (summary fleet)))))
      (catch :default error
        (println (str "REFUSE\t" (or (some-> error ex-data :mithril/error name) "fleet-error")
                      "\t" (.-message error)))
        (when-let [data (ex-data error)] (println (json data)))
        (js/process.exit 1)))))
