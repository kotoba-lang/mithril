#!/usr/bin/env kbb
(ns mithril.scheduler-ipld-verify-cli
  "Read-only reconciliation of Hermes builtin executions and Mithril CID state."
  (:require [cljs.reader :as reader]
            [clojure.string :as str]
            [mithril.checkpoint :as checkpoint]
            [mithril.checkpoint-ipld-fs :as local]
            [mithril.scheduler-ipld :as scheduler-ipld]))

(def fs (js/require "node:fs"))
(def path (js/require "node:path"))
(def cp (js/require "node:child_process"))

(defn- refuse! [reason]
  (throw (ex-info "Hermes/Mithril IPLD parity verification refused"
                  {:reason reason})))
(defn- text [file] (.readFileSync fs file "utf8"))
(defn- parse-json [value]
  (js->clj (js/JSON.parse value) :keywordize-keys true))
(defn- json [value]
  (.stringify js/JSON (clj->js value)))

(let [[state-dir profile job-id db & extra] *command-line-args*]
  (try
    (when-not (and state-dir profile job-id db
                   (or (empty? extra) (= ["primary"] extra))
                   (.isAbsolute path state-dir) (.isAbsolute path db)
                   (re-matches #"[A-Za-z0-9_-]+" profile)
                   (re-matches #"[0-9a-f]{12}" job-id))
      (refuse! :invalid-arguments))
    (let [_ (when-not (.existsSync fs db)
              (refuse! :missing-input))
          schema (checkpoint/schema (text checkpoint/ontology-path))
          store (local/open! (.join path state-dir "ipld-checkpoints"))
          sql (str "SELECT id,source,status,scheduled_instant,claimed_at "
                   "FROM executions WHERE job_id='" job-id
                   "' ORDER BY claimed_at ASC,id ASC")
          raw (.execFileSync cp "/usr/bin/sqlite3" #js ["-json" db sql]
                               #js {:encoding "utf8" :timeout 30000})
          executions (if (str/blank? raw) [] (parse-json raw))
          rows (mapv (fn [execution]
                       {:execution execution
                        :receipt (when (= "builtin" (:source execution))
                                   (let [file (.join path state-dir
                                                     (str (:id execution)
                                                          ".receipt.json"))]
                                     (when-not (.existsSync fs file)
                                       (refuse! :missing-receipt))
                                     (parse-json (text file))))})
                     executions)]
      (when-not (seq executions) (refuse! :no-executions))
      (let [primary? (= ["primary"] extra)
            state-path (.join path state-dir
                              (if primary?
                                (scheduler-ipld/primary-state-basename
                                 profile job-id rows)
                                (str profile "-" job-id ".session.edn")))
            {:keys [state verification]}
            (if primary?
              (let [result (scheduler-ipld/verify-primary-occurrences!
                            store schema state-path rows)]
                {:state (:state result) :verification (dissoc result :state)})
              (scheduler-ipld/verify-from-receipts! store schema rows))
            projection? (.existsSync fs state-path)]
        (when (and projection?
                   (not= state (reader/read-string (text state-path))))
          (refuse! :projection-diverged))
        (println (json (assoc verification :projection
                              (if projection? "matched" "missing"))))))
    (catch :default error
      (println (str "REFUSE\t" (or (some-> error ex-data :reason name)
                                    (some-> error ex-data :mithril/error name)
                                    "scheduler-ipld-verification-error")))
      (set! (.-exitCode js/process) 1))))
